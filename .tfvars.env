#!/bin/bash
# =============================================================================
# .tfvars.env — shell-format deployment config
# =============================================================================
#
# Alternative: use .tfvars.yaml (structured YAML, same settings).
# Override path: export TFVARS_FILE=/path/to/config.env
#
# Wrapper scripts auto-detect: .tfvars.yaml → .tfvars.yml → .tfvars.env
# Only edit the sections below — do not modify the loader at the bottom.
#
# =============================================================================


# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
AWS_REGION="ap-southeast-1"              # AWS region for all resources
OWNER="ksahu-ygulati"                    # Owner tag on EC2 and related resources
ENVIRONMENT="development"                # Name prefix + Terraform workspace


# -----------------------------------------------------------------------------
# CPU ARCHITECTURE (optional — AWS Graviton / ARM64)
# -----------------------------------------------------------------------------
# CPU_ARCHITECTURE="x86_64"              # x86_64 (default) or arm64
# APPLY_GRAVITON_DEFAULTS="true"         # remap m5/r5 → m7g/r7g when arm64
# AUTO_RESOLVE_ARM64_AMI="true"          # lookup RHEL 9 arm64 AMI in AWS_REGION
# ECS_DEPLOY_ON_ARM64="false"            # ECS on ARM64 is experimental (default off)


# -----------------------------------------------------------------------------
# TERRAFORM — CREATE NEW vs USE EXISTING AWS RESOURCES
# -----------------------------------------------------------------------------
# Set each flag once here. You do NOT need duplicate true/false elsewhere when
# EXISTING_SG_NAME / EXISTING_KEYPAIR_NAME are set (see matching false flags).
#
# CREATE_VPC=false       → use account default VPC (typical)
# CREATE_VPC=true        → create VPC_NAME / VPC_CIDR_BLOCK (uncomment VPC block below)
#
# CREATE_NEW_SG=false    → use EXISTING_SG_NAME
# CREATE_NEW_SG=true     → create SG_NAME (+ ALLOWED_CIDRS / ALLOWED_PORTS)
#
# CREATE_KEYPAIR=false   → use EXISTING_KEYPAIR_NAME (no new .pem generated)
# CREATE_KEYPAIR=true    → generate new keypair KEYPAIR_NAME + local .pem file
#
# CREATE_EIP=true          → allocate Elastic IP for Cloudera Manager (cldr-mngr)
CREATE_VPC="false"
CREATE_NEW_SG="false"
CREATE_KEYPAIR="false"
CREATE_EIP="true"

# --- Existing resources (when create flags above are false) ------------------
EXISTING_SG_NAME="testing-pvc_cluster_sg"
EXISTING_KEYPAIR_NAME="kuldeep-pvc-session"

# --- New VPC (only when CREATE_VPC=true) -------------------------------------
# VPC_NAME="${ENVIRONMENT}-cldr-vpc"
# VPC_CIDR_BLOCK="172.16.0.0/16"
# VPC_AZS='["ap-southeast-1a","ap-southeast-1b"]'
# VPC_PUBLIC_SUBNETS_CIDR='["172.16.0.0/24"]'
# VPC_PRIVATE_SUBNETS_CIDR='[]'
# ENABLE_NAT_GATEWAY="false"
# ENABLE_VPN_GATEWAY="false"

# --- New security group (only when CREATE_NEW_SG=true) -----------------------
# SG_NAME="${ENVIRONMENT}-pvc_cluster_sg"
# ALLOWED_CIDRS='["0.0.0.0/0"]'
# ALLOWED_PORTS='[0]'

# --- New keypair (only when CREATE_KEYPAIR=true) -----------------------------
# KEYPAIR_NAME="${ENVIRONMENT}-pvc-new-keypair"

# --- Elastic IP name (when CREATE_EIP=true) ----------------------------------
# CLDR_EIP_NAME="${ENVIRONMENT}-cldr-mngr-eip"


# -----------------------------------------------------------------------------
# CLOUDERA VERSIONS (Ansible — edit group_vars/all.yml for deploy)
# -----------------------------------------------------------------------------
CM_VERSION="7.13.2.10000"                # Cloudera Manager (must match CDH compatibility)
# CDH_VERSION="7.3.2.10000"              # CDH Runtime base cluster parcel
# ECS_PVC_DS_VERSION="1.5.5-h3300"       # ECS Data Services repo tag (CDS 1.5.5 SP3 CHF3)


# -----------------------------------------------------------------------------
# AMI
# -----------------------------------------------------------------------------
# Default AMI for all instance groups (RHEL 9.7 in ap-southeast-1).
AMI_ID="ami-0a66a47c24c021954"


# -----------------------------------------------------------------------------
# INSTANCE GROUP — Cloudera Manager (cldr_mngr)
# -----------------------------------------------------------------------------
CLDR_MNGR_COUNT=1
CLDR_MNGR_INSTANCE_TYPE="m5.4xlarge"
CLDR_MNGR_VOLUME_SIZE=300                # GB root volume


# -----------------------------------------------------------------------------
# INSTANCE GROUP — FreeIPA / Identity (ipa_server)
# -----------------------------------------------------------------------------
IPA_SERVER_COUNT=1
IPA_SERVER_INSTANCE_TYPE="m5.xlarge"
IPA_SERVER_VOLUME_SIZE=250               # GB root volume


# -----------------------------------------------------------------------------
# INSTANCE GROUP — CDP Base masters (pvcbase_master)
# -----------------------------------------------------------------------------
PVCBASE_MASTER_COUNT=1
PVCBASE_MASTER_INSTANCE_TYPE="m5.4xlarge"
PVCBASE_MASTER_VOLUME_SIZE=400           # GB root volume


# -----------------------------------------------------------------------------
# INSTANCE GROUP — CDP Base workers (pvcbase_worker)
# -----------------------------------------------------------------------------
PVCBASE_WORKER_COUNT=3
PVCBASE_WORKER_INSTANCE_TYPE="m5.4xlarge"
PVCBASE_WORKER_VOLUME_SIZE=400           # GB root volume


# -----------------------------------------------------------------------------
# INSTANCE GROUP — ECS masters (pvcecs_master)
# -----------------------------------------------------------------------------
PVCECS_MASTER_COUNT=1
PVCECS_MASTER_INSTANCE_TYPE="m5.8xlarge"
PVCECS_MASTER_VOLUME_SIZE=1300           # GB root volume


# -----------------------------------------------------------------------------
# INSTANCE GROUP — ECS workers (pvcecs_worker)
# -----------------------------------------------------------------------------
PVCECS_WORKER_COUNT=7
PVCECS_WORKER_INSTANCE_TYPE="r5a.4xlarge"
PVCECS_WORKER_VOLUME_SIZE=1300           # GB root volume


# -----------------------------------------------------------------------------
# TOOLING (rarely changed)
# -----------------------------------------------------------------------------
TERRAFORM_VERSION="latest"               # Terraform version for wrapper install (or pin e.g. 1.9.0)


# =============================================================================
# LOADER — applies defaults and builds TF_VARS for Terraform (do not edit)
# =============================================================================

_tfvars_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
if [[ -f "${_tfvars_dir}/scripts/lib/tfvars_defaults.sh" ]]; then
    _PVC_LIB="${_tfvars_dir}/scripts/lib"
elif [[ -f "${_tfvars_dir}/cdp-onprem-automation/scripts/lib/tfvars_defaults.sh" ]]; then
    _PVC_LIB="${_tfvars_dir}/cdp-onprem-automation/scripts/lib"
else
    echo "Error: scripts/lib not found. Clone cdp-onprem-automation or run via wrapper scripts." >&2
    return 1 2>/dev/null || exit 1
fi

# shellcheck source=scripts/lib/tfvars_defaults.sh
source "${_PVC_LIB}/tfvars_defaults.sh"
# shellcheck source=scripts/lib/build_tf_vars.sh
source "${_PVC_LIB}/build_tf_vars.sh"
