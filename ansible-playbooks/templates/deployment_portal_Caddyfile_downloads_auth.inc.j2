{# Password login is verified by Caddy; the private auth service owns revocable sessions. #}
{% if deployment_portal_basic_auth_enabled | default(false) | bool and (deployment_portal_basic_auth_hash | default('') | length > 0) %}
  handle /api/login {
    route {
      basic_auth {
        {{ deployment_portal_basic_auth_user }} {{ deployment_portal_basic_auth_hash }}
      }
      rewrite * /login
      reverse_proxy portal-auth:8080 {
        header_up X-Portal-User {http.auth.user.id}
      }
    }
  }

  handle /api/session {
    route {
      rewrite * /check
      reverse_proxy portal-auth:8080 {
        header_up X-Auth-Mode status
      }
    }
  }

  handle /logout {
    rewrite * /logout
    reverse_proxy portal-auth:8080
  }

  handle /downloads/* {
    route {
      forward_auth portal-auth:8080 {
        uri /check
        header_up X-Auth-Mode redirect
        header_up X-Forwarded-Uri {http.request.uri}
      }
      header Cache-Control "no-store"
      root * /srv
      file_server
    }
  }
{% else %}
  handle /downloads/* {
    root * /srv
    file_server
  }
{% endif %}
{{ '\n' }}
