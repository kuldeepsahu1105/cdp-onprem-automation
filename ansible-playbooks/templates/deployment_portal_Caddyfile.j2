{
  admin off
}

{% if caddy_vhost_enabled | default(false) | bool %}
{# nip.io-style vhosts — public IP slug (external (internet)); optional private slug for in-VPC #}
{% set caddy_vhost_urls = caddy_vhost_urls_external %}
{% include 'deployment_portal_Caddyfile_vhosts.inc.j2' %}
{% if caddy_vhost_register_private_ip | default(true) | bool and (caddy_vhost_urls_vpc is defined) and (caddy_vhost_urls_vpc | length > 0) %}
{% set caddy_vhost_urls = caddy_vhost_urls_vpc %}
{% include 'deployment_portal_Caddyfile_vhosts.inc.j2' %}
{% endif %}

{% if ecs_caddy_data_service_routes is defined and (ecs_caddy_data_service_routes | length > 0) %}
{% include 'deployment_portal_Caddyfile_ecs_data_services.inc.j2' %}
{% endif %}
{% endif %}

{# Direct IP:port fallback; explicit HTTP avoids automatic local HTTPS. #}
{% set _ipa_caddy_origin = 'http://{http.request.host}' ~ (':' ~ (deployment_portal_http_port | int) if (deployment_portal_http_port | int) != 80 else '') %}
{% set _ipa_caddy_vhost_host = '{http.request.host}' %}
http://:{{ deployment_portal_http_port }} {
{% include 'deployment_portal_Caddyfile_downloads_auth.inc.j2' %}
  root * /srv

  @static not path /grafana* /prometheus* /alertmanager* /cadvisor* /ipa* /downloads*
  handle @static {
    try_files {path} /index.html
    file_server
  }

{% if deployment_portal_has_ipa | default(false) | bool %}
  handle /ipa* {
{% include 'deployment_portal_Caddyfile_ipa_proxy.inc.j2' %}
  }
{% endif %}

{% if deployment_portal_monitoring_routes_enabled | default(false) | bool %}
  handle /grafana/* {
    reverse_proxy {{ monitoring_grafana_docker_service }}:3000
  }

  handle /prometheus/* {
    reverse_proxy {{ monitoring_prometheus_docker_service }}:9090
  }

  handle /alertmanager/* {
    reverse_proxy {{ monitoring_alertmanager_docker_service }}:9093
  }

  handle_path /cadvisor/* {
    reverse_proxy {{ monitoring_cadvisor_docker_service }}:8080
  }
{% endif %}
}
