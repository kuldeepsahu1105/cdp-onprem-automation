{# YAML facts for nip.io-style Caddy hostnames — rendered into deployment_portal_context #}
{% set _ops_ip = caddy_vhost_ip_for_urls | default('') | trim %}
{% if _ops_ip | length == 0 %}
{%   set _ops_ip = deployment_portal_ops_public_ip | default(deployment_portal_ops_private_ip | default('')) | trim %}
{% endif %}
{% set slug = _ops_ip | replace('.', '-') %}
{% set base = caddy_vhost_public_base %}
{% set port = deployment_portal_http_port | int %}
{% macro vhost(svc) -%}
{%- if caddy_vhost_dns_mode == 'flat' -%}
{{ svc }}.{{ base }}
{%- elif caddy_vhost_dns_mode == 'classic_nipio' -%}
{{ svc }}.{{ slug }}.nip.io
{%- else -%}
{{ svc }}.{{ slug }}.{{ base }}
{%- endif -%}
{%- endmacro %}
{% macro url(host, path, use_port) -%}
http://{{ host }}{% if use_port %}:{{ port }}{% endif %}{{ path }}
{%- endmacro %}
{% set use_port = (port != 80) %}
nipio_style: {{ caddy_vhost_dns_mode }}
public_base: {{ base }}
ip_slug: {{ slug }}
ops_ip: {{ _ops_ip }}
portal:
  hostname: "{{ vhost(caddy_vhost_service_names.portal) }}"
  url: "{{ url(vhost(caddy_vhost_service_names.portal), '', use_port) }}"
pgadmin:
  hostname: "{{ vhost(caddy_vhost_service_names.pgadmin) }}"
  url: "{{ url(vhost(caddy_vhost_service_names.pgadmin), '', use_port) }}"
grafana:
  hostname: "{{ vhost(caddy_vhost_service_names.grafana) }}"
  url: "{{ url(vhost(caddy_vhost_service_names.grafana), '', use_port) }}"
prometheus:
  hostname: "{{ vhost(caddy_vhost_service_names.prometheus) }}"
  url: "{{ url(vhost(caddy_vhost_service_names.prometheus), '', use_port) }}"
alertmanager:
  hostname: "{{ vhost(caddy_vhost_service_names.alertmanager) }}"
  url: "{{ url(vhost(caddy_vhost_service_names.alertmanager), '', use_port) }}"
ipa:
  hostname: "{{ vhost(caddy_vhost_service_names.ipa) }}"
  url: "{{ url(vhost(caddy_vhost_service_names.ipa), '', use_port) }}"
