{# YAML list of primary service endpoints for the deployment portal index #}
{% set _mon = (monitoring_stack_enabled | default(false) | bool) or (deployment_portal_monitoring_deployed | default(false) | bool) or (deployment_portal_monitoring_routes_enabled | default(false) | bool) %}
{% set _portal_url = deployment_portal_access_urls.primary.portal if (deployment_portal_access_profile_effective == 'private') else deployment_portal_access_urls.external.portal %}
{% set _portal_caddy = caddy_vhost_urls_external.portal.url | default('') | trim if (caddy_vhost_enabled | default(false) | bool) else '' %}
{% set _portal_pick = _portal_caddy if (_portal_caddy | length > 0) else (_portal_url | default('') | trim) %}
{% if _portal_pick | length > 0 %}
{% set _portal_note = ('Caddy lab vhost ' ~ caddy_vhost_urls_external.portal.hostname | default('')) if (_portal_caddy | length > 0) else ('Caddy :' ~ (deployment_portal_http_port | string) ~ ' on ' ~ (deployment_portal_anchor_fqdn | default('ops host'))) %}
- name: "Deployment portal"
  url: "{{ _portal_pick }}"
  hostname: "{{ deployment_portal_anchor_fqdn | default('') }}"
  note: "{{ _portal_note }}"
{% endif %}
{% if deployment_portal_cm_fqdn | default('') | length > 0 %}
- name: "Cloudera Manager (HTTPS direct)"
  url: "https://{{ deployment_portal_cm_fqdn }}:{{ cm_https_port }}"
  hostname: "{{ deployment_portal_cm_fqdn }}"
  note: "Direct TLS on cldr-mngr :{{ cm_https_port }}"
{% endif %}
{% if pgadmin_caddy_public_url | default('') | length > 0 %}
- name: "pgAdmin"
  url: "{{ pgadmin_caddy_public_url | trim }}"
  hostname: "{{ deployment_portal_anchor_fqdn | default('') }}"
  note: "Caddy vhost {{ caddy_vhost_urls_external.pgadmin.hostname | default('') }}; CM DB on {{ deployment_portal_postgres_fqdn | default('') }}"
{% elif deployment_portal_access_urls.external.pgadmin | default('') | length > 0 %}
- name: "pgAdmin"
  url: "{{ deployment_portal_access_urls.external.pgadmin | trim }}"
  hostname: "{{ deployment_portal_anchor_fqdn | default('') }}"
  note: "Ops host :{{ deployment_portal_pgadmin_host_port }}; CM DB on {{ deployment_portal_postgres_fqdn | default('') }}"
{% endif %}
{% if deployment_portal_has_ipa | bool and caddy_vhost_urls_external.ipa.url | default('') | length > 0 %}
- name: "FreeIPA (modern UI)"
  url: "{{ (caddy_vhost_urls_external.ipa.url | trim | regex_replace('/+$', '')) ~ '/ipa/modern-ui/' }}"
  hostname: "{{ deployment_portal_ipa_fqdn | default('') }}"
  note: "Caddy vhost {{ caddy_vhost_urls_external.ipa.hostname | default('') }}"
- name: "FreeIPA (legacy UI)"
  url: "{{ (caddy_vhost_urls_external.ipa.url | trim | regex_replace('/+$', '')) ~ '/ipa/ui' }}"
  hostname: "{{ deployment_portal_ipa_fqdn | default('') }}"
  note: "Caddy vhost {{ caddy_vhost_urls_external.ipa.hostname | default('') }}"
{% elif deployment_portal_ipa_fqdn | default('') | length > 0 %}
- name: "FreeIPA"
  url: "https://{{ deployment_portal_ipa_fqdn }}"
  hostname: "{{ deployment_portal_ipa_fqdn }}"
  note: "Direct HTTPS on ipaserver"
{% endif %}
{% if _mon %}
{% set _grafana_vhost = caddy_vhost_urls_external.grafana.url | default('') | trim %}
{% set _prom_vhost = caddy_vhost_urls_external.prometheus.url | default('') | trim %}
{% set _am_vhost = caddy_vhost_urls_external.alertmanager.url | default('') | trim %}
{% set _cadv_vhost = caddy_vhost_urls_external.cadvisor.url | default('') | trim %}
{% set _grafana_path = ('http://' ~ deployment_portal_ops_public_ip ~ ':' ~ (deployment_portal_http_port | string) ~ '/grafana/') if (deployment_portal_access_profile_effective == 'cloud') else ('http://' ~ deployment_portal_ops_client_host ~ ':' ~ (deployment_portal_http_port | string) ~ '/grafana/') %}
{% set _prom_path = ('http://' ~ deployment_portal_ops_public_ip ~ ':' ~ (deployment_portal_http_port | string) ~ '/prometheus/') if (deployment_portal_access_profile_effective == 'cloud') else ('http://' ~ deployment_portal_ops_client_host ~ ':' ~ (deployment_portal_http_port | string) ~ '/prometheus/') %}
{% set _am_path = ('http://' ~ deployment_portal_ops_public_ip ~ ':' ~ (deployment_portal_http_port | string) ~ '/alertmanager/') if (deployment_portal_access_profile_effective == 'cloud') else ('http://' ~ deployment_portal_ops_client_host ~ ':' ~ (deployment_portal_http_port | string) ~ '/alertmanager/') %}
{% set _cadv_path = ('http://' ~ deployment_portal_ops_public_ip ~ ':' ~ (deployment_portal_http_port | string) ~ '/cadvisor/') if (deployment_portal_access_profile_effective == 'cloud') else ('http://' ~ deployment_portal_ops_client_host ~ ':' ~ (deployment_portal_http_port | string) ~ '/cadvisor/') %}
{% set _cadvisor_direct = ('http://' ~ deployment_portal_ops_private_ip ~ ':' ~ (monitoring_cadvisor_host_port | string) ~ '/') if (deployment_portal_access_profile_effective == 'private') else ('http://' ~ deployment_portal_ops_public_ip ~ ':' ~ (monitoring_cadvisor_host_port | string) ~ '/') %}
{% set _grafana_direct = deployment_portal_access_urls.primary.grafana if (deployment_portal_access_profile_effective == 'private') else deployment_portal_access_urls.external.grafana %}
{% set _prom_direct = deployment_portal_access_urls.primary.prometheus if (deployment_portal_access_profile_effective == 'private') else deployment_portal_access_urls.external.prometheus %}
{% set _am_direct = deployment_portal_access_urls.primary.alertmanager if (deployment_portal_access_profile_effective == 'private') else deployment_portal_access_urls.external.alertmanager %}
{% set _grafana_pick = _grafana_vhost if (_grafana_vhost | length > 0) else _grafana_direct %}
{% set _prom_pick = _prom_vhost if (_prom_vhost | length > 0) else _prom_direct %}
{% set _am_pick = _am_vhost if (_am_vhost | length > 0) else _am_direct %}
{% set _cadv_pick = _cadv_vhost if (_cadv_vhost | length > 0) else (_cadv_path if (deployment_portal_monitoring_routes_enabled | default(false) | bool) else _cadvisor_direct) %}
- name: "Grafana"
  url: "{{ _grafana_pick }}"
  hostname: "{{ deployment_portal_anchor_fqdn | default('') }}"
  note: "{% if _grafana_vhost | length > 0 %}Caddy vhost {{ caddy_vhost_urls_external.grafana.hostname | default('') }}; also host :{{ monitoring_grafana_host_port | default(3000) }}{% else %}Host :{{ monitoring_grafana_host_port | default(3000) }}; Caddy path {{ _grafana_path }}{% endif %}"
- name: "Prometheus"
  url: "{{ _prom_pick }}"
  hostname: "{{ deployment_portal_anchor_fqdn | default('') }}"
  note: "{% if _prom_vhost | length > 0 %}Caddy vhost {{ caddy_vhost_urls_external.prometheus.hostname | default('') }}; also host :{{ monitoring_prometheus_host_port | default(9090) }}{% else %}Host :{{ monitoring_prometheus_host_port | default(9090) }}; Caddy path {{ _prom_path }}{% endif %}"
- name: "Alertmanager"
  url: "{{ _am_pick }}"
  hostname: "{{ deployment_portal_anchor_fqdn | default('') }}"
  note: "{% if _am_vhost | length > 0 %}Caddy vhost {{ caddy_vhost_urls_external.alertmanager.hostname | default('') }}; also host :{{ monitoring_alertmanager_host_port | default(9093) }}{% else %}Host :{{ monitoring_alertmanager_host_port | default(9093) }}; Caddy path {{ _am_path }}{% endif %}"
- name: "cAdvisor"
  url: "{{ _cadv_pick | default('') | trim }}"
  hostname: "{{ deployment_portal_anchor_fqdn | default('') }}"
  note: "{% if _cadv_vhost | length > 0 %}Caddy vhost {{ caddy_vhost_urls_external.cadvisor.hostname | default('') }}; also host :{{ monitoring_cadvisor_host_port | default(8089) }}{% elif deployment_portal_monitoring_routes_enabled | default(false) | bool %}Caddy path {{ _cadv_path }}; also host :{{ monitoring_cadvisor_host_port | default(8089) }}{% else %}Container metrics on ops host :{{ monitoring_cadvisor_host_port | default(8089) }}{% endif %}"
{% endif %}
{% if deployment_portal_ecs_present | bool %}
{% set _ecs_master = groups[ecs_cluster_master_group][0] if (ecs_cluster_master_group in groups and groups[ecs_cluster_master_group] | default([]) | length > 0) else '' %}
{% set _ecs_master_ip = hostvars[_ecs_master].ansible_host | default('') if (_ecs_master | length > 0) else '' %}
- name: "ECS console"
  url: "https://console.{{ ecs_app_domain }}"
  hostname: "console.{{ ecs_app_domain }}"
  note: "Typical ECS console URL{% if _ecs_master_ip | length > 0 %}; ECS master IP {{ _ecs_master_ip }}{% endif %}"
{% endif %}
