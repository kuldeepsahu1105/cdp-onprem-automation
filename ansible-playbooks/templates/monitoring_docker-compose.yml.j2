# Intentional: prometheus, alertmanager, and grafana have no host ports — only the deployment_portal Docker network.
# Browsers and Jenkins Tier A/B use Caddy on deployment_portal_http_port (default 80) path routes (/prometheus/, /grafana/, /alertmanager/).
# cAdvisor is the exception: host port monitoring_cadvisor_host_port (default 8089) for container metrics outside Caddy.
services:
  prometheus:
    image: {{ monitoring_prometheus_image }}
    container_name: {{ monitoring_prometheus_container }}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --web.external-url={{
          caddy_vhost_urls_external.prometheus.url
          if (caddy_vhost_enabled | default(false) | bool)
          else ('http://' + deployment_portal_anchor_fqdn + ':' + (deployment_portal_http_port | string) + '/prometheus/')
        }}
      - --web.route-prefix={{ '/' if (caddy_vhost_enabled | default(false) | bool) else '/prometheus' }}
    volumes:
      - {{ monitoring_config_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    networks:
      - deployment_portal
      - monitoring_internal

  alertmanager:
    image: {{ monitoring_alertmanager_image }}
    container_name: {{ monitoring_alertmanager_container }}
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --web.external-url={{
          caddy_vhost_urls_external.alertmanager.url
          if (caddy_vhost_enabled | default(false) | bool)
          else ('http://' + deployment_portal_anchor_fqdn + ':' + (deployment_portal_http_port | string) + '/alertmanager/')
        }}
      - --web.route-prefix={{ '/' if (caddy_vhost_enabled | default(false) | bool) else '/alertmanager' }}
    volumes:
      - {{ monitoring_config_dir }}/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    networks:
      - deployment_portal
      - monitoring_internal

  grafana:
    image: {{ monitoring_grafana_image }}
    container_name: {{ monitoring_grafana_container }}
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: "{{ monitoring_grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ monitoring_grafana_admin_password }}"
      GF_SERVER_ROOT_URL: >-
        {{
          caddy_vhost_urls_external.grafana.url
          if (caddy_vhost_enabled | default(false) | bool)
          else ('http://' + deployment_portal_anchor_fqdn + ':' + (deployment_portal_http_port | string) + '/grafana/')
        }}
      GF_SERVER_SERVE_FROM_SUB_PATH: "{{ 'false' if (caddy_vhost_enabled | default(false) | bool) else 'true' }}"
    networks:
      - deployment_portal
      - monitoring_internal

  cadvisor:
    image: {{ monitoring_cadvisor_image }}
    container_name: {{ monitoring_cadvisor_container }}
    restart: unless-stopped
    ports:
      - "0.0.0.0:{{ monitoring_cadvisor_host_port }}:8080/tcp"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    networks:
      - monitoring_internal

networks:
  deployment_portal:
    external: true
    name: deployment_portal
  monitoring_internal:
    name: monitoring_internal
