{# Included per IP slug (public + optional private). Variable: caddy_vhost_urls #}
{% set _ipa_caddy_origin = 'http://{http.request.host}' ~ (':' ~ (deployment_portal_http_port | int) if (deployment_portal_http_port | int) != 80 else '') %}
{% set _ipa_caddy_vhost_host = caddy_vhost_urls.ipa.hostname %}
http://{{ caddy_vhost_urls.portal.hostname }}{% if deployment_portal_http_port | int != 80 %}:{{ deployment_portal_http_port }}{% endif %} {
{% include 'deployment_portal_Caddyfile_downloads_auth.inc.j2' %}
  @portal_static not path /downloads*
  handle @portal_static {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}

http://{{ caddy_vhost_urls.pgadmin.hostname }}{% if deployment_portal_http_port | int != 80 %}:{{ deployment_portal_http_port }}{% endif %} {
  reverse_proxy pgadmin:80
}

{% if deployment_portal_has_ipa | default(false) | bool %}
{# FreeIPA via Caddy (cloudera-labs/openshift + Adelton proxy notes): route to the inventory IP, but present the IPA FQDN in Host and Referer.
   Legacy /ipa/ui loads static assets under /ipa/js, /ipa/css, /ipa/config, /ipa/wsgi — not only /ipa/ui/*.
   Browsers use ipa.<slug> host; upstream expects ipaserver FQDN Referer and issues Set-Cookie for that FQDN — rewrite both or session/login 401.
   Optional ipaserver HTML rewrites: deployment_portal_ipa_httpd_proxy_enabled + ipa_httpd_caddy_proxy.conf.j2.
   Test on ops (PORT={{ deployment_portal_http_port }}, slug host {{ caddy_vhost_urls.ipa.hostname }}, upstream {{ deployment_portal_ipa_upstream_host }}, Host {{ deployment_portal_ipa_fqdn }}):
     curl -sS -o /dev/null -w '%{http_code}\n' -H "Host: {{ caddy_vhost_urls.ipa.hostname }}" "http://127.0.0.1:{{ deployment_portal_http_port }}/ipa/ui"
     curl -sS -o /dev/null -w '%{http_code}\n' -H "Host: {{ caddy_vhost_urls.ipa.hostname }}" "http://127.0.0.1:{{ deployment_portal_http_port }}/ipa/js/util.js"
     curl -sS -o /dev/null -w '%{http_code}\n' -H "Host: {{ deployment_portal_ipa_fqdn }}" -H "Referer: https://{{ deployment_portal_ipa_fqdn }}/ipa/ui" "http://127.0.0.1/ipa/ui"
#}
http://{{ caddy_vhost_urls.ipa.hostname }}{% if deployment_portal_http_port | int != 80 %}:{{ deployment_portal_http_port }}{% endif %} {
  redir / /ipa/modern-ui/ permanent

  @ipa_json_rpc path /ipa/json /ipa/json/* /ipa/xml*
  @ipa_session path /ipa/session /ipa/session/*
  @ipa_ui not path /ipa/json /ipa/json/* /ipa/xml* /ipa/session /ipa/session/*

  request_header @ipa_json_rpc Referer "https://{{ deployment_portal_ipa_fqdn }}/ipa"
  request_header @ipa_json_rpc Accept-Encoding identity
  request_header @ipa_session Referer "https://{{ deployment_portal_ipa_fqdn }}/ipa/modern-ui/"
  request_header @ipa_ui Referer "https://{{ deployment_portal_ipa_fqdn }}{http.request.uri.path}"

  request_header -Authorization
  request_header -Proxy-Authorization
  header -WWW-Authenticate

  reverse_proxy http://{{ deployment_portal_ipa_upstream_host }} {
    header_up Host {{ deployment_portal_ipa_fqdn }}
    header_down Location "^https?://{{ deployment_portal_ipa_fqdn | replace('.', '\\.') }}" "{{ _ipa_caddy_origin }}"
    header_down Set-Cookie "{{ deployment_portal_ipa_fqdn }}" "{{ _ipa_caddy_vhost_host }}"
  }
}
{% endif %}

{% if deployment_portal_monitoring_routes_enabled | default(false) | bool %}
http://{{ caddy_vhost_urls.grafana.hostname }}{% if deployment_portal_http_port | int != 80 %}:{{ deployment_portal_http_port }}{% endif %} {
  reverse_proxy {{ monitoring_grafana_docker_service }}:3000
}

http://{{ caddy_vhost_urls.prometheus.hostname }}{% if deployment_portal_http_port | int != 80 %}:{{ deployment_portal_http_port }}{% endif %} {
  reverse_proxy {{ monitoring_prometheus_docker_service }}:9090
}

http://{{ caddy_vhost_urls.alertmanager.hostname }}{% if deployment_portal_http_port | int != 80 %}:{{ deployment_portal_http_port }}{% endif %} {
  reverse_proxy {{ monitoring_alertmanager_docker_service }}:9093
}

http://{{ caddy_vhost_urls.cadvisor.hostname }}{% if deployment_portal_http_port | int != 80 %}:{{ deployment_portal_http_port }}{% endif %} {
  reverse_proxy {{ monitoring_cadvisor_docker_service }}:8080
}
{% endif %}
