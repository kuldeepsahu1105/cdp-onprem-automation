# Managed by Ansible — FreeIPA HTTPD behind deployment portal Caddy (cloudera-labs/openshift ipa-rewrite pattern).
# Maps the public Caddy vhost hostname to IPA canonical Host/Referer and relaxes forced HTTPS redirect for /ipa over HTTP from Caddy.

<IfModule mod_headers.c>
  RequestHeader edit Referer ^https?://{{ ipa_caddy_public_hostname | replace('.', '\\.') }}/ https://{{ deployment_portal_ipa_fqdn }}/
</IfModule>

{# Legacy Web UI embeds absolute https://<ipaserver-fqdn> links; rewrite to the Caddy vhost origin for browsers without lab DNS. #}
{% set _ipa_caddy_http_origin = 'http://' ~ ipa_caddy_public_hostname ~ (':' ~ (deployment_portal_http_port | string) if (deployment_portal_http_port | int) != 80 else '') %}
<Location /ipa/ui>
  <IfModule mod_substitute.c>
    AddOutputFilterByType SUBSTITUTE text/html text/javascript application/javascript application/json
    Substitute "s|https://{{ deployment_portal_ipa_fqdn }}|{{ _ipa_caddy_http_origin }}|ni"
    Substitute "s|http://{{ deployment_portal_ipa_fqdn }}|{{ _ipa_caddy_http_origin }}|ni"
  </IfModule>
</Location>
