{# YAML: links (portal index) + endpoints for CDP Runtime base cluster (play 31). #}
{% set _fqdn = deployment_portal_base_master_fqdn | default('') | trim %}
{% set _svc = base_cluster_install_services | default({}) %}
{% set _knox = _svc.knox | default(false) | bool %}
{% set _kport = base_cluster_knox_gateway_https_port | default(8443) %}
{% set _kproxy = 'https://' ~ _fqdn ~ ':' ~ (_kport | string) ~ (base_cluster_knox_cdp_proxy_path | default('/gateway/cdp-proxy')) %}
{% set ns = namespace(links=[], endpoints=[]) %}
{% if _fqdn | length > 0 %}
{% if _svc.hdfs | default(true) | bool %}
{% if _knox %}
{% set _url = _kproxy ~ '/hdfs/' %}
{% set ns.links = ns.links + [{'name': 'HDFS NameNode UI', 'url': _url, 'description': 'Knox cdp-proxy (Kerberos SSO when cluster is secure)'}] %}
{% set ns.endpoints = ns.endpoints + [{'name': 'HDFS NameNode (Knox)', 'url': _url, 'hostname': _fqdn, 'note': 'Knox cdp-proxy topology hdfs', 'port': (_kport | string), 'scheme': 'https'}] %}
{% else %}
{% set _url = 'http://' ~ _fqdn ~ ':' ~ (base_cluster_hdfs_namenode_ui_port | default(9870) | string) ~ '/' %}
{% set ns.links = ns.links + [{'name': 'HDFS NameNode UI', 'url': _url, 'description': 'Direct NameNode HTTP UI on base master'}] %}
{% set ns.endpoints = ns.endpoints + [{'name': 'HDFS NameNode UI', 'url': _url, 'hostname': _fqdn, 'note': 'Direct :' ~ (base_cluster_hdfs_namenode_ui_port | default(9870) | string), 'port': (base_cluster_hdfs_namenode_ui_port | default(9870) | string), 'scheme': 'http'}] %}
{% endif %}
{% endif %}
{% if _svc.yarn | default(true) | bool %}
{% if _knox %}
{% set _url = _kproxy ~ '/yarn/' %}
{% set ns.links = ns.links + [{'name': 'YARN ResourceManager UI', 'url': _url, 'description': 'Knox cdp-proxy'}] %}
{% set ns.endpoints = ns.endpoints + [{'name': 'YARN RM (Knox)', 'url': _url, 'hostname': _fqdn, 'note': 'Knox cdp-proxy topology yarn', 'port': (_kport | string), 'scheme': 'https'}] %}
{% else %}
{% set _url = 'http://' ~ _fqdn ~ ':' ~ (base_cluster_yarn_rm_ui_port | default(8088) | string) ~ '/cluster' %}
{% set ns.links = ns.links + [{'name': 'YARN ResourceManager UI', 'url': _url, 'description': 'Direct RM web UI on base master'}] %}
{% set ns.endpoints = ns.endpoints + [{'name': 'YARN ResourceManager UI', 'url': _url, 'hostname': _fqdn, 'note': 'Direct :' ~ (base_cluster_yarn_rm_ui_port | default(8088) | string), 'port': (base_cluster_yarn_rm_ui_port | default(8088) | string), 'scheme': 'http'}] %}
{% endif %}
{% endif %}
{% if _svc.hue | default(false) | bool %}
{% if _knox %}
{% set _url = _kproxy ~ '/hue/' %}
{% set ns.links = ns.links + [{'name': 'Hue', 'url': _url, 'description': 'Knox cdp-proxy (also direct :' ~ (base_cluster_hue_ui_port | default(8888) | string) ~ ')'}] %}
{% set ns.endpoints = ns.endpoints + [{'name': 'Hue (Knox)', 'url': _url, 'hostname': _fqdn, 'note': 'Knox cdp-proxy; direct Hue :' ~ (base_cluster_hue_ui_port | default(8888) | string), 'port': (_kport | string), 'scheme': 'https'}] %}
{% endif %}
{% set _url = 'http://' ~ _fqdn ~ ':' ~ (base_cluster_hue_ui_port | default(8888) | string) ~ '/' %}
{% set ns.links = ns.links + [{'name': 'Hue (direct)', 'url': _url, 'description': 'Hue UI on base master'}] %}
{% set ns.endpoints = ns.endpoints + [{'name': 'Hue (direct)', 'url': _url, 'hostname': _fqdn, 'note': 'Direct Hue :' ~ (base_cluster_hue_ui_port | default(8888) | string), 'port': (base_cluster_hue_ui_port | default(8888) | string), 'scheme': 'http'}] %}
{% endif %}
{% if _svc.hive | default(false) | bool and _knox %}
{% set _url = _kproxy ~ '/hive/' %}
{% set ns.links = ns.links + [{'name': 'Hive', 'url': _url, 'description': 'Knox cdp-proxy (HiveServer2 / JDBC via gateway)'}] %}
{% set ns.endpoints = ns.endpoints + [{'name': 'Hive (Knox)', 'url': _url, 'hostname': _fqdn, 'note': 'Knox cdp-proxy topology hive', 'port': (_kport | string), 'scheme': 'https'}] %}
{% endif %}
{% if _svc.hbase | default(false) | bool %}
{% if _knox %}
{% set _url = _kproxy ~ '/hbase/' %}
{% set ns.links = ns.links + [{'name': 'HBase Master UI', 'url': _url, 'description': 'Knox cdp-proxy'}] %}
