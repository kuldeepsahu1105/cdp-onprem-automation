{% set ns.endpoints = ns.endpoints + [{'name': 'Ozone Recon UI', 'url': _url, 'hostname': _fqdn, 'note': 'Direct :' ~ (base_cluster_ozone_recon_ui_port | default(9888) | string), 'port': (base_cluster_ozone_recon_ui_port | default(9888) | string), 'scheme': 'http'}] %}
{% endif %}
{% endif %}
{% if _svc.atlas | default(false) | bool %}
{% if _knox %}
{% set _url = _kproxy ~ '/atlas/' %}
{% set ns.links = ns.links + [{'name': 'Atlas UI', 'url': _url, 'description': 'Knox cdp-proxy'}] %}
