{% set ns.endpoints = ns.endpoints + [{'name': 'HBase Master UI', 'url': _url, 'hostname': _fqdn, 'note': 'Direct :' ~ (base_cluster_hbase_master_ui_port | default(16010) | string), 'port': (base_cluster_hbase_master_ui_port | default(16010) | string), 'scheme': 'http'}] %}
{% endif %}
{% endif %}
{% if _svc.ozone | default(false) | bool %}
