{% set _url = _kproxy ~ '/solr/' %}
{% set ns.links = ns.links + [{'name': 'Solr Admin', 'url': _url, 'description': 'Knox cdp-proxy'}] %}
{% set ns.endpoints = ns.endpoints + [{'name': 'Solr (Knox)', 'url': _url, 'hostname': _fqdn, 'note': 'Knox cdp-proxy topology solr', 'port': (_kport | string), 'scheme': 'https'}] %}
{% else %}
{% set _url = 'http://' ~ _fqdn ~ ':' ~ (base_cluster_solr_admin_port | default(8983) | string) ~ '/solr/' %}
