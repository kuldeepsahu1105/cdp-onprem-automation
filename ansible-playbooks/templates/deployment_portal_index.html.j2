                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 00.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg>
                </a>
                <a class="icon-link" href="mailto:ksahu@cloudera.com" title="Email ksahu@cloudera.com" aria-label="Email">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 4a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H2a2 2 0 01-2-2V4zm2-1a1 1 0 00-1 1v.217l7 4.2 7-4.2V4a1 1 0 00-1-1H2zm13 2.383l-4.708 2.825L15 11.105V5.383zm-.034 6.876l-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 002 13h12a1 1 0 00.966-.741zM1 11.105l4.708-2.897L1 5.383v5.722z"/></svg>
                </a>
              </span>
            </span>
            {% if ctx.deployment.owner | default('') | length > 0 %}
            <span class="label-badge label-badge-deployment"><span class="label-badge-key">Deployment owner:</span> {{ ctx.deployment.owner }}</span>
            {% endif %}
            {% if ctx.deployment.name_prefix | default('') | length > 0 %}
            <span class="label-badge label-badge-prefix" title="Terraform/Jenkins environment — resource name prefix"><span class="label-badge-key">Deployment name (prefix):</span> {{ ctx.deployment.name_prefix }}</span>
            {% endif %}
            <span class="label-badge label-badge-beta"><span class="label-badge-key">Automation</span> beta version</span>
          </div>
        </div>
        <div class="header-actions">
          <button type="button" class="help-open-btn" id="portal-help-open" aria-haspopup="dialog">Help</button>
        </div>
      </div>
      <div class="meta-row">
        <span class="chip"><strong>Domain</strong> {{ ctx.cluster_domain }}</span>
        <span class="chip"><strong>Realm</strong> {{ ctx.cluster_realm }}</span>
        <span class="chip"><strong>Identity</strong> {{ ctx.identity_provider }}</span>
        <span class="chip"><strong>Access</strong> {{ ctx.access.profile }} ({{ ctx.access.environment }})</span>
        <span class="chip"><strong>Generated</strong> {{ ctx.generated_at }}</span>
      </div>
    </div>
  </header>

  <main class="wrap">
    <nav class="quick-actions" aria-label="Primary services">
      <h2>Quick open</h2>
      <div class="tile-grid">
        {% if cm_tile_url | length > 0 %}
        <a class="tile tile-accent" href="{{ cm_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Cloudera Manager</span>
          <span class="tile-hint">Cluster admin UI</span>
        </a>
        {% endif %}
        {% if ctx.portal.pgadmin_url | default(pgadmin_tile_url | default('')) | length > 0 %}
        <a class="tile" href="{{ ctx.portal.pgadmin_url | default(pgadmin_tile_url) }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">pgAdmin</span>
          <span class="tile-hint">CM PostgreSQL{% if ctx.portal.pgadmin_caddy_url | default('') | length > 0 %} (Caddy){% endif %}</span>
        </a>
        {% endif %}
        {% if mon_on %}
        <a class="tile" href="{{ grafana_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Grafana</span>
          <span class="tile-hint">{% if ctx.monitoring.grafana_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_grafana_host_port | default(3000) }}{% endif %}</span>
        </a>
        <a class="tile" href="{{ prometheus_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Prometheus</span>
          <span class="tile-hint">{% if ctx.monitoring.prometheus_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_prometheus_host_port | default(9090) }}{% endif %}</span>
        </a>
        <a class="tile" href="{{ alertmanager_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Alertmanager</span>
          <span class="tile-hint">{% if ctx.monitoring.alertmanager_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_alertmanager_host_port | default(9093) }}{% endif %}</span>
        </a>
        <a class="tile" href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">cAdvisor</span>
          <span class="tile-hint">Container metrics (host :{{ monitoring_cadvisor_host_port | default(8089) }})</span>
        </a>
        {% endif %}
        {% if ipa_tile_url | length > 0 %}
        <a class="tile" href="{{ ipa_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_modern_label | default(ctx.identity.ipa_ui_label) }}</span>
          <span class="tile-hint">Identity management (default)</span>
        </a>
        {% endif %}
        {% if ipa_legacy_caddy_url | length > 0 %}
        <a class="tile" href="{{ ipa_legacy_caddy_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</span>
          <span class="tile-hint">Classic Web UI</span>
        </a>
        {% elif ctx.identity.ipa_ui_url | default('') | length > 0 and ipa_tile_url != ctx.identity.ipa_ui_url %}
        <a class="tile" href="{{ ctx.identity.ipa_ui_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (direct HTTPS)') }}</span>
          <span class="tile-hint">{{ ctx.identity.ipa_ui_url }}</span>
        </a>
        {% endif %}
        {% if ecs_tile_url | length > 0 %}
        <a class="tile" href="{{ ecs_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">ECS</span>
          <span class="tile-hint">{% if ctx.ecs.deployed %}{{ ctx.ecs.cluster_name }}{% else %}Console{% endif %}</span>
        </a>
        {% endif %}
        {% if portal_tile_url | length > 0 %}
        <a class="tile tile-accent" target="_blank" rel="noopener noreferrer" href="{{ portal_tile_url }}">
          <span class="tile-label">Deployment portal</span>
          <span class="tile-hint">{{ portal_tile_hint }}</span>
        </a>
        {% endif %}
      </div>
    </nav>

    <section class="live-stats" id="live-stats" aria-label="Cluster health snapshot">
      <div class="live-stats-head">
        <h2>Health snapshot</h2>
        <span class="live-stats-updated" id="live-stats-updated">
          {% if ls.collected_at | default('') | length > 0 %}CM snapshot {{ ls.collected_at }}{% else %}Awaiting data{% endif %}
        </span>
      </div>
      <div class="kpi-grid" id="live-stats-kpis">
        <div class="kpi kpi-info" data-kpi="hosts-total">
          <div class="kpi-label">CM hosts</div>
          <div class="kpi-val">{{ ls.hosts.total | default(ls.inventory_host_count | default('—')) }}</div>
          <div class="kpi-sub" data-kpi-sub="hosts-heartbeat">{% if ls.hosts.good is defined %}{{ ls.hosts.good }}/{{ ls.hosts.total }} GOOD{% else %}inventory {{ ls.inventory_host_count | default('—') }}{% endif %}</div>
        </div>
        <div class="kpi kpi-pass" data-kpi="services-good">
          <div class="kpi-label">Services GOOD</div>
          <div class="kpi-val" id="kpi-services-good">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.sgood }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">STARTED+GOOD across clusters</div>
        </div>
        <div class="kpi kpi-warn" data-kpi="services-warn">
          <div class="kpi-label">CONCERNING</div>
          <div class="kpi-val" id="kpi-services-warn">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.swarn }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">CM service health</div>
        </div>
        <div class="kpi kpi-fail" data-kpi="services-bad">
          <div class="kpi-label">BAD</div>
          <div class="kpi-val" id="kpi-services-bad">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.sbad }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">CM service health</div>
        </div>
        {% if mon_on %}
        <div class="kpi kpi-accent" data-kpi="prom-up">
          <div class="kpi-label">Prometheus UP</div>
          <div class="kpi-val" id="kpi-prom-up">—</div>
          <div class="kpi-sub" data-kpi-sub="prom-detail">{% if ls_poll_prom | length > 0 %}live poll{% else %}enable path routes{% endif %}</div>
        </div>
        {% endif %}
        <div class="kpi kpi-info" data-kpi="parcels">
          <div class="kpi-label">Parcels</div>
          <div class="kpi-val" id="kpi-parcels">{{ ls.parcels | default([]) | length }}</div>
          <div class="kpi-sub">ACTIVATED</div>
        </div>
      </div>
      <p class="live-note" id="live-stats-note">
        {% if ls.cm_api_available | default(false) %}
        Service health, host heartbeats, and parcels are captured from the Cloudera Manager API during <code>35_refresh_deployment_portal.yml</code> (not live in the browser).
        {% else %}
        Cloudera Manager API snapshot unavailable from Ansible — counts fall back to inventory. Re-run portal refresh after CM is up.
        {% endif %}
        {% if mon_on and ls_poll_prom | length > 0 %}
        Prometheus target count refreshes every 60s on the ops-host portal URL (same origin, path <code>/prometheus</code>).
        {% elif mon_on %}
        Open the portal via the ops host port (not the portal-only lab vhost) for in-browser Prometheus polls.
        {% endif %}
      </p>
      {% if ls.clusters | default([]) | length > 0 %}
      <details class="panel" style="margin-top:0.75rem">
        <summary><span class="summary-main"><h2 class="section-title">Service health (CM snapshot)</h2></span>{{ panel_chevron | safe }}</summary>
        <div class="panel-body">
          <div class="table-scroll">
            <table id="live-stats-services-table" class="portal-table">
              <thead>
                <tr>
                  <th>Cluster</th>
                  <th>Service</th>
                  <th>Type</th>
                  <th>State</th>
                  <th>Health</th>
                </tr>
              </thead>
              <tbody>
                {% for cl in ls.clusters | default([]) %}
                {% for svc in cl.services | default([]) %}
                <tr>
                  <td><code>{{ cl.name }}</code></td>
                  <td>{{ svc.name }}</td>
                  <td>{{ svc.type }}</td>
                  <td>{{ svc.service_state }}</td>
                  <td>
                    {% set _h = svc.health | default('') | upper %}
                    <span class="health-pill {% if _h == 'GOOD' %}good{% elif _h == 'CONCERNING' %}concerning{% elif _h == 'BAD' %}bad{% else %}na{% endif %}">{{ svc.health }}</span>
                  </td>
                </tr>
                {% endfor %}
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </details>
      {% endif %}
    </section>

    {% if oa.enabled | default(false) | bool and (oa.sections | default([]) | length > 0) %}
    <details class="panel" open>
      <summary><span class="summary-main"><h2 class="section-title">Operator access — credentials &amp; downloads</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub">Lab deployment secrets rendered at portal sync from Ansible group_vars (not stored in git). Use only on trusted networks.</p>
        {% if oa.ssh_keys_exposed | default(false) | bool and not (oa.basic_auth_enabled | default(false) | bool) %}
        <p class="operator-warning"><strong>SSH keys are downloadable without HTTP auth.</strong> Set <code>deployment_portal_basic_auth_enabled: true</code> or <code>deployment_portal_expose_ssh_keys: false</code>.</p>
        {% endif %}
        {% if oa.basic_auth_enabled | default(false) | bool %}
        <p class="sub">Downloads under <code>{{ oa.downloads_path_prefix | default('/downloads') }}/</code> require HTTP basic auth user <code>{{ oa.auth_username | default('portal') }}</code> (password from <code>deployment_portal_basic_auth_password</code>).</p>
        {% endif %}
        <p class="sub">SSH user for instances: <code>{{ oa.ssh_user | default('ec2-user') }}</code>
          — <a href="{{ oa.downloads_path_prefix | default('/downloads') }}/operator-credentials.json">operator-credentials.json</a> (machine-readable bundle; same auth as other downloads when basic auth is enabled)
        </p>
        {% if oa.ssh_connect_command | default('') | length > 0 %}
        <p class="sub"><strong>SSH quick start</strong>{% if oa.ssh_keys_exposed | default(false) | bool %} — download <code>{{ oa.ssh_connect_key_filename | default('cluster-access.pem') }}</code> from <code>{{ oa.downloads_path_prefix | default('/downloads') }}/ssh/</code>, run <code>chmod 400 {{ oa.ssh_connect_key_filename | default('cluster-access.pem') }}</code>,{% else %} — use your lab PEM (for example <code>{{ oa.ssh_connect_key_filename | default('cluster-access.pem') }}</code> from Terraform/Jenkins),{% endif %} then connect (example host <code>{{ oa.ssh_connect_host | default('ipaserver') }}</code>; FQDN or public IP from inventory also work):</p>
        <div class="ssh-command-box"><code>{{ oa.ssh_connect_command }}</code></div>
        {% endif %}
        {% if oa.ssh_host_examples | default([]) | length > 0 %}
        <p class="sub"><strong>SSH sample commands (per host)</strong> — same user/key; paths are relative to where you saved the PEM.</p>
        <div class="table-scroll">
          <table class="portal-table">
            <thead>
              <tr>
                <th>Host</th>
                <th>FQDN</th>
                <th>Command</th>
              </tr>
            </thead>
            <tbody>
              {% for ex in oa.ssh_host_examples %}
              <tr>
                <td><code>{{ ex.label }}</code></td>
                <td><code>{{ ex.host }}</code></td>
                <td><code class="ssh-inline-cmd">{{ ex.command }}</code></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% for sec in oa.sections | default([]) %}
        <h2 class="section-title" style="margin-top:1rem">{{ sec.title }}</h2>
        {% if sec.intro | default('') | length > 0 %}<p class="sub">{{ sec.intro }}</p>{% endif %}
        {% if sec.downloads | default([]) | length > 0 %}
        <ul class="cred-dl-list">
          {% for dl in sec.downloads %}
          <li><a href="{{ dl.href }}" download="{{ dl.filename | default('') }}">{{ dl.label }}</a>{% if dl.note | default('') | length > 0 %} — <span class="badge">{{ dl.note }}</span>{% endif %}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if sec.credentials | default([]) | length > 0 %}
        <div class="table-scroll">
          <table class="portal-table cred-table">
            <thead>
              <tr>
                <th>Service</th>
                <th>Username</th>
                <th>Password / secret</th>
                <th>URL</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {% for cr in sec.credentials %}
              <tr>
                <td>{{ cr.label }}</td>
                <td><code>{{ cr.username }}</code></td>
                <td><code class="cred-secret">{{ cr.password }}</code></td>
                <td>{% if cr.url | default('') | length > 0 %}<a href="{{ cr.url }}" target="_blank" rel="noopener noreferrer">{{ cr.url }}</a>{% else %}<span class="badge">—</span>{% endif %}</td>
                <td>{{ cr.note | default('') }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </details>
    {% endif %}

    {% if ctx.endpoints | default([]) | length > 0 %}
    <section class="flat">
      <h2>Endpoints</h2>
      <p class="sub"><strong>Service</strong> is the product or UI name. <strong>Hostname</strong> is the inventory FQDN of the backing host (or ECS console name). Links open in a new tab.{% if mon_on %} Monitoring rows prefer Caddy vhosts when configured, else direct host ports (<code>{{ monitoring_grafana_host_port | default(3000) }}</code>, <code>{{ monitoring_prometheus_host_port | default(9090) }}</code>, <code>{{ monitoring_alertmanager_host_port | default(9093) }}</code>, <code>{{ monitoring_cadvisor_host_port | default(8089) }}</code>); Caddy path routes on <code>:{{ deployment_portal_http_port | default(81) }}</code> remain available.{% endif %}</p>
      <div class="table-scroll">
        <table class="portal-table">
          <thead>
            <tr>
              <th>Service</th>
              <th>URL</th>
              <th>Hostname</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {% for ep in ctx.endpoints %}
            <tr>
              <td>{{ ep.name }}</td>
              <td><a href="{{ ep.url }}" target="_blank" rel="noopener noreferrer">{{ ep.url }}</a></td>
              <td>{% if ep.hostname | default('') | length > 0 %}<code>{{ ep.hostname }}</code>{% else %}<span class="badge">—</span>{% endif %}</td>
              <td>{{ ep.note | default('') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if ctx.access.profile == 'private' %}
    <details class="panel" open>
      <summary><span class="summary-main"><h2 class="section-title">Network access (private lab)</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub">{{ ctx.access.primary.audience }}</p>
        <ul class="clean">
          <li>Ops FQDN: <code>{{ ctx.access.primary.fqdn }}</code></li>
          <li>Management IP: <code>{{ ctx.access.primary.management_ip }}</code></li>
          <li>URL host in links: <code>{{ ctx.access.primary.host }}</code></li>
          <li><strong>Portal</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.primary.portal }}">{{ ctx.access.primary.portal }}</a></li>
          <li><strong>pgAdmin</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.primary.pgadmin }}">{{ ctx.access.primary.pgadmin }}</a></li>
          {% if mon_on %}
          <li><strong>Grafana</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ grafana_tile_url }}">{{ grafana_tile_url }}</a></li>
          <li><strong>Prometheus</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ prometheus_tile_url }}">{{ prometheus_tile_url }}</a></li>
          <li><strong>Alertmanager</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ alertmanager_tile_url }}">{{ alertmanager_tile_url }}</a></li>
          <li><strong>cAdvisor</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ cadvisor_tile_url }}">{{ cadvisor_tile_url }}</a></li>
          {% endif %}
        </ul>
      </div>
    </details>
    {% else %}
    <details class="panel" open>
      <summary><span class="summary-main"><h2 class="section-title">Network access</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub"><strong>Internet / external</strong> — {{ ctx.access.external.audience }}</p>
        <ul class="clean">
          <li>Ops public IP: <code>{{ ctx.access.external.ops_ip }}</code></li>
          <li><strong>Portal</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.external.portal }}">{{ ctx.access.external.portal }}</a></li>
          <li><strong>pgAdmin</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.external.pgadmin }}">{{ ctx.access.external.pgadmin }}</a></li>
          {% if mon_on %}
          <li><strong>Grafana</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ grafana_tile_url }}">{{ grafana_tile_url }}</a></li>
          <li><strong>Prometheus</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ prometheus_tile_url }}">{{ prometheus_tile_url }}</a></li>
          <li><strong>Alertmanager</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ alertmanager_tile_url }}">{{ alertmanager_tile_url }}</a></li>
          <li><strong>cAdvisor</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ cadvisor_tile_url }}">{{ cadvisor_tile_url }}</a></li>
          {% endif %}
        </ul>
        <p class="sub" style="margin-top:0.85rem"><strong>Same VPC (private IP)</strong> — {{ ctx.access.vpc.audience }}</p>
        <ul class="clean">
          <li>Ops private IP: <code>{{ ctx.access.vpc.ops_ip }}</code></li>
          <li><strong>Portal</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.vpc.portal }}">{{ ctx.access.vpc.portal }}</a></li>
          <li><strong>pgAdmin</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.vpc.pgadmin }}">{{ ctx.access.vpc.pgadmin }}</a></li>
          {% if mon_on %}
          {% set _vpc_graf = ctx.monitoring.grafana_url_vpc | default(ctx.caddy_vhosts.urls_vpc.grafana.url | default(ctx.access.vpc.grafana)) %}
          {% set _vpc_prom = ctx.monitoring.prometheus_url_vpc | default(ctx.caddy_vhosts.urls_vpc.prometheus.url | default(ctx.access.vpc.prometheus)) %}
          {% set _vpc_am = ctx.monitoring.alertmanager_url_vpc | default(ctx.caddy_vhosts.urls_vpc.alertmanager.url | default(ctx.access.vpc.alertmanager)) %}
          {% set _vpc_cadv = ctx.monitoring.cadvisor_url_vpc | default(ctx.access.vpc.cadvisor) %}
          <li><strong>Grafana</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ _vpc_graf }}">{{ _vpc_graf }}</a></li>
          <li><strong>Prometheus</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ _vpc_prom }}">{{ _vpc_prom }}</a></li>
          <li><strong>Alertmanager</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ _vpc_am }}">{{ _vpc_am }}</a></li>
          <li><strong>cAdvisor</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ _vpc_cadv }}">{{ _vpc_cadv }}</a></li>
          {% endif %}
        </ul>
      </div>
    </details>
    {% endif %}

    {% if ctx.caddy_vhosts.enabled %}
    <details class="panel">
      <summary><span class="summary-main"><h2 class="section-title">Lab domain (Caddy) — {{ ctx.caddy_vhosts.public_base }}</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        {% if ctx.access.profile == 'private' %}
        <p class="sub">Mode <code>{{ ctx.caddy_vhosts.dns_mode }}</code> — hostnames resolve to the ops host on your private network (FreeIPA/AD DNS or static records). No public internet required.</p>
        {% else %}
        <p class="sub">Mode <code>{{ ctx.caddy_vhosts.dns_mode }}</code> — public-IP hostnames for external/internet; private-IP hostnames when registered for in-VPC use.</p>
        {% endif %}
        <ul class="clean">
          <li><strong>Portal</strong> — <a href="{{ ctx.caddy_vhosts.urls_public.portal.url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.portal.hostname }}</a></li>
          <li><strong>pgAdmin</strong> — <a href="{{ ctx.caddy_vhosts.urls_public.pgadmin.url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.pgadmin.hostname }}</a></li>
          <li><strong>Cloudera Manager (direct HTTPS)</strong> — <a href="{{ ctx.cloudera_manager.ui_url_https }}" target="_blank" rel="noopener noreferrer">{{ ctx.cloudera_manager.ui_url_https }}</a> <span class="badge">{{ ctx.cloudera_manager.host_fqdn }} :7180/:7183</span></li>
          {% if mon_on %}
          <li><strong>Grafana</strong> — <a href="{{ grafana_tile_url }}" target="_blank" rel="noopener noreferrer">{% if ctx.caddy_vhosts.urls_public.grafana.hostname | default('') | length > 0 %}{{ ctx.caddy_vhosts.urls_public.grafana.hostname }}{% else %}{{ grafana_tile_url }}{% endif %}</a></li>
          <li><strong>Prometheus</strong> — <a href="{{ prometheus_tile_url }}" target="_blank" rel="noopener noreferrer">{% if ctx.caddy_vhosts.urls_public.prometheus.hostname | default('') | length > 0 %}{{ ctx.caddy_vhosts.urls_public.prometheus.hostname }}{% else %}{{ prometheus_tile_url }}{% endif %}</a></li>
          <li><strong>Alertmanager</strong> — <a href="{{ alertmanager_tile_url }}" target="_blank" rel="noopener noreferrer">{% if ctx.caddy_vhosts.urls_public.alertmanager.hostname | default('') | length > 0 %}{{ ctx.caddy_vhosts.urls_public.alertmanager.hostname }}{% else %}{{ alertmanager_tile_url }}{% endif %}</a></li>
          <li><strong>cAdvisor</strong> — <a href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">{{ cadvisor_tile_url }}</a></li>
          {% endif %}
          {% if ctx.caddy_vhosts.urls_vpc.portal is defined and ctx.caddy_vhosts.urls_vpc.portal.url | default('') | length > 0 %}
          <li><strong>Portal (VPC slug)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.caddy_vhosts.urls_vpc.portal.url }}">{{ ctx.caddy_vhosts.urls_vpc.portal.hostname }}</a></li>
          {% endif %}
          {% if ctx.identity.ipa_caddy_modern_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_modern_label | default('FreeIPA (modern UI)') }}</strong> — <a href="{{ ctx.identity.ipa_caddy_modern_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.ipa.hostname }}/ipa/modern-ui/</a></li>
          {% endif %}
          {% if ctx.identity.ipa_caddy_legacy_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</strong> — <a href="{{ ctx.identity.ipa_caddy_legacy_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.ipa.hostname }}/ipa/ui</a></li>
          {% elif ctx.identity.ipa_caddy_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_label }}</strong> — <a href="{{ ctx.identity.ipa_caddy_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.ipa.hostname }}</a> (redirects to modern UI)</li>
          {% endif %}
        </ul>
      </div>
    </details>
    {% endif %}

    <details class="panel">
      <summary><span class="summary-main"><h2 class="section-title">Ops host &amp; platform details</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub">Reverse proxy and containerized UIs on <code>{{ ctx.ops_host.fqdn }}</code> <span class="badge">{{ ctx.ops_host.inventory_group }}</span>. {{ ctx.ops_host.services }}</p>
        <ul class="clean">
          <li><strong>Deployment portal</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ portal_tile_url | default(ctx.portal.index_url) }}">{{ portal_tile_url | default(ctx.portal.index_url) }}</a></li>
          <li><strong>pgAdmin</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ pgadmin_tile_url }}">{{ pgadmin_tile_url }}</a> <span class="badge">CM DB on {{ ctx.postgresql.host_fqdn }}</span></li>
          {% if ctx.portal.pgadmin_caddy_url | default('') | length > 0 and ctx.portal.pgadmin_url_direct | default('') | length > 0 %}
          <li><strong>pgAdmin (direct port)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.portal.pgadmin_url_direct }}">{{ ctx.portal.pgadmin_url_direct }}</a></li>
          {% endif %}
          {% if mon_on %}
          <li><strong>Grafana</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ grafana_tile_url }}">{{ grafana_tile_url }}</a></li>
          {% if ctx.monitoring.grafana_caddy_url | default('') | length > 0 and ctx.monitoring.grafana_url_direct | default('') | length > 0 %}
          <li><strong>Grafana (direct port)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.monitoring.grafana_url_direct }}">{{ ctx.monitoring.grafana_url_direct }}</a></li>
          {% endif %}
          <li><strong>Prometheus</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ prometheus_tile_url }}">{{ prometheus_tile_url }}</a></li>
          {% if ctx.monitoring.prometheus_caddy_url | default('') | length > 0 and ctx.monitoring.prometheus_url_direct | default('') | length > 0 %}
          <li><strong>Prometheus (direct port)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.monitoring.prometheus_url_direct }}">{{ ctx.monitoring.prometheus_url_direct }}</a></li>
          {% endif %}
          <li><strong>Alertmanager</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ alertmanager_tile_url }}">{{ alertmanager_tile_url }}</a></li>
          {% if ctx.monitoring.alertmanager_caddy_url | default('') | length > 0 and ctx.monitoring.alertmanager_url_direct | default('') | length > 0 %}
          <li><strong>Alertmanager (direct port)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.monitoring.alertmanager_url_direct }}">{{ ctx.monitoring.alertmanager_url_direct }}</a></li>
          {% endif %}
          <li><strong>cAdvisor</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ cadvisor_tile_url }}">{{ cadvisor_tile_url }}</a> <span class="badge">:{{ monitoring_cadvisor_host_port | default(8089) }}</span></li>
          {% endif %}
          <li><strong>Cloudera Manager (direct HTTP)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.cloudera_manager.ui_url_http }}">{{ ctx.cloudera_manager.ui_url_http }}</a> <span class="badge">VPC / admin</span></li>
          <li><strong>Cloudera Manager (direct HTTPS)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.cloudera_manager.ui_url_https }}">{{ ctx.cloudera_manager.ui_url_https }}</a> <span class="badge">:7183 on {{ ctx.cloudera_manager.host_fqdn }}</span></li>
          {% if ctx.identity.ipa_caddy_modern_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_modern_label | default('FreeIPA (modern UI)') }}</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.identity.ipa_caddy_modern_url }}">{{ ctx.identity.ipa_caddy_modern_url }}</a></li>
          {% endif %}
          {% if ctx.identity.ipa_caddy_legacy_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.identity.ipa_caddy_legacy_url }}">{{ ctx.identity.ipa_caddy_legacy_url }}</a></li>
          {% endif %}
          {% if ctx.identity.ipa_ui_url %}
          <li><strong>{{ ctx.identity.ipa_ui_label }} (HTTPS on ipaserver)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.identity.ipa_ui_url }}">{{ ctx.identity.ipa_ui_url }}</a></li>
          {% endif %}
        </ul>
        <h2 class="section-title" style="margin-top:1rem">PostgreSQL</h2>
        <ul class="clean">
          <li>Host: <code>{{ ctx.postgresql.host_fqdn }}</code></li>
          <li>Port: <code>{{ ctx.postgresql.port }}</code></li>
          <li>{{ ctx.postgresql.database_host_note }}</li>
        </ul>
        <h2 class="section-title" style="margin-top:1rem">Clusters</h2>
        <ul class="clean">
          <li>CDP Runtime base cluster: <code>{{ ctx.cloudera_manager.cluster_name }}</code></li>
          {% if ctx.ecs.deployed %}
          <li>ECS cluster: <code>{{ ctx.ecs.cluster_name }}</code></li>
          <li>ECS app domain: <code>{{ ctx.ecs.app_domain }}</code></li>
          <li>ECS console — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.ecs.console_hint }}">{{ ctx.ecs.console_hint }}</a></li>
          <li>ECS direct HTTPS — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.ecs.console_url_direct | default('https://console.' ~ ctx.ecs.app_domain) }}">{{ ctx.ecs.console_url_direct | default('https://console.' ~ ctx.ecs.app_domain) }}</a></li>
          <li>Data Services hostnames: <code>{{ ctx.ecs.apps_wildcard }}</code></li>
          {% else %}
          <li>ECS: <span class="badge">not in inventory</span></li>
          {% endif %}
        </ul>
        <p class="sub">Versions — CM {{ ctx.versions.cm }} · CDP Runtime {{ ctx.versions.cdh }} · CDS {{ ctx.versions.ecs_cds }}</p>
        {% if ctx.data_services.links | length > 0 %}
        <h2 class="section-title" style="margin-top:1rem">Data services &amp; related URLs</h2>
        <ul class="clean">
          {% for link in ctx.data_services.links %}
          <li><strong>{{ link.name }}</strong>{% if link.description %} — {{ link.description }}{% endif %} — <a target="_blank" rel="noopener noreferrer" href="{{ link.url }}">{{ link.url }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if ctx.extra_links | length > 0 %}
        <h2 class="section-title" style="margin-top:1rem">Additional links</h2>
        <ul class="clean">
          {% for link in ctx.extra_links %}
          <li><strong>{{ link.name }}</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ link.url }}">{{ link.url }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </details>

    {% if mon_on %}
    <section class="flat">
      <h2>Monitoring stack (on ops host)</h2>
      <p class="sub">Prefer Caddy lab vhosts when DNS is configured; direct host ports <code>{{ monitoring_grafana_host_port | default(3000) }}</code>, <code>{{ monitoring_prometheus_host_port | default(9090) }}</code>, <code>{{ monitoring_alertmanager_host_port | default(9093) }}</code>, and cAdvisor <code>{{ monitoring_cadvisor_host_port | default(8089) }}</code> work without Caddy; path routes on <code>:{{ deployment_portal_http_port | default(81) }}</code> remain available.</p>
      <ul class="clean">
        <li><strong>Grafana</strong> — <a href="{{ grafana_tile_url }}" target="_blank" rel="noopener noreferrer">{{ grafana_tile_url }}</a> <span class="badge">host :{{ monitoring_grafana_host_port | default(3000) }}</span></li>
        <li><strong>Prometheus</strong> — <a href="{{ prometheus_tile_url }}" target="_blank" rel="noopener noreferrer">{{ prometheus_tile_url }}</a> <span class="badge">host :{{ monitoring_prometheus_host_port | default(9090) }}</span></li>
        <li><strong>Alertmanager</strong> — <a href="{{ alertmanager_tile_url }}" target="_blank" rel="noopener noreferrer">{{ alertmanager_tile_url }}</a> <span class="badge">host :{{ monitoring_alertmanager_host_port | default(9093) }}</span></li>
        <li><strong>cAdvisor</strong> — <a href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">{{ cadvisor_tile_url }}</a> <span class="badge">host port {{ monitoring_cadvisor_host_port | default(8089) }}</span></li>
        {% if ctx.monitoring.grafana_path_url | default('') | length > 0 %}
        <li><strong>Caddy path fallbacks</strong> — Grafana <a href="{{ ctx.monitoring.grafana_path_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.monitoring.grafana_path_url }}</a>;
          Prometheus <a href="{{ ctx.monitoring.prometheus_path_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.monitoring.prometheus_path_url }}</a>;
          Alertmanager <a href="{{ ctx.monitoring.alertmanager_path_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.monitoring.alertmanager_path_url }}</a>;
          cAdvisor <a href="{{ ctx.monitoring.cadvisor_path_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.monitoring.cadvisor_path_url }}</a></li>
        {% endif %}
      </ul>
    </section>
    {% endif %}

    {% if ctx.planned_roles | default([]) | length > 0 %}
    <section class="flat">
      <h2>Planned / configured roles</h2>
      <p class="sub">From Ansible inventory groups, <code>host_template</code> hostvars, <code>base_cluster_install_services</code>, and the monitoring portal stack on the ops host (<code>{{ ctx.ops_host.inventory_group | default('ipaserver') }}</code>).</p>
      <div class="table-scroll">
        <table class="portal-table">
          <thead>
            <tr>
              <th>Stack</th>
              <th>Role</th>
              <th>Placement</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {% for row in ctx.planned_roles %}
            <tr>
              <td>{{ row.stack }}</td>
              <td>{{ row.role }}</td>
              <td><code>{{ row.placement }}</code></td>
              <td><span class="badge">{{ row.source }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if ls.clusters | default([]) | length > 0 %}
    <section class="flat">
      <h2>CM services (live snapshot)</h2>
      <p class="sub">From Cloudera Manager API at portal refresh; same data as the health snapshot KPIs above.</p>
      <div class="table-scroll">
        <table class="portal-table">
          <thead>
            <tr>
              <th>Cluster</th>
              <th>Service</th>
              <th>Type</th>
              <th>State</th>
              <th>Health</th>
            </tr>
          </thead>
          <tbody>
            {% for cl in ls.clusters | default([]) %}
            {% for svc in cl.services | default([]) %}
            <tr>
              <td><code>{{ cl.name }}</code></td>
              <td>{{ svc.name }}</td>
              <td>{{ svc.type }}</td>
              <td>{{ svc.service_state }}</td>
              <td>
                {% set _h = svc.health | default('') | upper %}
                <span class="health-pill {% if _h == 'GOOD' %}good{% elif _h == 'CONCERNING' %}concerning{% elif _h == 'BAD' %}bad{% else %}na{% endif %}">{{ svc.health }}</span>
              </td>
            </tr>
            {% endfor %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if ctx.inventory_hosts | default([]) | length > 0 %}
    <section class="flat">
      <h2>Host inventory</h2>
      <p class="sub">One row per host: Ansible groups, addresses, inferred roles, and sample <code>ssh -i &lt;pem&gt;</code> commands (user <code>{{ oa.ssh_user | default('ec2-user') }}</code>, key file <code>{{ oa.ssh_connect_key_filename | default('cluster-access.pem') }}</code>).</p>
      <div class="table-scroll">
        <table class="portal-table inventory-table">
          <thead>
            <tr>
              <th>Host</th>
              <th>FQDN</th>
              <th>Private IP</th>
              <th>Public IP</th>
              <th>Inventory groups</th>
              <th>Roles installed</th>
              <th>SSH login</th>
            </tr>
          </thead>
          <tbody>
            {% for h in ctx.inventory_hosts %}
            <tr>
              <td><code>{{ h.hostname }}</code> <span class="badge">{{ h.inventory_name }}</span></td>
              <td><code>{{ h.fqdn }}</code></td>
              <td><code>{{ h.private_ip }}</code></td>
              <td>{% if h.public_ip | default('') | length > 0 and ('{{' not in (h.public_ip | string)) %}<code>{{ h.public_ip }}</code>{% else %}<span class="badge">VPC only</span>{% endif %}</td>
              <td>
                {% for gl in h.group_labels | default(h.groups | default([])) %}
                <span class="group-tag">{{ gl }}</span>
                {% endfor %}
              </td>
              <td>
                {% for role in h.role_labels | default([]) %}
                <span class="role-badge">{{ role }}</span>
                {% endfor %}
              </td>
              <td>{% if h.ssh_command | default('') | length > 0 %}<code class="ssh-inline-cmd">{{ h.ssh_command }}</code>{% else %}<span class="badge">—</span>{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}
  </main>
  <dialog class="help-dialog" id="portal-help-dialog" aria-labelledby="portal-help-title">
    <div class="help-dialog-head">
      <h2 id="portal-help-title">Using this deployment portal</h2>
      <button type="button" class="help-close-btn" id="portal-help-close" aria-label="Close help">Close</button>
    </div>
    <div class="help-dialog-inner">
      <p class="sub"><strong>Quick open</strong> — tiles link to Cloudera Manager, pgAdmin, monitoring, FreeIPA (modern and legacy via Caddy when configured), ECS, and this portal.</p>
      <p class="sub"><strong>Health snapshot</strong> — Cloudera Manager service health from the last portal refresh (<code>35_refresh_deployment_portal.yml</code>); Prometheus target count may poll in-browser when path routes are enabled.</p>
      <p class="sub"><strong>Operator access</strong> — lab credentials and PEM downloads rendered at sync from Ansible group_vars (not stored in git). Treat as sensitive; restrict network access.</p>
      <p class="sub"><strong>Endpoints &amp; network access</strong> — consolidated URLs with inventory hostnames; private-lab vs public/VPC tiers match your access profile.</p>
      <p class="sub"><strong>Host inventory &amp; planned roles</strong> — Ansible groups, addresses, and inferred CDP/monitoring placement.</p>
      <p class="sub"><strong>Downloads security</strong> — when <code>deployment_portal_basic_auth_enabled</code> is true, files under <code>/downloads</code> (including SSH keys) require HTTP basic auth. Prefer auth on before exposing PEMs.</p>
      <p class="sub"><strong>FreeIPA legacy UI</strong> — use the Caddy <code>ipa.*</code> vhost (<code>/ipa/ui</code>) so browsers do not need <code>/etc/hosts</code> for the ipaserver FQDN; direct <code>https://&lt;ipaserver-fqdn&gt;</code> still needs lab DNS.</p>
    </div>
  </dialog>
