<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>CDP Deployment Portal — {{ ctx.cluster_domain }}</title>
  <style>
    :root { --bg: #0f1419; --card: #1a2332; --text: #e7ecf3; --muted: #9aa8bc; --accent: #5b9fd4; --border: #2d3a4d; }
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 1.5rem; line-height: 1.5; }
    h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
    .sub { color: var(--muted); font-size: 0.9rem; margin-bottom: 1.5rem; }
    section { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
    h2 { font-size: 1.05rem; margin: 0 0 0.75rem; color: var(--accent); }
    ul { margin: 0; padding-left: 1.2rem; }
    li { margin: 0.35rem 0; }
    a { color: #7ec8ff; text-decoration: none; }
    a:hover { text-decoration: underline; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th, td { text-align: left; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-weight: 600; }
    code { background: #0b1018; padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.85em; }
    .badge { display: inline-block; background: #243044; color: var(--muted); padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; margin-left: 0.35rem; }
  </style>
</head>
<body>
{% set ctx = deployment_portal_context %}
  <h1>Cloudera CDP deployment portal</h1>
  <p class="sub">Domain <code>{{ ctx.cluster_domain }}</code> · realm <code>{{ ctx.cluster_realm }}</code> · identity <code>{{ ctx.identity_provider }}</code> · generated {{ ctx.generated_at }}</p>

  <section>
    <h2>From Jenkins / internet (public IP)</h2>
    <p class="sub">{{ ctx.access.external.audience }}</p>
    <ul>
      <li>Ops public IP: <code>{{ ctx.access.external.ops_ip }}</code></li>
      <li><strong>Portal</strong> — <a href="{{ ctx.access.external.portal }}">{{ ctx.access.external.portal }}</a></li>
      <li><strong>pgAdmin</strong> — <a href="{{ ctx.access.external.pgadmin }}">{{ ctx.access.external.pgadmin }}</a></li>
      {% if ctx.monitoring.enabled %}
      <li><strong>Grafana</strong> — <a href="{{ ctx.access.external.grafana }}">{{ ctx.access.external.grafana }}</a></li>
      {% endif %}
    </ul>
  </section>

  <section>
    <h2>From same VPC (private IP)</h2>
    <p class="sub">{{ ctx.access.vpc.audience }}</p>
    <ul>
      <li>Ops private IP: <code>{{ ctx.access.vpc.ops_ip }}</code></li>
      <li><strong>Portal</strong> — <a href="{{ ctx.access.vpc.portal }}">{{ ctx.access.vpc.portal }}</a></li>
      <li><strong>pgAdmin</strong> — <a href="{{ ctx.access.vpc.pgadmin }}">{{ ctx.access.vpc.pgadmin }}</a></li>
      {% if ctx.monitoring.enabled %}
      <li><strong>Grafana</strong> — <a href="{{ ctx.access.vpc.grafana }}">{{ ctx.access.vpc.grafana }}</a></li>
      {% endif %}
    </ul>
  </section>

  {% if ctx.caddy_vhosts.enabled %}
  <section>
    <h2>Lab domain (Caddy) — {{ ctx.caddy_vhosts.public_base }}</h2>
    <p class="sub">Mode <code>{{ ctx.caddy_vhosts.dns_mode }}</code> — public-IP hostnames for Jenkins/internet; private-IP hostnames when registered for in-VPC use.</p>
    <ul>
      <li><strong>Portal (public slug)</strong> — <a href="{{ ctx.caddy_vhosts.urls_public.portal.url }}">{{ ctx.caddy_vhosts.urls_public.portal.hostname }}</a></li>
      <li><strong>CM (public slug)</strong> — <a href="{{ ctx.caddy_vhosts.urls_public.cm.url }}">{{ ctx.caddy_vhosts.urls_public.cm.hostname }}</a></li>
      {% if ctx.caddy_vhosts.urls_vpc.portal is defined %}
      <li><strong>Portal (VPC slug)</strong> — <a href="{{ ctx.caddy_vhosts.urls_vpc.portal.url }}">{{ ctx.caddy_vhosts.urls_vpc.portal.hostname }}</a></li>
      {% endif %}
    </ul>
  </section>
  {% endif %}

  <section>
    <h2>Ops host (portal, pgAdmin, Grafana, Prometheus)</h2>
    <ul>
      <li>Host: <code>{{ ctx.ops_host.fqdn }}</code> <span class="badge">{{ ctx.ops_host.inventory_group }}</span></li>
      <li>{{ ctx.ops_host.services }}</li>
      <li><strong>Deployment index (Caddy)</strong> — <a href="{{ ctx.portal.index_url }}">{{ ctx.portal.index_url }}</a></li>
      <li><strong>pgAdmin</strong> — <a href="{{ ctx.portal.pgadmin_url }}">{{ ctx.portal.pgadmin_url }}</a> <span class="badge">connects to CM DB</span></li>
      {% if ctx.monitoring.enabled %}
      <li><strong>Grafana</strong> — <a href="{{ ctx.monitoring.grafana_url }}">{{ ctx.monitoring.grafana_url }}</a></li>
      <li><strong>Prometheus</strong> — <a href="{{ ctx.monitoring.prometheus_url }}">{{ ctx.monitoring.prometheus_url }}</a></li>
      {% endif %}
      {% if ctx.identity.ipa_ui_url %}
      <li><strong>{{ ctx.identity.ipa_ui_label }}</strong> — <a href="{{ ctx.identity.ipa_ui_url }}">{{ ctx.identity.ipa_ui_url }}</a></li>
      {% endif %}
      <li><strong>Cloudera Manager (HTTP)</strong> — <a href="{{ ctx.cloudera_manager.ui_url_http }}">{{ ctx.cloudera_manager.ui_url_http }}</a></li>
      <li><strong>Cloudera Manager (HTTPS)</strong> — <a href="{{ ctx.cloudera_manager.ui_url_https }}">{{ ctx.cloudera_manager.ui_url_https }}</a></li>
    </ul>
  </section>

  <section>
    <h2>PostgreSQL</h2>
    <ul>
      <li>Host: <code>{{ ctx.postgresql.host_fqdn }}</code></li>
      <li>Port: <code>{{ ctx.postgresql.port }}</code></li>
      <li>{{ ctx.postgresql.database_host_note }}</li>
    </ul>
  </section>

  <section>
    <h2>Clusters</h2>
    <ul>
      <li>CDH base cluster: <code>{{ ctx.cloudera_manager.cluster_name }}</code></li>
      {% if ctx.ecs.deployed %}
      <li>ECS cluster: <code>{{ ctx.ecs.cluster_name }}</code></li>
      <li>ECS app domain: <code>{{ ctx.ecs.app_domain }}</code></li>
      <li>ECS console (typical): <a href="{{ ctx.ecs.console_hint }}">{{ ctx.ecs.console_hint }}</a></li>
      <li>Data Services hostnames: <code>{{ ctx.ecs.apps_wildcard }}</code></li>
      {% else %}
      <li>ECS: <span class="badge">not in inventory</span></li>
      {% endif %}
    </ul>
    <p class="sub">Versions — CM {{ ctx.versions.cm }} · CDH {{ ctx.versions.cdh }} · CDS {{ ctx.versions.ecs_cds }}</p>
  </section>

  {% if ctx.data_services.links | length > 0 %}
  <section>
    <h2>Data services &amp; related URLs</h2>
    <ul>
      {% for link in ctx.data_services.links %}
      <li><strong>{{ link.name }}</strong>{% if link.description %} — {{ link.description }}{% endif %} — <a href="{{ link.url }}">{{ link.url }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if ctx.monitoring.enabled %}
  <section>
    <h2>Monitoring stack (on ops host)</h2>
    <ul>
      <li><strong>Grafana</strong> — <a href="{{ ctx.monitoring.grafana_url }}">{{ ctx.monitoring.grafana_url }}</a> <span class="badge">dashboards</span></li>
      <li><strong>Prometheus</strong> — <a href="{{ ctx.monitoring.prometheus_url }}">{{ ctx.monitoring.prometheus_url }}</a></li>
      <li><strong>Alertmanager</strong> — <a href="{{ ctx.monitoring.alertmanager_url }}">{{ ctx.monitoring.alertmanager_url }}</a></li>
      <li><strong>cAdvisor</strong> — <a href="{{ ctx.monitoring.cadvisor_url }}">{{ ctx.monitoring.cadvisor_url }}</a> <span class="badge">container metrics</span></li>
    </ul>
  </section>
  {% endif %}

  {% if ctx.extra_links | length > 0 %}
  <section>
    <h2>Additional links</h2>
    <ul>
      {% for link in ctx.extra_links %}
      <li><strong>{{ link.name }}</strong> — <a href="{{ link.url }}">{{ link.url }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section>
    <h2>Inventory nodes</h2>
    <table>
      <thead><tr><th>Group</th><th>Hostname</th><th>FQDN</th><th>IP</th></tr></thead>
      <tbody>
        {% for n in ctx.nodes %}
        <tr>
          <td>{{ n.group }}</td>
          <td>{{ n.hostname }}</td>
          <td>{{ n.fqdn }}</td>
          <td>{{ n.private_ip or n.ansible_host }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</body>
</html>
