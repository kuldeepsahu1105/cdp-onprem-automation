              <td><code>{{ h.fqdn }}</code></td>
              <td><code>{{ h.private_ip }}</code></td>
              <td>{% if h.public_ip | default('') | length > 0 and ('{{' not in (h.public_ip | string)) %}<code>{{ h.public_ip }}</code>{% else %}<span class="badge">VPC only</span>{% endif %}</td>
              <td>
                {% for gl in h.group_labels | default(h.groups | default([])) %}
                <span class="group-tag">{{ gl }}</span>
                {% endfor %}
              </td>
              <td>
                {% for role in h.role_labels | default([]) %}
                <span class="role-badge">{{ role }}</span>
                {% endfor %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}
  </main>
  <script>
  (function () {
    var POLL_MS = 60000;
    var initial = {{ ls | tojson }};
    var promPath = {{ ls_poll_prom | tojson }};

    function sumClusters(clusters, field) {
      var n = 0;
      (clusters || []).forEach(function (c) { n += (c[field] || 0) * 1; });
      return n;
    }

    function pillClass(health) {
      var h = (health || '').toUpperCase();
      if (h === 'GOOD') return 'good';
      if (h === 'CONCERNING') return 'concerning';
      if (h === 'BAD') return 'bad';
      return 'na';
    }

    function setText(id, val) {
      var el = document.getElementById(id);
      if (el) el.textContent = (val === undefined || val === null || val === '') ? '—' : String(val);
    }

    function applySnapshot(data) {
      if (!data) return;
      var hosts = data.hosts || {};
      var clusters = data.clusters || [];
      setText('kpi-services-good', sumClusters(clusters, 'services_started_good') || sumClusters(clusters, 'services_good'));
      setText('kpi-services-warn', sumClusters(clusters, 'services_concerning'));
      setText('kpi-services-bad', sumClusters(clusters, 'services_bad'));
      setText('kpi-parcels', (data.parcels || []).length);
      var updated = document.getElementById('live-stats-updated');
      if (updated && data.collected_at) {
        updated.textContent = 'CM snapshot ' + data.collected_at + (data.source === 'cm_api' ? '' : ' (inventory fallback)');
      }
      var hb = document.querySelector('[data-kpi-sub="hosts-heartbeat"]');
      if (hb && hosts.total !== undefined) {
        hb.textContent = (hosts.good !== undefined ? hosts.good + '/' + hosts.total + ' GOOD' : hosts.total + ' hosts');
      }
      var tbody = document.querySelector('#live-stats-services-table tbody');
      if (tbody && clusters.length) {
        var rows = '';
        clusters.forEach(function (cl) {
          (cl.services || []).forEach(function (svc) {
            rows += '<tr><td><code>' + cl.name + '</code></td><td>' + (svc.name || '') + '</td><td>' + (svc.type || '') +
              '</td><td>' + (svc.service_state || '') + '</td><td><span class="health-pill ' + pillClass(svc.health) + '">' +
              (svc.health || '—') + '</span></td></tr>';
          });
        });
        if (rows) tbody.innerHTML = rows;
      }
    }

    function pollSnapshot() {
      fetch('live-stats.json', { cache: 'no-store', credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(applySnapshot)
        .catch(function () {});
    }

    function pollPrometheus() {
      if (!promPath) return;
      var q = 'count(up==1)';
      fetch(promPath + '?query=' + encodeURIComponent(q), { cache: 'no-store', credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (body) {
          if (!body || body.status !== 'success') return;
          var val = body.data && body.data.result && body.data.result[0] && body.data.result[0].value;
          if (val && val.length > 1) setText('kpi-prom-up', val[1]);
        })
        .catch(function () {});
    }

    applySnapshot(initial);
    pollPrometheus();
    setInterval(function () { pollSnapshot(); pollPrometheus(); }, POLL_MS);
  })();
  </script>
</body>
</html>
