  <script>
  (function () {
    var authAction = document.getElementById('portal-auth-action');
    var authGate = document.getElementById('operator-auth-gate');
    var protectedContent = document.getElementById('operator-protected-content');
    var authMessage = document.getElementById('operator-auth-message');
    var inventoryKeyAction = document.getElementById('inventory-key-action');
    var inventoryKeyActionLabel = document.getElementById('inventory-key-action-label');
    var loggedOut = new URLSearchParams(window.location.search).has('logged_out');
    if (loggedOut) {
      window.history.replaceState({}, document.title, window.location.pathname + window.location.hash);
      if (authMessage) authMessage.innerHTML = '<strong>Logged out.</strong> Sign in again to view operator credentials and download private keys.';
    }
    var authenticated = false;

    function setAuthenticatedUi(isAuthenticated) {
      document.querySelectorAll('.auth-protected-download').forEach(function (element) {
        element.hidden = !isAuthenticated;
      });
      document.querySelectorAll('.auth-download-login').forEach(function (element) {
        element.hidden = isAuthenticated;
      });
      if (inventoryKeyAction && inventoryKeyActionLabel) {
        inventoryKeyAction.href = isAuthenticated ? inventoryKeyAction.dataset.downloadUrl : inventoryKeyAction.dataset.loginUrl;
        inventoryKeyActionLabel.textContent = isAuthenticated ? inventoryKeyAction.dataset.downloadLabel : 'Login to download key';
        inventoryKeyAction.title = isAuthenticated ? 'Download SSH private key' : 'Sign in to download the SSH private key';
        if (isAuthenticated) {
          inventoryKeyAction.setAttribute('download', inventoryKeyAction.dataset.downloadName);
        } else {
          inventoryKeyAction.removeAttribute('download');
        }
      }
      if (authAction) {
        authAction.textContent = isAuthenticated ? 'Logout' : 'Login';
        authAction.title = isAuthenticated ? 'Sign out of protected operator access' : 'Sign in to protected operator access';
        authAction.href = isAuthenticated ? '/logout' : authAction.dataset.loginUrl;
      }
    }

    function loadProtectedContent() {
      if (!authGate || !protectedContent || protectedContent.dataset.loaded === 'true') return;
      if (authMessage) authMessage.textContent = 'Loading authenticated Operator access...';
      fetch(authGate.dataset.contentUrl, { cache: 'no-store', credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok || response.redirected) {
            throw new Error('Operator access returned HTTP ' + response.status);
          }
          return response.text();
        })
        .then(function (html) {
          protectedContent.innerHTML = html;
          protectedContent.dataset.loaded = 'true';
          protectedContent.hidden = false;
          authGate.hidden = true;
          enhanceCopyButtons(protectedContent);
        })
        .catch(function () {
          authenticated = false;
          protectedContent.hidden = true;
          authGate.hidden = false;
          setAuthenticatedUi(false);
          if (authMessage) authMessage.innerHTML = '<strong>Login required.</strong> Your session is no longer valid. Sign in to view credentials and private keys.';
        });
    }

    function refreshAuthentication() {
      fetch('/api/session', { cache: 'no-store', credentials: 'same-origin' })
        .then(function (response) {
          authenticated = response.ok;
          setAuthenticatedUi(authenticated);
          if (authenticated) loadProtectedContent();
        })
        .catch(function () {
          authenticated = false;
          setAuthenticatedUi(false);
        });
    }

    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
      return new Promise(function (resolve, reject) {
        var input = document.createElement('textarea');
        input.value = text;
        input.setAttribute('readonly', '');
        input.style.position = 'fixed';
        input.style.opacity = '0';
        document.body.appendChild(input);
        input.select();
        try {
          if (!document.execCommand('copy')) throw new Error('copy command failed');
          resolve();
        } catch (error) {
          reject(error);
        } finally {
          input.remove();
        }
      });
    }

    function enhanceCopyButtons(root) {
      (root || document).querySelectorAll('.ssh-command-box > code, code.ssh-inline-cmd').forEach(function (code) {
        if (code.dataset.copyReady === 'true') return;
        code.dataset.copyReady = 'true';
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-command-btn';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy command');
        button.addEventListener('click', function () {
          copyText(code.textContent.trim()).then(function () {
            button.textContent = 'Copied';
            button.classList.add('is-copied');
            window.setTimeout(function () {
              button.textContent = 'Copy';
              button.classList.remove('is-copied');
            }, 1600);
          }).catch(function () {
            button.textContent = 'Select';
            var range = document.createRange();
            range.selectNodeContents(code);
            window.getSelection().removeAllRanges();
            window.getSelection().addRange(range);
          });
        });
        if (code.parentElement.classList.contains('ssh-command-box')) {
          code.parentElement.appendChild(button);
        } else {
          var wrap = document.createElement('span');
          wrap.className = 'copy-command-wrap';
          code.parentNode.insertBefore(wrap, code);
          wrap.appendChild(code);
          wrap.appendChild(button);
        }
      });
    }

    setAuthenticatedUi(false);
    enhanceCopyButtons(document);
    if (authAction) {
      authAction.dataset.loginUrl = authAction.dataset.loginUrl || '/login.html';
    }
    if (authAction || authGate) refreshAuthentication();

    var jumpTop = document.getElementById('page-jump-top');
    var jumpBottom = document.getElementById('page-jump-bottom');
    var scrollProgress = document.getElementById('scroll-progress');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var scrollBehavior = reduceMotion ? 'auto' : 'smooth';
    if (jumpTop) {
      jumpTop.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: scrollBehavior });
      });
    }
    if (jumpBottom) {
      jumpBottom.addEventListener('click', function () {
        window.scrollTo({ top: document.documentElement.scrollHeight, behavior: scrollBehavior });
      });
    }
    function updateScrollControls() {
      var maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      var progress = maxScroll ? Math.min(1, window.scrollY / maxScroll) : 1;
      if (scrollProgress) {
        scrollProgress.style.transform = 'scaleX(' + progress + ')';
        scrollProgress.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
      }
      if (jumpTop) jumpTop.disabled = window.scrollY <= 1;
      if (jumpBottom) jumpBottom.disabled = window.scrollY >= maxScroll - 1;
    }
    window.addEventListener('scroll', updateScrollControls, { passive: true });
    window.addEventListener('resize', updateScrollControls);
    updateScrollControls();

    var serviceFilter = document.getElementById('service-filter');
    var filterEmpty = document.getElementById('service-filter-empty');
    if (serviceFilter) {
      var serviceTiles = Array.prototype.slice.call(document.querySelectorAll('.quick-actions .tile'));
      serviceFilter.addEventListener('input', function () {
        var query = serviceFilter.value.trim().toLowerCase();
        var visible = 0;
        serviceTiles.forEach(function (tile) {
          var matches = !query || tile.textContent.toLowerCase().indexOf(query) !== -1;
          tile.hidden = !matches;
          if (matches) visible += 1;
        });
        if (filterEmpty) filterEmpty.hidden = visible !== 0;
      });
      serviceFilter.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && serviceFilter.value) {
          serviceFilter.value = '';
          serviceFilter.dispatchEvent(new Event('input'));
        }
      });
      document.addEventListener('keydown', function (event) {
        var target = event.target;
        var typing = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
        if (event.key === '/' && !typing) {
          event.preventDefault();
          serviceFilter.focus();
        }
      });
    }

    function setAllSections(open) {
      document.querySelectorAll('main > details.panel').forEach(function (panel) {
        panel.open = open;
      });
      updateSectionTools();
    }
    function updateSectionTools() {
      var panels = Array.prototype.slice.call(document.querySelectorAll('main > details.panel'));
      var allOpen = panels.length > 0 && panels.every(function (panel) { return panel.open; });
      var allClosed = panels.length > 0 && panels.every(function (panel) { return !panel.open; });
      if (expandSections) {
        expandSections.classList.toggle('is-active', allOpen);
        expandSections.setAttribute('aria-pressed', String(allOpen));
      }
      if (collapseSections) {
        collapseSections.classList.toggle('is-active', allClosed);
        collapseSections.setAttribute('aria-pressed', String(allClosed));
      }
    }
    var expandSections = document.getElementById('sections-expand');
    var collapseSections = document.getElementById('sections-collapse');
    if (expandSections) expandSections.addEventListener('click', function () { setAllSections(true); });
    if (collapseSections) collapseSections.addEventListener('click', function () { setAllSections(false); });
    document.querySelectorAll('main > details.panel').forEach(function (panel) {
      panel.addEventListener('toggle', updateSectionTools);
    });
    updateSectionTools();

    var helpDlg = document.getElementById('portal-help-dialog');
    var helpOpen = document.getElementById('portal-help-open');
    var helpClose = document.getElementById('portal-help-close');
    if (helpDlg && helpOpen) {
      helpOpen.addEventListener('click', function () { if (helpDlg.showModal) helpDlg.showModal(); });
    }
    if (helpDlg && helpClose) {
      helpClose.addEventListener('click', function () { helpDlg.close(); });
    }
  })();
  (function () {
    var POLL_MS = 60000;
    var initial = {{ ls | tojson }};
    var promPath = {{ ls_poll_prom | tojson }};

    function sumClusters(clusters, field) {
      var n = 0;
      (clusters || []).forEach(function (c) { n += (c[field] || 0) * 1; });
      return n;
    }

    function pillClass(health) {
      var h = (health || '').toUpperCase();
      if (h === 'GOOD') return 'good';
      if (h === 'CONCERNING') return 'concerning';
      if (h === 'BAD') return 'bad';
      return 'na';
    }

    function setText(id, val) {
      var el = document.getElementById(id);
      if (el) el.textContent = (val === undefined || val === null || val === '') ? '—' : String(val);
    }

    function applySnapshot(data) {
      if (!data) return;
      var hosts = data.hosts || {};
      var clusters = data.clusters || [];
      setText('kpi-services-good', sumClusters(clusters, 'services_started_good') || sumClusters(clusters, 'services_good'));
      setText('kpi-services-warn', sumClusters(clusters, 'services_concerning'));
      setText('kpi-services-bad', sumClusters(clusters, 'services_bad'));
      setText('kpi-parcels', (data.parcels || []).length);
      var updated = document.getElementById('live-stats-updated');
      if (updated && data.collected_at) {
        updated.textContent = 'CM snapshot ' + data.collected_at + (data.source === 'cm_api' ? '' : ' (inventory fallback)');
      }
      var hb = document.querySelector('[data-kpi-sub="hosts-heartbeat"]');
      if (hb && hosts.total !== undefined) {
        hb.textContent = (hosts.good !== undefined ? hosts.good + '/' + hosts.total + ' GOOD' : hosts.total + ' hosts');
      }
      var tbody = document.querySelector('#live-stats-services-table tbody');
      if (tbody && clusters.length) {
        var rows = '';
        clusters.forEach(function (cl) {
          (cl.services || []).forEach(function (svc) {
            rows += '<tr><td><code>' + cl.name + '</code></td><td>' + (svc.name || '') + '</td><td>' + (svc.type || '') +
              '</td><td>' + (svc.service_state || '') + '</td><td><span class="health-pill ' + pillClass(svc.health) + '">' +
              (svc.health || '—') + '</span></td></tr>';
          });
        });
        if (rows) tbody.innerHTML = rows;
      }
    }

    function pollSnapshot() {
      fetch('live-stats.json', { cache: 'no-store', credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(applySnapshot)
        .catch(function () {});
    }

    function pollPrometheus() {
      if (!promPath) return;
      var q = 'count(up==1)';
      fetch(promPath + '?query=' + encodeURIComponent(q), { cache: 'no-store', credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (body) {
          if (!body || body.status !== 'success') return;
          var val = body.data && body.data.result && body.data.result[0] && body.data.result[0].value;
          if (val && val.length > 1) setText('kpi-prom-up', val[1]);
        })
        .catch(function () {});
    }

    applySnapshot(initial);
    pollPrometheus();
    setInterval(function () { pollSnapshot(); pollPrometheus(); }, POLL_MS);
  })();
  </script>
</body>
</html>
