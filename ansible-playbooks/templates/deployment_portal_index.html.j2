{% set ctx = deployment_portal_context %}
{% set cm_tile_url = ctx.cloudera_manager.ui_url_https %}
{% set pgadmin_tile_url = ctx.portal.pgadmin_caddy_url | default('') if (ctx.portal.pgadmin_caddy_url | default('') | length > 0) else (ctx.portal.pgadmin_url_direct | default(ctx.portal.pgadmin_url | default(''))) %}
{% set ipa_modern_url = ctx.identity.ipa_caddy_modern_url | default('') if (ctx.identity.ipa_caddy_modern_url | default('') | length > 0) else (ctx.identity.ipa_caddy_url | default('')) %}
{% set ipa_legacy_caddy_url = ctx.identity.ipa_caddy_legacy_url | default('') %}
{% set ipa_tile_url = ipa_modern_url if (ipa_modern_url | length > 0) else (ctx.identity.ipa_ui_url | default('')) %}
{% set ecs_tile_url = ctx.ecs.console_hint | default('') if ctx.ecs.deployed else '' %}
{% set _portal_caddy_url = ctx.caddy_vhosts.urls_public.portal.url | default('') if (ctx.caddy_vhosts.enabled | default(false)) else '' %}
{% set portal_tile_url = _portal_caddy_url if (_portal_caddy_url | length > 0) else ctx.portal.index_url | default('') %}
{% set portal_tile_hint = ctx.caddy_vhosts.urls_public.portal.hostname if (_portal_caddy_url | length > 0) else 'Ops host Caddy index' %}
{% set _caddy_vhosts_on = ctx.caddy_vhosts.enabled | default(false) | bool %}
{% from 'deployment_portal_url_fqdn_pubip.inc.j2' import portal_jdbc_for_context, portal_url_bundle, portal_url_for_context, portal_url_fqdn_pubip_cm with context %}
{% set mon_on = (
  (ctx.monitoring.enabled | default(false) | bool)
  or (ctx.monitoring.routes_enabled | default(false) | bool)
  or (deployment_portal_monitoring_routes_enabled | default(false) | bool)
  or (deployment_portal_monitoring_deployed | default(false) | bool)
  or (monitoring_stack_enabled | default(false) | bool)
) %}
{% set grafana_tile_url = ctx.monitoring.grafana_caddy_url | default('') if (ctx.monitoring.grafana_caddy_url | default('') | length > 0) else (ctx.monitoring.grafana_url | default(ctx.monitoring.grafana_path_url | default(''))) %}
{% set prometheus_tile_url = ctx.monitoring.prometheus_caddy_url | default('') if (ctx.monitoring.prometheus_caddy_url | default('') | length > 0) else (ctx.monitoring.prometheus_url | default(ctx.monitoring.prometheus_path_url | default(''))) %}
{% set alertmanager_tile_url = ctx.monitoring.alertmanager_caddy_url | default('') if (ctx.monitoring.alertmanager_caddy_url | default('') | length > 0) else (ctx.monitoring.alertmanager_url | default(ctx.monitoring.alertmanager_path_url | default(''))) %}
{% set cadvisor_tile_url = ctx.monitoring.cadvisor_caddy_url | default('') if (ctx.monitoring.cadvisor_caddy_url | default('') | length > 0) else (ctx.monitoring.cadvisor_url | default(ctx.monitoring.cadvisor_path_url | default(''))) %}
{% if mon_on and (grafana_tile_url | length == 0) %}
{% set grafana_tile_url = ctx.monitoring.grafana_path_url | default(ctx.access.external.grafana | default(ctx.access.primary.grafana | default(''))) %}
{% endif %}
{% if mon_on and (prometheus_tile_url | length == 0) %}
{% set prometheus_tile_url = ctx.monitoring.prometheus_path_url | default(ctx.access.external.prometheus | default(ctx.access.primary.prometheus | default(''))) %}
{% endif %}
{% if mon_on and (alertmanager_tile_url | length == 0) %}
{% set alertmanager_tile_url = ctx.monitoring.alertmanager_path_url | default(ctx.access.external.alertmanager | default(ctx.access.primary.alertmanager | default(''))) %}
{% endif %}
{% if mon_on and (cadvisor_tile_url | length == 0) %}
{% set cadvisor_tile_url = ctx.monitoring.cadvisor_path_url | default(ctx.access.external.cadvisor | default(ctx.access.primary.cadvisor | default(''))) %}
{% endif %}
{% set panel_chevron %}<span class="panel-chevron" aria-hidden="true"><svg class="chevron-icon" viewBox="0 0 16 16" width="14" height="14" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endset %}
{% set ls = ctx.live_stats | default({}) %}
{% set ls_poll_prom = ls.poll.prometheus_query_path | default('') if ls.poll is defined else '' %}
{% set oa = ctx.operator_access | default({}) %}
{% from 'deployment_portal_ssh_command.inc.j2' import portal_ssh_ec2_key_basename %}
{% set ssh_key_filename = oa.ssh_connect_key_filename | default(portal_ssh_ec2_key_basename(), true) %}
{% set _ssh_keys_ui_on = oa.ssh_keys_exposed | default(deployment_portal_ssh_keys_expose_effective | default(false)) | bool %}
{% set _dl_prefix = oa.downloads_path_prefix | default('/downloads') %}
{% set ns_ssh_dl = namespace(items=[]) %}
{% for sec in oa.sections | default([]) %}
{% if sec.id | default('') == 'ssh' %}
{% set ns_ssh_dl.items = sec.downloads | default([]) %}
{% endif %}
{% endfor %}
{% if _ssh_keys_ui_on and (ns_ssh_dl.items | length == 0) %}
{% for ek in deployment_portal_ssh_export_keys | default([]) %}
{% set ns_ssh_dl.items = ns_ssh_dl.items + [{'label': ek.label, 'href': _dl_prefix ~ '/ssh/' ~ ek.basename, 'filename': ek.basename, 'note': 'chmod 400 after download'}] %}
{% endfor %}
{% endif %}
{% set ns_ls = namespace(sgood=0, swarn=0, sbad=0) %}
{% for cl in ls.clusters | default([]) %}
{% set ns_ls.sgood = ns_ls.sgood + (cl.services_started_good | default(0) | int) %}
{% set ns_ls.swarn = ns_ls.swarn + (cl.services_concerning | default(0) | int) %}
{% set ns_ls.sbad = ns_ls.sbad + (cl.services_bad | default(0) | int) %}
{% endfor %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>CDP Deployment Portal — {{ ctx.cluster_domain }}</title>
  <link rel="icon" href="/favicon.ico" sizes="any"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
  <style>
    [hidden] { display: none !important; }
    :root {
      --bg: #0c1017;
      --bg-elevated: #121926;
      --card: #1a2332;
      --text: #e8edf4;
      --muted: #94a3b8;
      --accent: #f96702;
      --accent-soft: #5b9fd4;
      --cyan: #42c7c7;
      --green: #45c98a;
      --purple: #a78bfa;
      --gold: #f2b84b;
      --rose: #fb7185;
      --border: #2d3a4d;
      --tile-hover: #243044;
      --max-w: 1280px;
      --table-min-w: 1200px;
      --radius: 10px;
    }
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      background:
        radial-gradient(circle at 8% 4%, rgba(66, 199, 199, 0.06), transparent 24rem),
        radial-gradient(circle at 92% 10%, rgba(167, 139, 250, 0.055), transparent 27rem),
        var(--bg);
      color: var(--text);
      margin: 0;
      padding: 0;
      line-height: 1.55;
    }
    :focus-visible {
      outline: 2px solid var(--accent-soft);
      outline-offset: 2px;
    }
    a { color: #7ec8ff; text-decoration: none; }
    a:hover { text-decoration: underline; }
    code {
      background: #0b1018;
      padding: 0.12rem 0.4rem;
      border-radius: 4px;
      font-size: 0.85em;
      word-break: break-all;
    }
    .url-alternative {
      display: inline-block;
      color: var(--muted);
      margin-left: 0.2rem;
    }
    .monitoring-url .url-alternative {
      display: block;
      margin: 0.22rem 0 0;
    }
    .site-header {
      background: linear-gradient(135deg, #1a2332 0%, #0f1419 55%, #1a1208 100%);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem 1.25rem;
    }
    .site-header-inner {
      max-width: var(--max-w);
      margin: 0 auto;
    }
    .brand-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .brand-mark {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
    }
    .brand-mark img { display: block; width: 100%; height: 100%; object-fit: contain; }
    h1 {
      font-size: 1.35rem;
      font-weight: 650;
      margin: 0;
      letter-spacing: -0.02em;
    }
    .brand-tag {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      font-weight: 600;
    }
    .brand-subtitle {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem;
      margin-top: 0.35rem;
    }
    .label-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      vertical-align: middle;
    }
    .label-badge .label-badge-key {
      color: var(--muted);
      font-weight: 600;
    }
    .label-badge-owner {
      background: rgba(91, 159, 212, 0.12);
      border: 1px solid rgba(91, 159, 212, 0.35);
      color: #b8d4f0;
    }
    .label-badge-deployment {
      background: rgba(46, 160, 120, 0.12);
      border: 1px solid rgba(46, 160, 120, 0.35);
      color: #a8e6c8;
    }
    .label-badge-prefix {
      background: rgba(180, 150, 90, 0.12);
      border: 1px solid rgba(180, 150, 90, 0.4);
      color: #e8d4a8;
    }
    .label-badge-beta {
      background: rgba(249, 103, 2, 0.15);
      border: 1px solid rgba(249, 103, 2, 0.45);
      color: #ffc89a;
    }
    .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.85rem;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.2rem 0.65rem;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .chip strong { color: var(--text); font-weight: 600; margin-right: 0.25rem; }
    .wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1.25rem 1rem 2rem;
    }
    .sub {
      color: var(--muted);
      font-size: 0.88rem;
      margin: 0 0 0.75rem;
    }
    h2.section-title {
      font-size: 0.95rem;
      margin: 0;
      color: var(--accent-soft);
      font-weight: 600;
    }
    .quick-actions {
      margin-bottom: 1.25rem;
    }
    .quick-actions h2 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin: 0 0 0.65rem;
      font-weight: 600;
    }
    .quick-actions-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.65rem;
    }
    .quick-actions-head h2 { margin: 0; }
    .service-filter {
      width: min(100%, 16rem);
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg-elevated);
      color: var(--text);
      padding: 0.4rem 0.65rem;
      font: inherit;
      font-size: 0.78rem;
    }
    .service-filter::placeholder { color: var(--muted); }
    .filter-empty {
      color: var(--muted);
      font-size: 0.8rem;
      margin: 0.65rem 0 0;
    }
    .version-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin: 0 0 1.25rem;
    }
    .version-strip .chip:nth-child(1) {
      background: rgba(249, 103, 2, 0.09);
      border-color: rgba(249, 103, 2, 0.3);
    }
    .version-strip .chip:nth-child(2) {
      background: rgba(66, 199, 199, 0.08);
      border-color: rgba(66, 199, 199, 0.28);
    }
    .version-strip .chip:nth-child(3) {
      background: rgba(167, 139, 250, 0.08);
      border-color: rgba(167, 139, 250, 0.28);
    }
    .tile-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
      grid-auto-rows: 1fr;
      gap: 0.65rem;
      align-items: stretch;
    }
    a.tile {
      --tile-color: var(--accent-soft);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.2rem;
      background: var(--card);
      background:
        linear-gradient(145deg, color-mix(in srgb, var(--tile-color) 8%, transparent), transparent 58%),
        var(--card);
      border: 1px solid var(--border);
      border-top-color: color-mix(in srgb, var(--tile-color) 58%, var(--border));
      border-radius: var(--radius);
      padding: 0.9rem 0.95rem;
      color: var(--text);
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
      min-height: 6.5rem;
      min-width: 10.5rem;
      height: 100%;
    }
    a.tile:hover {
      background:
        linear-gradient(145deg, color-mix(in srgb, var(--tile-color) 14%, transparent), transparent 65%),
        var(--tile-hover);
      border-color: color-mix(in srgb, var(--tile-color) 55%, #3d4f66);
      text-decoration: none;
    }
    a.tile .tile-label {
      font-weight: 650;
      font-size: 0.95rem;
    }
    a.tile .tile-hint {
      font-size: 0.72rem;
      color: var(--muted);
      line-height: 1.35;
    }
    a.tile.tile-accent {
      border-color: rgba(249, 103, 2, 0.35);
    }
    a.tile.tile-orange { --tile-color: var(--accent); }
    a.tile.tile-cyan { --tile-color: var(--cyan); }
    a.tile.tile-green { --tile-color: var(--green); }
    a.tile.tile-purple { --tile-color: var(--purple); }
    a.tile.tile-gold { --tile-color: var(--gold); }
    a.tile.tile-rose { --tile-color: var(--rose); }
    details.panel {
      --panel-accent: var(--accent-soft);
      background: var(--card);
      border: 1px solid var(--border);
      border-left: 2px solid color-mix(in srgb, var(--panel-accent) 55%, var(--border));
      border-radius: var(--radius);
      margin-bottom: 0.75rem;
      overflow: hidden;
    }
    main > details.panel:nth-of-type(4n + 1) { --panel-accent: var(--cyan); }
    main > details.panel:nth-of-type(4n + 2) { --panel-accent: var(--purple); }
    main > details.panel:nth-of-type(4n + 3) { --panel-accent: var(--green); }
    main > details.panel:nth-of-type(4n + 4) { --panel-accent: var(--gold); }
    details.panel[open] {
      box-shadow: 0 6px 22px color-mix(in srgb, var(--panel-accent) 6%, transparent);
    }
    details.panel > summary {
      cursor: pointer;
      padding: 0.85rem 1rem;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      user-select: none;
    }
    details.panel > summary::-webkit-details-marker { display: none; }
    details.panel > summary::marker { content: none; display: none; }
    details.panel > summary .summary-main {
      flex: 1;
      min-width: 0;
    }
    details.panel > summary .panel-chevron {
      flex-shrink: 0;
      color: var(--muted);
      line-height: 1;
      transition: transform 0.15s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    details.panel > summary .panel-chevron .chevron-icon { display: block; }
    details.panel[open] > summary .panel-chevron { transform: rotate(90deg); }
    details.panel > summary:hover { background: rgba(255, 255, 255, 0.03); }
    details.panel > summary .section-title {
      color: color-mix(in srgb, var(--panel-accent) 82%, white);
    }
    .panel-body {
      padding: 0 1rem 1rem;
      border-top: 1px solid var(--border);
    }
    section.flat {
      background: var(--card);
      background:
        linear-gradient(145deg, rgba(66, 199, 199, 0.045), transparent 48%),
        var(--card);
      border: 1px solid var(--border);
      border-left: 2px solid rgba(66, 199, 199, 0.5);
      border-radius: var(--radius);
      padding: 1rem 1.1rem;
      margin-bottom: 0.75rem;
    }
    section.flat h2 {
      font-size: 0.95rem;
      margin: 0 0 0.75rem;
      color: var(--accent-soft);
      font-weight: 600;
    }
    ul.clean {
      margin: 0;
      padding-left: 1.15rem;
    }
    ul.clean li { margin: 0.4rem 0; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    table.portal-table {
      width: 100%;
      min-width: var(--table-min-w);
      table-layout: fixed;
    }
    table.portal-table.inventory-table {
      min-width: 0;
      width: 100%;
      table-layout: auto;
    }
    th, td {
      text-align: left;
      padding: 0.45rem 0.55rem;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    th { color: var(--muted); font-weight: 600; }
    .table-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      width: 100%;
      max-width: 100%;
    }
    table.inventory-table th:nth-child(1),
    table.inventory-table td:nth-child(1) { width: 9rem; max-width: 11rem; }
    table.inventory-table th:nth-child(2),
    table.inventory-table td:nth-child(2) { width: 12rem; max-width: 16rem; }
    table.inventory-table th:nth-child(3),
    table.inventory-table td:nth-child(3) { width: 7.5rem; }
    table.inventory-table th:nth-child(4),
    table.inventory-table td:nth-child(4) { width: 7.5rem; }
    table.inventory-table th:nth-child(5),
    table.inventory-table td:nth-child(5) { width: 10rem; max-width: 14rem; }
    table.inventory-table th:nth-child(6),
    table.inventory-table td:nth-child(6) { width: auto; min-width: 8rem; }
    table.inventory-table th:nth-child(7),
    table.inventory-table td:nth-child(7) { width: auto; min-width: 10rem; max-width: 22rem; }
    table.inventory-table th:nth-child(8),
    table.inventory-table td:nth-child(8) {
      width: auto;
      min-width: 9rem;
      max-width: 14rem;
      white-space: normal;
      vertical-align: top;
    }
    table.inventory-table td:nth-child(7) code.ssh-inline-cmd {
      font-size: 0.72em;
      line-height: 1.35;
    }
    table.inventory-table tbody {
      height: auto;
      min-height: 0;
    }
    table.inventory-table td:nth-child(1),
    table.inventory-table td:nth-child(3),
    table.inventory-table td:nth-child(4) {
      white-space: nowrap;
    }
    table.inventory-table td:nth-child(2) code {
      display: inline-block;
      max-width: 100%;
      word-break: break-all;
      white-space: normal;
      overflow-wrap: anywhere;
      font-size: 0.78em;
      line-height: 1.35;
    }
    table.inventory-table td:nth-child(3) code,
    table.inventory-table td:nth-child(4) code {
      word-break: keep-all;
      white-space: nowrap;
      font-size: 0.78em;
    }
    table.inventory-table td:nth-child(6) .role-badge {
      white-space: normal;
      max-width: 100%;
    }
    .inventory-section-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem 1rem;
      margin-bottom: 0.65rem;
    }
    .inventory-section-head h2 {
      margin: 0;
      font-size: 0.95rem;
      color: var(--accent-soft);
      font-weight: 600;
    }
    .inventory-dl-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.4rem;
      max-width: min(100%, 20rem);
    }
    a.dl-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      background: rgba(249, 103, 2, 0.12);
      border: 1px solid rgba(249, 103, 2, 0.45);
      border-radius: 6px;
      padding: 0.35rem 0.7rem;
      white-space: normal;
      text-align: left;
      line-height: 1.3;
    }
    a.dl-btn:hover {
      background: rgba(249, 103, 2, 0.22);
      text-decoration: none;
    }
    a.dl-btn svg { width: 0.95rem; height: 0.95rem; flex-shrink: 0; fill: currentColor; }
    .inventory-dl-hint {
      font-size: 0.72rem;
      color: var(--muted);
      margin: -0.35rem 0 0.65rem;
    }
    a.dl-link-inline {
      font-weight: 600;
      white-space: normal;
      line-height: 1.35;
      font-size: 0.78rem;
    }
    .inventory-pem-links {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
      min-width: 9rem;
      max-width: 14rem;
    }
    table.cred-table th:nth-child(1) { width: 14%; }
    table.cred-table th:nth-child(2) { width: 12%; }
    table.cred-table th:nth-child(3) { width: 22%; }
    table.cred-table th:nth-child(4) { width: 32%; }
    table.cred-table th:nth-child(5) { width: 20%; }
    table.cred-table td:nth-child(4) a,
    table.cred-table td:nth-child(4) code {
      word-break: break-all;
    }
    .badge {
      display: inline-block;
      background: #243044;
      color: var(--muted);
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      font-size: 0.72rem;
      margin-left: 0.3rem;
      vertical-align: middle;
    }
    .role-badge {
      display: inline-block;
      background: rgba(91, 159, 212, 0.15);
      border: 1px solid rgba(91, 159, 212, 0.35);
      color: #b8d4f0;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      font-size: 0.7rem;
      margin: 0.12rem 0.2rem 0.12rem 0;
      white-space: nowrap;
    }
    .group-tag {
      display: inline-block;
      font-size: 0.72rem;
      color: var(--muted);
      margin-right: 0.35rem;
    }
    .live-stats { margin-bottom: 1.25rem; }
    .live-stats-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.65rem;
    }
    .live-stats-head h2 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin: 0;
      font-weight: 600;
    }
    .live-stats-updated {
      font-size: 0.72rem;
      color: var(--muted);
    }
    .kpi-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }
    .kpi {
      flex: 1 1 7.5rem;
      min-width: 7rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.65rem 0.75rem;
    }
    .kpi .kpi-label {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
    }
    .kpi .kpi-val {
      font-size: 1.45rem;
      font-weight: 700;
      margin-top: 0.1rem;
      line-height: 1.15;
    }
    .kpi .kpi-sub {
      font-size: 0.68rem;
      color: var(--muted);
      margin-top: 0.15rem;
    }
    .kpi.kpi-pass .kpi-val { color: #4ade80; }
    .kpi.kpi-warn .kpi-val { color: #fbbf24; }
    .kpi.kpi-fail .kpi-val { color: #f87171; }
    .kpi.kpi-accent .kpi-val { color: var(--accent); }
    .kpi.kpi-info .kpi-val { color: var(--accent-soft); }
    .live-note {
      font-size: 0.78rem;
      color: var(--muted);
      margin: 0.65rem 0 0;
      line-height: 1.45;
    }
    .health-pill {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 600;
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .health-pill.good { background: rgba(74, 222, 128, 0.15); color: #4ade80; }
    .health-pill.concerning { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }
    .health-pill.bad { background: rgba(248, 113, 113, 0.15); color: #f87171; }
    .health-pill.na { background: #243044; color: var(--muted); }
    .cred-table td code.cred-secret {
      font-size: 0.8rem;
      user-select: all;
    }
    .cred-dl-list { margin: 0.5rem 0 0; padding-left: 1.15rem; }
    .operator-warning {
      font-size: 0.78rem;
      color: #fbbf24;
      border: 1px solid rgba(251, 191, 36, 0.35);
      background: rgba(251, 191, 36, 0.08);
      border-radius: 6px;
      padding: 0.55rem 0.75rem;
      margin: 0 0 0.75rem;
    }
    .auth-gate {
      border: 1px solid rgba(91, 159, 212, 0.35);
      background: rgba(91, 159, 212, 0.08);
      border-radius: 8px;
      padding: 1rem;
    }
    .auth-gate p { margin: 0 0 0.7rem; }
    .auth-gate .help-open-btn {
      display: inline-flex;
      text-decoration: none;
      background: rgba(91, 159, 212, 0.14);
      border-color: rgba(91, 159, 212, 0.45);
    }
    .operator-protected > .section-title:first-of-type { margin-top: 0.75rem; }
    .site-footer {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1.25rem 6.5rem 4.25rem 1rem;
      border-top: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--muted);
      line-height: 1.5;
    }
    .site-footer strong { color: var(--text); font-weight: 600; }
    .site-footer .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      margin-top: 0.45rem;
    }
    .site-footer .footer-links a { font-size: 0.8rem; }
    .icon-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--muted);
      text-decoration: none;
    }
    .icon-link:hover { color: var(--text); text-decoration: none; }
    .icon-link svg { width: 1rem; height: 1rem; flex-shrink: 0; fill: currentColor; }
    .header-actions {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .help-open-btn {
      font: inherit;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 6px;
      padding: 0.35rem 0.65rem;
      font-size: 0.78rem;
      font-weight: 600;
    }
    .help-open-btn:hover { background: rgba(255, 255, 255, 0.1); }
    .scroll-progress {
      position: fixed;
      inset: 0 0 auto;
      z-index: 50;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--gold), var(--cyan), var(--purple));
      transform: scaleX(0);
      transform-origin: left;
      pointer-events: none;
    }
    .section-tools {
      display: flex;
      justify-content: flex-end;
      gap: 0.45rem;
      margin: -0.35rem 0 0.75rem;
    }
    .section-tool-btn {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      font-size: 0.75rem;
      padding: 0.3rem 0.6rem;
    }
    .section-tool-btn:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.06);
    }
    .section-tool-btn:not(.is-active) { opacity: 0.55; }
    .section-tool-btn.is-active {
      color: #fff;
      background: rgba(249, 103, 2, 0.2);
      border-color: rgba(249, 103, 2, 0.7);
      box-shadow: 0 0 0 1px rgba(249, 103, 2, 0.15);
    }
    .page-jump {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 20;
      display: flex;
      gap: 0.4rem;
    }
    .page-jump button {
      width: 2.35rem;
      height: 2.35rem;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: var(--card);
      color: var(--text);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
      cursor: pointer;
      font: inherit;
      font-size: 1rem;
    }
    .page-jump button:hover { background: var(--tile-hover); }
    .page-jump button:disabled {
      opacity: 0.35;
      cursor: default;
    }
    dialog.help-dialog {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--card);
      color: var(--text);
      max-width: 36rem;
      width: calc(100% - 2rem);
      padding: 0;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    }
    dialog.help-dialog::backdrop { background: rgba(0, 0, 0, 0.55); }
    .help-dialog-inner { padding: 1rem 1.1rem 1.1rem; }
    .help-dialog-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.85rem 1.1rem;
      border-bottom: 1px solid var(--border);
    }
    .help-dialog-head h2 { margin: 0; font-size: 1rem; color: var(--accent-soft); }
    .help-close-btn {
      font: inherit;
      cursor: pointer;
      background: transparent;
      border: 1px solid var(--border);
      color: var(--muted);
      border-radius: 4px;
      padding: 0.2rem 0.5rem;
      font-size: 0.75rem;
    }
    .ssh-command-box {
      position: relative;
      background: #0b1018;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.55rem 3.8rem 0.55rem 0.75rem;
      margin: 0.5rem 0 0.75rem;
      font-size: 0.82rem;
      overflow-x: auto;
    }
    .ssh-command-box code { background: transparent; padding: 0; word-break: normal; white-space: pre-wrap; }
    code.ssh-inline-cmd { display: block; white-space: pre-wrap; word-break: break-all; font-size: 0.8em; }
    .copy-command-wrap {
      display: flex;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .copy-command-wrap code { flex: 1; min-width: 0; }
    .copy-command-btn {
      flex-shrink: 0;
      border: 1px solid rgba(66, 199, 199, 0.38);
      border-radius: 5px;
      background: rgba(66, 199, 199, 0.1);
      color: #a8eeee;
      cursor: pointer;
      font: inherit;
      font-size: 0.68rem;
      font-weight: 650;
      padding: 0.22rem 0.45rem;
    }
    .ssh-command-box > .copy-command-btn {
      position: absolute;
      right: 0.45rem;
      top: 0.42rem;
    }
    .copy-command-btn:hover { background: rgba(66, 199, 199, 0.2); }
    .copy-command-btn.is-copied {
      color: #b7f7d4;
      border-color: rgba(69, 201, 138, 0.5);
      background: rgba(69, 201, 138, 0.14);
    }
    .owner-social { display: inline-flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
    @media (max-width: 480px) {
      .site-header { padding: 0.85rem 1rem; }
      h1 { font-size: 1.15rem; }
      .wrap { padding: 1rem 0.75rem 1.5rem; }
      .tile-grid { grid-template-columns: repeat(2, 1fr); }
      .quick-actions-head { align-items: stretch; flex-direction: column; }
      .service-filter { width: 100%; }
      .site-footer { padding-right: 5.75rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; }
    }
  </style>
</head>
<body>
  <div class="scroll-progress" id="scroll-progress" role="progressbar" aria-label="Page scroll progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
  <header class="site-header">
    <div class="site-header-inner">
      <div class="brand-row">
        <div class="brand-mark" aria-hidden="true">
          <img src="/favicon-32x32.png" alt="" width="40" height="40"/>
        </div>
        <div>
          <div class="brand-tag">Cloudera Data Platform</div>
          <h1>Deployment portal</h1>
          <div class="brand-subtitle" aria-label="Portal metadata">
            <span class="label-badge label-badge-owner">
              <span class="label-badge-key">Portal developed by:</span>
              <span class="owner-social">
                {{ ctx.deployment.portal_owner_display | default('Kuldeep Sahu') }}
                <a class="icon-link" href="https://github.com/kuldeepsahu1105" target="_blank" rel="noopener noreferrer" title="GitHub — kuldeepsahu1105" aria-label="GitHub">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                </a>
                <a class="icon-link" href="https://www.linkedin.com/in/kuldeep-sahu-0511" target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="LinkedIn">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 00.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg>
                </a>
                <a class="icon-link" href="mailto:ksahu@cloudera.com" title="Email ksahu@cloudera.com" aria-label="Email">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 4a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H2a2 2 0 01-2-2V4zm2-1a1 1 0 00-1 1v.217l7 4.2 7-4.2V4a1 1 0 00-1-1H2zm13 2.383l-4.708 2.825L15 11.105V5.383zm-.034 6.876l-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 002 13h12a1 1 0 00.966-.741zM1 11.105l4.708-2.897L1 5.383v5.722z"/></svg>
                </a>
              </span>
            </span>
            {% if ctx.deployment.owner | default('') | length > 0 %}
            <span class="label-badge label-badge-deployment"><span class="label-badge-key">Deployment owner:</span> {{ ctx.deployment.owner }}</span>
            {% endif %}
            {% if ctx.deployment.name_prefix | default('') | length > 0 %}
            <span class="label-badge label-badge-prefix" title="Terraform/Jenkins environment — resource name prefix"><span class="label-badge-key">Deployment name (prefix):</span> {{ ctx.deployment.name_prefix }}</span>
            {% endif %}
            <span class="label-badge label-badge-beta"><span class="label-badge-key">Automation</span> beta version</span>
          </div>
        </div>
        <div class="header-actions">
          {% if oa.basic_auth_enabled | default(deployment_portal_basic_auth_enabled | default(false)) | bool %}
          <a class="help-open-btn" id="portal-auth-action" href="/login.html" data-login-url="/login.html" title="Sign in to protected downloads">Login</a>
          {% endif %}
          <button type="button" class="help-open-btn" id="portal-help-open" aria-haspopup="dialog">Help</button>
        </div>
      </div>
      <div class="meta-row">
        <span class="chip"><strong>Domain</strong> {{ ctx.cluster_domain }}</span>
        <span class="chip"><strong>Realm</strong> {{ ctx.cluster_realm }}</span>
        <span class="chip"><strong>Identity</strong> {{ ctx.identity_provider }}</span>
        <span class="chip"><strong>Access</strong> {{ ctx.access.profile }} ({{ ctx.access.environment }})</span>
        <span class="chip"><strong>Generated</strong> {{ ctx.generated_at }}</span>
      </div>
    </div>
  </header>

  <main class="wrap">
    <nav class="quick-actions" aria-label="Primary services">
      <div class="quick-actions-head">
        <h2>Quick open</h2>
        <input class="service-filter" id="service-filter" type="search" placeholder="Filter services..." aria-label="Filter quick-open services" autocomplete="off"/>
      </div>
      <div class="tile-grid">
        {% if cm_tile_url | length > 0 %}
        <a class="tile tile-accent tile-orange" href="{{ cm_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Cloudera Manager</span>
          <span class="tile-hint">Cluster admin UI</span>
        </a>
        {% endif %}
        {% if ctx.portal.pgadmin_url | default(pgadmin_tile_url | default('')) | length > 0 %}
        <a class="tile tile-cyan" href="{{ ctx.portal.pgadmin_url | default(pgadmin_tile_url) }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">pgAdmin</span>
          <span class="tile-hint">CM PostgreSQL{% if ctx.portal.pgadmin_caddy_url | default('') | length > 0 %} (Caddy){% endif %}</span>
        </a>
        {% endif %}
        {% if mon_on %}
        <a class="tile tile-purple" href="{{ grafana_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Grafana</span>
          <span class="tile-hint">{% if ctx.monitoring.grafana_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_grafana_host_port | default(3000) }}{% endif %}</span>
        </a>
        <a class="tile tile-orange" href="{{ prometheus_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Prometheus</span>
          <span class="tile-hint">{% if ctx.monitoring.prometheus_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_prometheus_host_port | default(9090) }}{% endif %}</span>
        </a>
        <a class="tile tile-gold" href="{{ alertmanager_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Alertmanager</span>
          <span class="tile-hint">{% if ctx.monitoring.alertmanager_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_alertmanager_host_port | default(9093) }}{% endif %}</span>
        </a>
        <a class="tile tile-green" href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">cAdvisor</span>
          <span class="tile-hint">Container metrics (host :{{ monitoring_cadvisor_host_port | default(8089) }})</span>
        </a>
        {% endif %}
        {% if ipa_tile_url | length > 0 %}
        <a class="tile tile-rose" href="{{ ipa_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_modern_label | default(ctx.identity.ipa_ui_label) }}</span>
          <span class="tile-hint">Identity management (default)</span>
        </a>
        {% endif %}
        {% if ipa_legacy_caddy_url | length > 0 %}
        <a class="tile tile-rose" href="{{ ipa_legacy_caddy_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</span>
          <span class="tile-hint">Classic Web UI</span>
        </a>
        {% elif ctx.identity.ipa_ui_url | default('') | length > 0 and ipa_tile_url != ctx.identity.ipa_ui_url %}
        <a class="tile tile-rose" href="{{ ctx.identity.ipa_ui_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (direct HTTPS)') }}</span>
          <span class="tile-hint">Direct HTTPS</span>
        </a>
        {% endif %}
        {% if ecs_tile_url | length > 0 %}
        <a class="tile tile-purple" href="{{ ecs_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">ECS</span>
          <span class="tile-hint">{% if ctx.ecs.deployed %}{{ ctx.ecs.cluster_name }}{% else %}Console{% endif %}</span>
        </a>
        {% endif %}
        {% if portal_tile_url | length > 0 %}
        <a class="tile tile-accent tile-cyan" target="_blank" rel="noopener noreferrer" href="{{ portal_tile_url }}">
          <span class="tile-label">Deployment portal</span>
          <span class="tile-hint">{{ portal_tile_hint }}</span>
        </a>
        {% endif %}
      </div>
      <p class="filter-empty" id="service-filter-empty" role="status" hidden>No matching services.</p>
    </nav>
    <section class="live-stats" id="live-stats" aria-label="Cluster health snapshot">
      <div class="live-stats-head">
        <h2>Health snapshot</h2>
        <span class="live-stats-updated" id="live-stats-updated">
          {% if ls.collected_at | default('') | length > 0 %}CM snapshot {{ ls.collected_at }}{% else %}Awaiting data{% endif %}
        </span>
      </div>
      <div class="kpi-grid" id="live-stats-kpis">
        <div class="kpi kpi-info" data-kpi="hosts-total">
          <div class="kpi-label">CM hosts</div>
          <div class="kpi-val">{{ ls.hosts.total | default(ls.inventory_host_count | default('—')) }}</div>
          <div class="kpi-sub" data-kpi-sub="hosts-heartbeat">{% if ls.hosts.good is defined %}{{ ls.hosts.good }}/{{ ls.hosts.total }} GOOD{% else %}inventory {{ ls.inventory_host_count | default('—') }}{% endif %}</div>
        </div>
        <div class="kpi kpi-pass" data-kpi="services-good">
          <div class="kpi-label">Services GOOD</div>
          <div class="kpi-val" id="kpi-services-good">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.sgood }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">STARTED+GOOD across clusters</div>
        </div>
        <div class="kpi kpi-warn" data-kpi="services-warn">
          <div class="kpi-label">CONCERNING</div>
          <div class="kpi-val" id="kpi-services-warn">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.swarn }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">CM service health</div>
        </div>
        <div class="kpi kpi-fail" data-kpi="services-bad">
          <div class="kpi-label">BAD</div>
          <div class="kpi-val" id="kpi-services-bad">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.sbad }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">CM service health</div>
        </div>
        {% if mon_on %}
        <div class="kpi kpi-accent" data-kpi="prom-up">
          <div class="kpi-label">Prometheus UP</div>
          <div class="kpi-val" id="kpi-prom-up">—</div>
          <div class="kpi-sub" data-kpi-sub="prom-detail">{% if ls_poll_prom | length > 0 %}live poll{% else %}enable path routes{% endif %}</div>
        </div>
        {% endif %}
        <div class="kpi kpi-info" data-kpi="parcels">
          <div class="kpi-label">Parcels</div>
          <div class="kpi-val" id="kpi-parcels">{{ ls.parcels | default([]) | length }}</div>
          <div class="kpi-sub">ACTIVATED</div>
        </div>
      </div>
      <p class="live-note" id="live-stats-note">
        {% if ls.cm_api_available | default(false) %}
        Service health, host heartbeats, and parcels are captured from the Cloudera Manager API during <code>35_refresh_deployment_portal.yml</code> (not live in the browser).
        {% else %}
        Cloudera Manager API snapshot unavailable from Ansible — counts fall back to inventory. Re-run portal refresh after CM is up.
        {% endif %}
        {% if mon_on and ls_poll_prom | length > 0 %}
        Prometheus target count refreshes every 60s on the ops-host portal URL (same origin, path <code>/prometheus</code>).
        {% elif mon_on %}
        Open the portal via the ops host port (not the portal-only lab vhost) for in-browser Prometheus polls.
        {% endif %}
      </p>
      {% if ls.clusters | default([]) | length > 0 %}
      <details class="panel" style="margin-top:0.75rem">
        <summary><span class="summary-main"><h2 class="section-title">Service health (CM snapshot)</h2></span>{{ panel_chevron | safe }}</summary>
        <div class="panel-body">
          <div class="table-scroll">
            <table id="live-stats-services-table" class="portal-table">
              <thead>
                <tr>
                  <th>Cluster</th>
                  <th>Service</th>
                  <th>Type</th>
                  <th>State</th>
                  <th>Health</th>
                </tr>
              </thead>
              <tbody>
                {% for cl in ls.clusters | default([]) %}
                {% for svc in cl.services | default([]) %}
                <tr>
                  <td><code>{{ cl.name }}</code></td>
                  <td>{{ svc.name }}</td>
                  <td>{{ svc.type }}</td>
                  <td>{{ svc.service_state }}</td>
                  <td{% if sec.id | default('') == 'monitoring' %} class="monitoring-url"{% endif %}>
                    {% set _h = svc.health | default('') | upper %}
                    <span class="health-pill {% if _h == 'GOOD' %}good{% elif _h == 'CONCERNING' %}concerning{% elif _h == 'BAD' %}bad{% else %}na{% endif %}">{{ svc.health }}</span>
                  </td>
                </tr>
                {% endfor %}
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </details>
      {% endif %}
    </section>

    <div class="version-strip" aria-label="Platform versions">
      <span class="chip"><strong>CM</strong> {{ ctx.versions.cm }}</span>
      <span class="chip"><strong>CDP Runtime</strong> {{ ctx.versions.cdh }}</span>
      <span class="chip"><strong>CDS</strong> {{ ctx.versions.ecs_cds }}</span>
    </div>

    <div class="section-tools" aria-label="Section display controls">
      <button class="section-tool-btn" type="button" id="sections-expand" aria-pressed="false">Expand all</button>
      <button class="section-tool-btn" type="button" id="sections-collapse" aria-pressed="false">Collapse all</button>
    </div>

    {% if oa.enabled | default(false) | bool and (oa.sections | default([]) | length > 0) %}
    <details class="panel" open>
      <summary><span class="summary-main"><h2 class="section-title">Operator access — credentials &amp; downloads</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        {% if oa.basic_auth_enabled | default(false) | bool %}
        <div class="auth-gate" id="operator-auth-gate" data-content-url="{{ _dl_prefix }}/operator-access.html">
          <p id="operator-auth-message"><strong>Login required.</strong> Sign in to view operator credentials and download private keys.</p>
          <a class="help-open-btn" href="/login.html">Login to Operator access</a>
        </div>
        <div id="operator-protected-content" aria-live="polite" hidden></div>
        {% else %}
        <p class="sub">Lab deployment secrets rendered at portal sync from Ansible group_vars (not stored in git). Use only on trusted networks.</p>
        {% if oa.ssh_keys_exposed | default(false) | bool and not (oa.basic_auth_enabled | default(false) | bool) %}
        <p class="operator-warning"><strong>SSH keys are downloadable without HTTP auth.</strong> Set <code>deployment_portal_basic_auth_enabled: true</code> or <code>deployment_portal_expose_ssh_keys: false</code>.</p>
        {% endif %}
        {% if oa.basic_auth_enabled | default(false) | bool %}
        <p class="sub">Downloads under <code>{{ oa.downloads_path_prefix | default('/downloads') }}/</code> require a portal session for user <code>{{ oa.auth_username | default('portal') }}</code> (password from <code>deployment_portal_basic_auth_password</code>).</p>
        {% endif %}
        {% if deployment_portal_expose_credentials | default(true) | bool %}
        <details class="panel cred-defaults-summary" style="margin:0.5rem 0 1rem">
          <summary><span class="summary-main"><strong>Default lab credentials</strong> — quick reference (same vars as tables below)</span>{{ panel_chevron | safe }}</summary>
          <div class="panel-body">
            <p class="sub">Rendered from Ansible <code>group_vars</code> at portal sync (not in git). Override in <code>group_vars/all.yml</code> or Jenkins <code>ANSIBLE_GROUP_VARS_YAML</code>, then re-run <code>35_refresh_deployment_portal.yml</code>. Full variable list: repo <code>ansible-playbooks/docs/REFERENCE.md</code> (Lab default passwords).</p>
            <div class="table-scroll">
              <table class="portal-table cred-table">
                <thead>
                  <tr>
                    <th>Use</th>
                    <th>Username</th>
                    <th>Password / secret</th>
                  </tr>
                </thead>
                <tbody>
                  {% if oa.basic_auth_enabled | default(false) | bool %}
                  <tr>
                    <td>Portal <code>/downloads/*</code> session login</td>
                    <td><code>{{ oa.auth_username | default('portal') }}</code></td>
                    <td><code class="cred-secret">{{ deployment_portal_basic_auth_password | default(postgres_password) }}</code></td>
                  </tr>
                  {% endif %}
                  <tr>
                    <td>Cloudera Manager</td>
                    <td><code>{{ cm_admin_user }}</code></td>
                    <td><code class="cred-secret">{{ cm_admin_pass }}</code></td>
                  </tr>
                  <tr>
                    <td>PostgreSQL (CM)</td>
                    <td><code>{{ postgres_user | default('postgres') }}</code></td>
                    <td><code class="cred-secret">{{ postgres_password }}</code></td>
                  </tr>
                  <tr>
                    <td>pgAdmin</td>
                    <td><code>{{ pgadmin_default_email }}</code></td>
                    <td><code class="cred-secret">{{ pgadmin_default_password }}</code></td>
                  </tr>
                  {% if deployment_portal_has_ipa | default(false) | bool %}
                  <tr>
                    <td>FreeIPA admin</td>
                    <td><code>{{ ipaadmin_principal }}</code></td>
                    <td><code class="cred-secret">{{ ipaadmin_password }}</code></td>
                  </tr>
                  {% endif %}
                  {% if mon_on %}
                  <tr>
                    <td>Grafana</td>
                    <td><code>{{ monitoring_grafana_admin_user }}</code></td>
                    <td><code class="cred-secret">{{ monitoring_grafana_admin_password }}</code></td>
                  </tr>
                  {% endif %}
                  <tr>
                    <td>EC2 SSH</td>
                    <td><code>{{ oa.ssh_user | default('ec2-user') }}</code></td>
                    <td><span class="badge">PEM under {{ oa.downloads_path_prefix | default('/downloads') }}/ssh/</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </details>
        {% endif %}
        <p class="sub">SSH user for instances: <code>{{ oa.ssh_user | default('ec2-user') }}</code>
          — <a href="{{ oa.downloads_path_prefix | default('/downloads') }}/operator-credentials.json">operator-credentials.json</a> (machine-readable bundle; same auth as other downloads when basic auth is enabled)
        </p>
        {% if oa.ssh_connect_command | default('') | length > 0 %}
        <p class="sub"><strong>SSH quick start</strong>{% if oa.ssh_keys_exposed | default(false) | bool %} — download <code>{{ ssh_key_filename }}</code> from <code>{{ oa.downloads_path_prefix | default('/downloads') }}/ssh/</code>, run <code>chmod 400 {{ ssh_key_filename }}</code>,{% else %} — use your lab PEM (for example <code>{{ ssh_key_filename }}</code> from Terraform/Jenkins),{% endif %} then connect using the host <strong>public IP</strong> (example <code>{{ oa.ssh_connect_host | default('') }}</code>):</p>
        <div class="ssh-command-box"><code>{{ oa.ssh_connect_command }}</code></div>
        {% endif %}
        {% if oa.ssh_host_examples | default([]) | length > 0 %}
        <p class="sub"><strong>SSH sample commands (per host)</strong> — same user/key; paths are relative to where you saved the PEM.</p>
        <div class="table-scroll">
          <table class="portal-table">
            <thead>
              <tr>
                <th>Host</th>
                <th>FQDN</th>
                <th>Command</th>
              </tr>
            </thead>
            <tbody>
              {% for ex in oa.ssh_host_examples %}
              <tr>
                <td><code>{{ ex.label }}</code></td>
                <td><code>{{ ex.host }}</code></td>
                <td><code class="ssh-inline-cmd">{{ ex.command }}</code></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% set ec2ss = ctx.ec2_startstop | default({}) %}
        {% if ec2ss.script_path | default('') | length > 0 %}
        <h2 class="section-title" style="margin-top:1rem">EC2 start / stop / describe (ipaserver)</h2>
        <p class="sub">Run on the FreeIPA / ops host via the instance IAM role (Terraform <code>ipaserver_ec2_startstop_iam_enabled</code>; re-apply TERRAFORM after IAM changes). Filters: EC2 tag <code>environment</code> = Jenkins <code>ENVIRONMENT</code> / <code>deployment_name_prefix</code> (your workspace, e.g. <code>ptgtyv1</code>); tag <code>Group</code> = Terraform <code>instance_groups</code> keys below (not Ansible inventory names). <strong>Never start/stop <code>ipa_server</code></strong> — examples exclude the FreeIPA host.</p>
        <p class="sub"><strong>Syntax</strong></p>
        <div class="ssh-command-box"><code>{{ ec2ss.usage_generic | default('') }}</code></div>
        <p class="sub"><strong>Example for this stack</strong> (Group tags present in inventory: {% if ec2ss.terraform_groups | default([]) | length > 0 %}<code>{{ ec2ss.terraform_groups | join('</code>, <code>') }}</code>{% else %}<span class="badge">none detected — see catalog in group_vars</span>{% endif %})</p>
        <div class="ssh-command-box"><code>{{ ec2ss.example_start | default('') }}</code></div>
        <p class="sub">Also: <code>{{ ec2ss.example_describe | default('') }}</code> · Jenkins <code>EC2_STARTSTOP_GROUPS</code> CSV: <code>{{ ec2ss.jenkins_groups_csv | default('') }}</code></p>
        {% endif %}
        {% for sec in oa.sections | default([]) %}
        <h2 class="section-title" style="margin-top:1rem">{{ sec.title }}</h2>
        {% if sec.intro | default('') | length > 0 %}<p class="sub">{{ sec.intro }}</p>{% endif %}
        {% if sec.downloads | default([]) | length > 0 %}
        <ul class="cred-dl-list">
          {% for dl in sec.downloads %}
          <li><a href="{{ dl.href }}" download="{{ dl.filename | default('') }}">{{ dl.label }}</a>{% if dl.note | default('') | length > 0 %} — <span class="badge">{{ dl.note }}</span>{% endif %}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if sec.credentials | default([]) | length > 0 %}
        <div class="table-scroll">
          <table class="portal-table cred-table">
            <thead>
              <tr>
                <th>Service</th>
                <th>Username</th>
                <th>Password / secret</th>
                <th>Access URLs</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {% for cr in sec.credentials %}
              <tr>
                <td>{{ cr.label }}</td>
                <td><code>{{ cr.username }}</code></td>
                <td><code class="cred-secret">{{ cr.password }}</code></td>
                <td>
                  {% if cr.url | default('') | string | lower | regex_search('^jdbc:') %}
                  {{ portal_jdbc_for_context(cr.url, ctx) }}
                  {% elif cr.public_url | default('') | length > 0 or cr.private_url | default('') | length > 0 %}
                  {{ portal_url_bundle(cr.url | default(''), cr.public_url | default(''), cr.private_url | default('')) }}
                  {% elif cr.url | default('') | length > 0 %}
                  {{ portal_url_for_context(cr.url, ctx) }}
                  {% else %}
                  <span class="badge">—</span>
                  {% endif %}
                </td>
                <td>{{ cr.note | default('') }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% endfor %}
        {% endif %}
      </div>
    </details>
    {% endif %}

    {% if ctx.access.profile == 'private' %}
    <details class="panel" open>
      <summary><span class="summary-main"><h2 class="section-title">Network access (private lab)</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub">{{ ctx.access.primary.audience }}</p>
        <ul class="clean">
          <li>Ops FQDN: <code>{{ ctx.access.primary.fqdn }}</code></li>
          <li>Management IP: <code>{{ ctx.access.primary.management_ip }}</code></li>
          <li>URL host in links: <code>{{ ctx.access.primary.host }}</code></li>
        </ul>
      </div>
    </details>
    {% else %}
    <details class="panel" open>
      <summary><span class="summary-main"><h2 class="section-title">Network access</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub"><strong>Internet / external</strong> — {{ ctx.access.external.audience }}</p>
        <ul class="clean">
          <li>Ops public IP: <code>{{ ctx.access.external.ops_ip }}</code></li>
        </ul>
        <p class="sub" style="margin-top:0.85rem"><strong>Same VPC (private IP)</strong> — {{ ctx.access.vpc.audience }}</p>
        <ul class="clean">
          <li>Ops private IP: <code>{{ ctx.access.vpc.ops_ip }}</code></li>
        </ul>
      </div>
    </details>
    {% endif %}

    {% if ctx.caddy_vhosts.enabled %}
    <details class="panel">
      <summary><span class="summary-main"><h2 class="section-title">Lab domain (Caddy) — {{ ctx.caddy_vhosts.public_base }}</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        {% if ctx.access.profile == 'private' %}
        <p class="sub">Mode <code>{{ ctx.caddy_vhosts.dns_mode }}</code> — hostnames resolve to the ops host on your private network (FreeIPA/AD DNS or static records). No public internet required.</p>
        {% else %}
        <p class="sub">Mode <code>{{ ctx.caddy_vhosts.dns_mode }}</code> — public-IP hostnames for external/internet; private-IP hostnames when registered for in-VPC use.</p>
        {% endif %}
        <p class="sub">Service URLs are listed once in their owning platform sections below. Quick open remains the shortest navigation path.</p>
      </div>
    </details>
    {% endif %}

    <details class="panel">
      <summary><span class="summary-main"><h2 class="section-title">Ops host &amp; platform details</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub">Reverse proxy and containerized UIs on <code>{{ ctx.ops_host.fqdn }}</code> <span class="badge">{{ ctx.ops_host.inventory_group }}</span>. {{ ctx.ops_host.services }}</p>
        <ul class="clean">
          <li><strong>Cloudera Manager (direct HTTP)</strong> — {{ portal_url_fqdn_pubip_cm(ctx, ctx.cloudera_manager.ui_url_http, cm_http_port, 'http') }} <span class="badge">VPC / admin</span></li>
          <li><strong>Cloudera Manager (direct HTTPS)</strong> — {{ portal_url_fqdn_pubip_cm(ctx, ctx.cloudera_manager.ui_url_https, cm_https_port, 'https') }} <span class="badge">:7183 when Auto-TLS on</span></li>
          {% if ctx.identity.ipa_caddy_modern_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_modern_label | default('FreeIPA (modern UI)') }}</strong> — {{ portal_url_for_context(ctx.identity.ipa_caddy_modern_url, ctx) }}</li>
          {% endif %}
          {% if ctx.identity.ipa_caddy_legacy_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</strong> — {{ portal_url_for_context(ctx.identity.ipa_caddy_legacy_url, ctx) }}</li>
          {% endif %}
          {% if ctx.identity.ipa_ui_url %}
          <li><strong>{{ ctx.identity.ipa_ui_label }} (HTTPS on ipaserver)</strong> — {{ portal_url_for_context(ctx.identity.ipa_ui_url, ctx) }}</li>
          {% endif %}
        </ul>
        <h2 class="section-title" style="margin-top:1rem">PostgreSQL</h2>
        <ul class="clean">
          <li>Host: <code>{{ ctx.postgresql.host_fqdn }}</code></li>
          <li>Port: <code>{{ ctx.postgresql.port }}</code></li>
          <li>CM JDBC — {{ portal_jdbc_for_context('jdbc:postgresql://' ~ ctx.postgresql.host_fqdn ~ ':' ~ (ctx.postgresql.port | string) ~ '/scm', ctx) }}</li>
          <li>{{ ctx.postgresql.database_host_note }}</li>
        </ul>
        <h2 class="section-title" style="margin-top:1rem">Clusters</h2>
        <ul class="clean">
          <li>CDP Runtime base cluster: <code>{{ ctx.cloudera_manager.cluster_name }}</code></li>
          {% if ctx.ecs.deployed %}
          <li>ECS cluster: <code>{{ ctx.ecs.cluster_name }}</code></li>
          <li>ECS app domain: <code>{{ ctx.ecs.app_domain }}</code></li>
          <li>ECS console — {{ portal_url_for_context(ctx.ecs.console_hint, ctx) }}</li>
          <li>ECS direct HTTPS — {{ portal_url_for_context(ctx.ecs.console_url_direct | default('https://console.' ~ ctx.ecs.app_domain), ctx) }}</li>
          <li>Data Services hostnames: <code>{{ ctx.ecs.apps_wildcard }}</code></li>
          {% else %}
          <li>ECS: <span class="badge">not in inventory</span></li>
          {% endif %}
        </ul>
        {% if ctx.data_services.links | length > 0 %}
        <h2 class="section-title" style="margin-top:1rem">Data services &amp; related URLs</h2>
        <ul class="clean">
          {% for link in ctx.data_services.links %}
          <li><strong>{{ link.name }}</strong>{% if link.description %} — {{ link.description }}{% endif %} — {{ portal_url_for_context(link.url, ctx) }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if ctx.extra_links | length > 0 %}
        <h2 class="section-title" style="margin-top:1rem">Additional links</h2>
        <ul class="clean">
          {% for link in ctx.extra_links %}
          <li><strong>{{ link.name }}</strong> — {{ portal_url_for_context(link.url, ctx) }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </details>

    {% if mon_on %}
    <details class="panel">
      <summary><span class="summary-main"><h2 class="section-title">Monitoring stack (on ops host)</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub">Each monitoring endpoint is listed once as its Caddy URL followed by available public-IP and private-IP alternatives.</p>
        <div class="table-scroll">
          <table class="portal-table">
            <thead>
              <tr><th>Service</th><th>Access URLs</th></tr>
            </thead>
            <tbody>
              {% for service in ['grafana', 'prometheus', 'alertmanager', 'cadvisor'] %}
              {% set caddy_url = ctx.monitoring[service ~ '_caddy_url'] | default('') %}
              {% set public_url = ctx.access.external[service ~ '_direct'] | default('') %}
              {% set private_url = ctx.access.vpc[service ~ '_direct'] | default(ctx.access.primary[service ~ '_direct'] | default('')) %}
              <tr>
                <td><strong>{{ 'cAdvisor' if service == 'cadvisor' else service | capitalize }}</strong></td>
                <td class="monitoring-url">{{ portal_url_bundle(caddy_url, public_url, private_url) }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    {% endif %}

    {% if ctx.planned_roles | default([]) | length > 0 %}
    <details class="panel">
      <summary><span class="summary-main"><h2 class="section-title">Planned / configured roles</h2></span>{{ panel_chevron | safe }}</summary>
      <div class="panel-body">
        <p class="sub">From Ansible inventory groups, <code>host_template</code> hostvars, <code>base_cluster_install_services</code>, and the monitoring portal stack on the ops host (<code>{{ ctx.ops_host.inventory_group | default('ipaserver') }}</code>).</p>
        <div class="table-scroll">
          <table class="portal-table">
            <thead>
              <tr>
                <th>Stack</th>
                <th>Role</th>
                <th>Placement</th>
                <th>Source</th>
              </tr>
            </thead>
            <tbody>
              {% for row in ctx.planned_roles %}
              <tr>
                <td>{{ row.stack }}</td>
                <td>{{ row.role }}</td>
                <td><code>{{ row.placement }}</code></td>
                <td><span class="badge">{{ row.source }}</span></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    {% endif %}

    {% if ls.clusters | default([]) | length > 0 %}
    <section class="flat">
      <h2>CM services (live snapshot)</h2>
      <p class="sub">From Cloudera Manager API at portal refresh; same data as the health snapshot KPIs above.</p>
      <div class="table-scroll">
        <table class="portal-table">
          <thead>
            <tr>
              <th>Cluster</th>
              <th>Service</th>
              <th>Type</th>
              <th>State</th>
              <th>Health</th>
            </tr>
          </thead>
          <tbody>
            {% for cl in ls.clusters | default([]) %}
            {% for svc in cl.services | default([]) %}
            <tr>
              <td><code>{{ cl.name }}</code></td>
              <td>{{ svc.name }}</td>
              <td>{{ svc.type }}</td>
              <td>{{ svc.service_state }}</td>
              <td>
                {% set _h = svc.health | default('') | upper %}
                <span class="health-pill {% if _h == 'GOOD' %}good{% elif _h == 'CONCERNING' %}concerning{% elif _h == 'BAD' %}bad{% else %}na{% endif %}">{{ svc.health }}</span>
              </td>
            </tr>
            {% endfor %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if ctx.inventory_hosts | default([]) | length > 0 %}
    <details class="panel inventory-section">
      <summary>
        <span class="summary-main">
          <div class="inventory-section-head">
            <h2 class="section-title">Host inventory</h2>
            {% if _ssh_keys_ui_on and (ns_ssh_dl.items | length > 0) %}
            {% set inventory_header_key = ns_ssh_dl.items | first %}
            {% set inventory_header_key_url = inventory_header_key.href ~ '?v=' ~ (ctx.generated_at | default('current') | replace(':', '') | replace('+', '') | replace(' ', '')) %}
            <div class="inventory-dl-actions" aria-label="SSH private key download" onclick="event.stopPropagation();">
              <a class="dl-btn" id="inventory-key-action"
                 href="{% if oa.basic_auth_enabled | default(false) | bool %}/login.html{% else %}{{ inventory_header_key_url }}{% endif %}"
                 data-login-url="/login.html"
                 data-download-url="{{ inventory_header_key_url }}"
                 data-download-name="{{ inventory_header_key.filename | default('') }}"
                 data-download-label="{{ inventory_header_key.label }}"
                 title="{% if oa.basic_auth_enabled | default(false) | bool %}Sign in to download the SSH private key{% elif inventory_header_key.note | default('') | length > 0 %}{{ inventory_header_key.note }}{% else %}Save PEM, then chmod 400{% endif %}"
                 {% if not (oa.basic_auth_enabled | default(false) | bool) %}download="{{ inventory_header_key.filename | default('') }}"{% endif %}>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8.5 1.5v8.793l2.146-2.147.707.708L8 12.207 4.646 8.854l.707-.708L7.5 10.293V1.5h1zM2 12.5v1h12v-1H2z"/></svg>
                <span id="inventory-key-action-label">{% if oa.basic_auth_enabled | default(false) | bool %}Login to download key{% else %}{{ inventory_header_key.label }}{% endif %}</span>
              </a>
            </div>
            {% endif %}
          </div>
        </span>
        {{ panel_chevron | safe }}
      </summary>
      <div class="panel-body">
        <p class="sub">One row per host: Ansible groups, addresses, inferred roles, and sample <code>ssh -i &lt;pem&gt;</code> commands (user <code>{{ oa.ssh_user | default('ec2-user') }}</code>, key file <code>{{ ssh_key_filename }}</code>){% if _ssh_keys_ui_on and (ns_ssh_dl.items | length > 0) %} — use the download button in the header for the primary cluster PEM (same key for all hosts; works even when only the ops/ipaserver row is listed).{% endif %}</p>
        {% if _ssh_keys_ui_on and (ns_ssh_dl.items | length > 0) and oa.basic_auth_enabled | default(false) | bool %}
        <p class="inventory-dl-hint">Downloads require an active portal session (user <code>{{ oa.auth_username | default('portal') }}</code>). Logout revokes the session immediately.</p>
        {% elif _ssh_keys_ui_on and (ns_ssh_dl.items | length > 0) and not (oa.basic_auth_enabled | default(false) | bool) %}
        <p class="inventory-dl-hint">PEM export is disabled while portal authentication is off.</p>
        {% endif %}
        <div class="table-scroll">
          <table class="portal-table inventory-table">
            <thead>
              <tr>
                <th>Host</th>
                <th>FQDN</th>
                <th>Private IP</th>
                <th>Public IP</th>
                <th>Groups</th>
                <th>Roles</th>
                <th>SSH login</th>
                {% if _ssh_keys_ui_on and (ns_ssh_dl.items | length > 0) %}
                <th>PEM</th>
                {% endif %}
              </tr>
            </thead>
            <tbody>
              {% for h in ctx.inventory_hosts %}
              <tr>
                <td><code>{{ h.hostname }}</code> <span class="badge">{{ h.inventory_name }}</span></td>
                <td><code>{{ h.fqdn }}</code></td>
                <td><code>{{ h.private_ip }}</code></td>
                <td>{% if h.public_ip | default('') | length > 0 and ('{{' not in (h.public_ip | string)) %}<code>{{ h.public_ip }}</code>{% else %}<span class="badge">VPC only</span>{% endif %}</td>
                <td>
                  {% for gl in h.group_labels | default(h.groups | default([])) %}
                  <span class="group-tag">{{ gl }}</span>
                  {% endfor %}
                </td>
                <td>
                  {% for role in h.role_labels | default([]) %}
                  <span class="role-badge">{{ role }}</span>
                  {% endfor %}
                </td>
                <td>{% if h.ssh_command | default('') | length > 0 %}<code class="ssh-inline-cmd">{{ h.ssh_command }}</code>{% else %}<span class="badge">—</span>{% endif %}</td>
                {% if _ssh_keys_ui_on and (ns_ssh_dl.items | length > 0) %}
                <td>
                  <div class="inventory-pem-links{% if oa.basic_auth_enabled | default(false) | bool %} auth-protected-download{% endif %}"{% if oa.basic_auth_enabled | default(false) | bool %} hidden{% endif %}>
                  {% for dl in ns_ssh_dl.items %}
                  <a class="dl-link-inline" href="{{ dl.href }}?v={{ ctx.generated_at | default('current') | replace(':', '') | replace('+', '') | replace(' ', '') }}" download="{{ dl.filename | default('') }}" title="{{ dl.label }}">{{ dl.filename | default(dl.label) }}</a>
                  {% endfor %}
                  </div>
                  {% if oa.basic_auth_enabled | default(false) | bool %}
                  <a class="dl-link-inline auth-download-login" href="/login.html">Login required</a>
                  {% endif %}
                </td>
                {% endif %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    {% endif %}
  </main>
  <dialog class="help-dialog" id="portal-help-dialog" aria-labelledby="portal-help-title">
    <div class="help-dialog-head">
      <h2 id="portal-help-title">Using this deployment portal</h2>
      <button type="button" class="help-close-btn" id="portal-help-close" aria-label="Close help">Close</button>
    </div>
    <div class="help-dialog-inner">
      <p class="sub"><strong>Quick open</strong> — tiles link to Cloudera Manager, pgAdmin, monitoring, FreeIPA (modern and legacy via Caddy when configured), ECS, and this portal. Filter tiles by name or description; press <code>/</code> to focus the filter and <code>Esc</code> to clear it.</p>
      <p class="sub"><strong>Health snapshot</strong> — Cloudera Manager service health from the last portal refresh (<code>35_refresh_deployment_portal.yml</code>); Prometheus target count may poll in-browser when path routes are enabled.</p>
      <p class="sub"><strong>Page navigation</strong> — expand or collapse all main sections together, use the fixed arrows to jump to either end, and use the top progress bar to track your position.</p>
      <p class="sub"><strong>Operator access</strong> — lab credentials and PEM downloads rendered at sync from Ansible group_vars (not stored in git). Service URLs live in their relevant platform sections and in <code>operator-credentials.json</code>. Treat as sensitive; restrict network access.</p>
      <p class="sub"><strong>Network access</strong> — public/private addressing and access-profile facts without repeating service URLs.</p>
      <p class="sub"><strong>Host inventory &amp; planned roles</strong> — Ansible groups, addresses, inferred CDP/monitoring placement; cluster SSH PEM downloads appear in the Host inventory header when key export is enabled.</p>
      <p class="sub"><strong>Downloads security</strong> — when <code>deployment_portal_basic_auth_enabled</code> is true, files under <code>/downloads</code> (including SSH keys) require a revocable portal session. Prefer authentication on before exposing PEMs.</p>
      <p class="sub"><strong>FreeIPA legacy UI</strong> — use the Caddy <code>ipa.*</code> vhost (<code>/ipa/ui</code>) so browsers do not need <code>/etc/hosts</code> for the ipaserver FQDN; direct <code>https://&lt;ipaserver-fqdn&gt;</code> still needs lab DNS.</p>
    </div>
  </dialog>
  <div class="page-jump" aria-label="Page navigation">
    <button type="button" id="page-jump-top" title="Jump to top" aria-label="Jump to top">&uarr;</button>
    <button type="button" id="page-jump-bottom" title="Jump to bottom" aria-label="Jump to bottom">&darr;</button>
  </div>
  <footer class="site-footer">
    <div>Portal developed by <strong>{{ ctx.deployment.portal_owner_display | default('Kuldeep Sahu') }}</strong></div>
