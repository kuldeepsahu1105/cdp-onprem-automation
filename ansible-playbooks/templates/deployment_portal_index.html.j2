{% set ctx = deployment_portal_context %}
{% set _cm_caddy = ctx.cloudera_manager.caddy_url | default('') | trim | regex_replace('/+$', '') %}
{% set cm_tile_url = _cm_caddy if (_cm_caddy | length > 0) else ctx.cloudera_manager.ui_url_https %}
{% set pgadmin_tile_url = ctx.portal.pgadmin_caddy_url | default('') if (ctx.portal.pgadmin_caddy_url | default('') | length > 0) else (ctx.portal.pgadmin_url_direct | default(ctx.portal.pgadmin_url | default(''))) %}
{% set ipa_modern_url = ctx.identity.ipa_caddy_modern_url | default('') if (ctx.identity.ipa_caddy_modern_url | default('') | length > 0) else (ctx.identity.ipa_caddy_url | default('')) %}
{% set ipa_legacy_caddy_url = ctx.identity.ipa_caddy_legacy_url | default('') %}
{% set ipa_tile_url = ipa_modern_url if (ipa_modern_url | length > 0) else (ctx.identity.ipa_ui_url | default('')) %}
{% set ecs_tile_url = (ctx.ecs.caddy_url | default('') if (ctx.ecs.caddy_url | default('') | length > 0) else (ctx.ecs.console_hint | default(''))) if ctx.ecs.deployed else '' %}
{% set _portal_caddy_url = ctx.caddy_vhosts.urls_public.portal.url | default('') if (ctx.caddy_vhosts.enabled | default(false)) else '' %}
{% set portal_tile_url = _portal_caddy_url if (_portal_caddy_url | length > 0) else ctx.portal.index_url | default('') %}
{% set portal_tile_hint = ctx.caddy_vhosts.urls_public.portal.hostname if (_portal_caddy_url | length > 0) else 'Ops host Caddy index' %}
{% set mon_on = ctx.monitoring.enabled | default(false) | bool %}
{% set grafana_tile_url = ctx.monitoring.grafana_caddy_url | default('') if (ctx.monitoring.grafana_caddy_url | default('') | length > 0) else (ctx.monitoring.grafana_url | default(ctx.monitoring.grafana_path_url | default(''))) %}
{% set prometheus_tile_url = ctx.monitoring.prometheus_caddy_url | default('') if (ctx.monitoring.prometheus_caddy_url | default('') | length > 0) else (ctx.monitoring.prometheus_url | default(ctx.monitoring.prometheus_path_url | default(''))) %}
{% set alertmanager_tile_url = ctx.monitoring.alertmanager_caddy_url | default('') if (ctx.monitoring.alertmanager_caddy_url | default('') | length > 0) else (ctx.monitoring.alertmanager_url | default(ctx.monitoring.alertmanager_path_url | default(''))) %}
{% set cadvisor_tile_url = ctx.monitoring.cadvisor_url | default('') %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>CDP Deployment Portal — {{ ctx.cluster_domain }}</title>
  <style>
    :root {
      --bg: #0c1017;
      --bg-elevated: #121926;
      --card: #1a2332;
      --text: #e8edf4;
      --muted: #94a3b8;
      --accent: #f96702;
      --accent-soft: #5b9fd4;
      --border: #2d3a4d;
      --tile-hover: #243044;
      --max-w: 960px;
      --radius: 10px;
    }
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 0;
      line-height: 1.55;
    }
    a { color: #7ec8ff; text-decoration: none; }
    a:hover { text-decoration: underline; }
    code {
      background: #0b1018;
      padding: 0.12rem 0.4rem;
      border-radius: 4px;
      font-size: 0.85em;
      word-break: break-all;
    }
    .site-header {
      background: linear-gradient(135deg, #1a2332 0%, #0f1419 55%, #1a1208 100%);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem 1.25rem;
    }
    .site-header-inner {
      max-width: var(--max-w);
      margin: 0 auto;
    }
    .brand-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .brand-mark {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
    }
    .brand-mark svg { display: block; width: 100%; height: 100%; }
    h1 {
      font-size: 1.35rem;
      font-weight: 650;
      margin: 0;
      letter-spacing: -0.02em;
    }
    .brand-tag {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      font-weight: 600;
    }
    .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.85rem;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.2rem 0.65rem;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .chip strong { color: var(--text); font-weight: 600; margin-right: 0.25rem; }
    .wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1.25rem 1rem 2rem;
    }
    .sub {
      color: var(--muted);
      font-size: 0.88rem;
      margin: 0 0 0.75rem;
    }
    h2.section-title {
      font-size: 0.95rem;
      margin: 0;
      color: var(--accent-soft);
      font-weight: 600;
    }
    .quick-actions {
      margin-bottom: 1.25rem;
    }
    .quick-actions h2 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin: 0 0 0.65rem;
      font-weight: 600;
    }
    .tile-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
      gap: 0.65rem;
      align-items: stretch;
    }
    a.tile {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.2rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.9rem 0.95rem;
      color: var(--text);
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
      min-height: 5.25rem;
      height: 100%;
    }
    a.tile:hover {
      background: var(--tile-hover);
      border-color: #3d4f66;
      text-decoration: none;
    }
    a.tile .tile-label {
      font-weight: 650;
      font-size: 0.95rem;
    }
    a.tile .tile-hint {
      font-size: 0.72rem;
      color: var(--muted);
      line-height: 1.35;
    }
    a.tile.tile-accent {
      border-color: rgba(249, 103, 2, 0.35);
    }
    details.panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 0.75rem;
      overflow: hidden;
    }
    details.panel > summary {
      cursor: pointer;
      padding: 0.85rem 1rem;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      user-select: none;
    }
    details.panel > summary::-webkit-details-marker { display: none; }
    details.panel > summary::marker { content: none; display: none; }
    details.panel > summary .summary-main {
      flex: 1;
      min-width: 0;
    }
    details.panel > summary .panel-chevron {
      flex-shrink: 0;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1;
      transition: transform 0.15s ease;
    }
    details.panel[open] > summary .panel-chevron { transform: rotate(90deg); }
    details.panel > summary:hover { background: rgba(255, 255, 255, 0.03); }
    .panel-body {
      padding: 0 1rem 1rem;
      border-top: 1px solid var(--border);
    }
    section.flat {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.1rem;
      margin-bottom: 0.75rem;
    }
    section.flat h2 {
      font-size: 0.95rem;
      margin: 0 0 0.75rem;
      color: var(--accent-soft);
      font-weight: 600;
    }
    ul.clean {
      margin: 0;
      padding-left: 1.15rem;
    }
    ul.clean li { margin: 0.4rem 0; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    th, td {
      text-align: left;
      padding: 0.45rem 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    th { color: var(--muted); font-weight: 600; }
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .badge {
      display: inline-block;
      background: #243044;
      color: var(--muted);
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      font-size: 0.72rem;
      margin-left: 0.3rem;
      vertical-align: middle;
    }
    .role-badge {
      display: inline-block;
      background: rgba(91, 159, 212, 0.15);
      border: 1px solid rgba(91, 159, 212, 0.35);
      color: #b8d4f0;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      font-size: 0.7rem;
      margin: 0.12rem 0.2rem 0.12rem 0;
      white-space: nowrap;
    }
    .group-tag {
      display: inline-block;
      font-size: 0.72rem;
      color: var(--muted);
      margin-right: 0.35rem;
    }
    @media (max-width: 480px) {
      .site-header { padding: 0.85rem 1rem; }
      h1 { font-size: 1.15rem; }
      .wrap { padding: 1rem 0.75rem 1.5rem; }
      .tile-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="site-header-inner">
      <div class="brand-row">
        <div class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" role="img">
            <rect width="40" height="40" rx="8" fill="#1a2332"/>
            <path d="M8 28 L20 10 L32 28 Z" fill="none" stroke="#f96702" stroke-width="2.2" stroke-linejoin="round"/>
            <circle cx="20" cy="22" r="3" fill="#5b9fd4"/>
          </svg>
        </div>
        <div>
          <div class="brand-tag">Cloudera Data Platform</div>
          <h1>Deployment portal</h1>
        </div>
      </div>
      <div class="meta-row">
        <span class="chip"><strong>Domain</strong> {{ ctx.cluster_domain }}</span>
        <span class="chip"><strong>Realm</strong> {{ ctx.cluster_realm }}</span>
        <span class="chip"><strong>Identity</strong> {{ ctx.identity_provider }}</span>
        <span class="chip"><strong>Access</strong> {{ ctx.access.profile }} ({{ ctx.access.environment }})</span>
        <span class="chip"><strong>Generated</strong> {{ ctx.generated_at }}</span>
      </div>
    </div>
  </header>

  <main class="wrap">
    <nav class="quick-actions" aria-label="Primary services">
      <h2>Quick open</h2>
      <div class="tile-grid">
        {% if cm_tile_url | length > 0 %}
        <a class="tile tile-accent" href="{{ cm_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Cloudera Manager</span>
          <span class="tile-hint">Cluster admin UI</span>
        </a>
        {% endif %}
        {% if ctx.portal.pgadmin_url | default(pgadmin_tile_url | default('')) | length > 0 %}
        <a class="tile" href="{{ ctx.portal.pgadmin_url | default(pgadmin_tile_url) }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">pgAdmin</span>
          <span class="tile-hint">CM PostgreSQL{% if ctx.portal.pgadmin_caddy_url | default('') | length > 0 %} (Caddy){% endif %}</span>
        </a>
        {% endif %}
        {% if mon_on and (grafana_tile_url | length > 0) %}
        <a class="tile" href="{{ grafana_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Grafana</span>
          <span class="tile-hint">Dashboards{% if ctx.monitoring.grafana_caddy_url | default('') | length > 0 %} (Caddy vhost){% endif %}</span>
        </a>
        {% endif %}
        {% if mon_on and (prometheus_tile_url | length > 0) %}
        <a class="tile" href="{{ prometheus_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Prometheus</span>
          <span class="tile-hint">Metrics</span>
        </a>
        {% endif %}
        {% if mon_on and (alertmanager_tile_url | length > 0) %}
        <a class="tile" href="{{ alertmanager_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Alertmanager</span>
          <span class="tile-hint">Alerts</span>
        </a>
        {% endif %}
        {% if mon_on and (cadvisor_tile_url | length > 0) %}
        <a class="tile" href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">cAdvisor</span>
          <span class="tile-hint">Container metrics (:8089)</span>
        </a>
        {% endif %}
        {% if ipa_tile_url | length > 0 %}
        <a class="tile" href="{{ ipa_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_modern_label | default(ctx.identity.ipa_ui_label) }}</span>
          <span class="tile-hint">Identity management (default)</span>
        </a>
        {% endif %}
        {% if ipa_legacy_caddy_url | length > 0 %}
        <a class="tile" href="{{ ipa_legacy_caddy_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</span>
          <span class="tile-hint">Classic Web UI</span>
        </a>
        {% elif ctx.identity.ipa_ui_url | default('') | length > 0 and ipa_tile_url != ctx.identity.ipa_ui_url %}
        <a class="tile" href="{{ ctx.identity.ipa_ui_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (direct HTTPS)') }}</span>
          <span class="tile-hint">{{ ctx.identity.ipa_ui_url }}</span>
        </a>
        {% endif %}
        {% if ecs_tile_url | length > 0 %}
        <a class="tile" href="{{ ecs_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">ECS</span>
          <span class="tile-hint">{% if ctx.ecs.deployed %}{{ ctx.ecs.cluster_name }}{% else %}Console{% endif %}</span>
        </a>
        {% endif %}
        {% if portal_tile_url | length > 0 %}
        <a class="tile tile-accent" target="_blank" rel="noopener noreferrer" href="{{ portal_tile_url }}">
          <span class="tile-label">Deployment portal</span>
          <span class="tile-hint">{{ portal_tile_hint }}</span>
        </a>
        {% endif %}
      </div>
    </nav>

    {% if ctx.endpoints | default([]) | length > 0 %}
    <section class="flat">
      <h2>Endpoints</h2>
      <p class="sub"><strong>Service</strong> is the product or UI name. <strong>Hostname</strong> is the inventory FQDN of the backing host (or ECS console name). Links open in a new tab.</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Service</th>
              <th>URL</th>
              <th>Hostname</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {% for ep in ctx.endpoints %}
            <tr>
              <td>{{ ep.name }}</td>
              <td><a href="{{ ep.url }}" target="_blank" rel="noopener noreferrer">{{ ep.url }}</a></td>
              <td>{% if ep.hostname | default('') | length > 0 %}<code>{{ ep.hostname }}</code>{% else %}<span class="badge">—</span>{% endif %}</td>
              <td>{{ ep.note | default('') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if ctx.access.profile == 'private' %}
    <details class="panel" open>
      <summary><span class="summary-main"><h2 class="section-title">Network access (private lab)</h2></span><span class="panel-chevron" aria-hidden="true">▸</span></summary>
      <div class="panel-body">
        <p class="sub">{{ ctx.access.primary.audience }}</p>
        <ul class="clean">
          <li>Ops FQDN: <code>{{ ctx.access.primary.fqdn }}</code></li>
          <li>Management IP: <code>{{ ctx.access.primary.management_ip }}</code></li>
          <li>URL host in links: <code>{{ ctx.access.primary.host }}</code></li>
          <li><strong>Portal</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.primary.portal }}">{{ ctx.access.primary.portal }}</a></li>
          <li><strong>pgAdmin</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.primary.pgadmin }}">{{ ctx.access.primary.pgadmin }}</a></li>
          {% if ctx.monitoring.enabled %}
          <li><strong>Grafana</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.primary.grafana }}">{{ ctx.access.primary.grafana }}</a></li>
          <li><strong>Prometheus</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.primary.prometheus }}">{{ ctx.access.primary.prometheus }}</a></li>
          <li><strong>Alertmanager</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.primary.alertmanager }}">{{ ctx.access.primary.alertmanager }}</a></li>
          <li><strong>cAdvisor</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.primary.cadvisor }}">{{ ctx.access.primary.cadvisor }}</a></li>
          {% endif %}
        </ul>
      </div>
    </details>
    {% else %}
    <details class="panel" open>
      <summary><span class="summary-main"><h2 class="section-title">Network access</h2></span><span class="panel-chevron" aria-hidden="true">▸</span></summary>
      <div class="panel-body">
        <p class="sub"><strong>Internet / Jenkins</strong> — {{ ctx.access.external.audience }}</p>
        <ul class="clean">
          <li>Ops public IP: <code>{{ ctx.access.external.ops_ip }}</code></li>
          <li><strong>Portal</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.external.portal }}">{{ ctx.access.external.portal }}</a></li>
          <li><strong>pgAdmin</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.external.pgadmin }}">{{ ctx.access.external.pgadmin }}</a></li>
          {% if ctx.monitoring.enabled %}
          <li><strong>Grafana</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.external.grafana }}">{{ ctx.access.external.grafana }}</a></li>
          <li><strong>Prometheus</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.external.prometheus }}">{{ ctx.access.external.prometheus }}</a></li>
          <li><strong>Alertmanager</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.external.alertmanager }}">{{ ctx.access.external.alertmanager }}</a></li>
          <li><strong>cAdvisor</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.external.cadvisor }}">{{ ctx.access.external.cadvisor }}</a></li>
          {% endif %}
        </ul>
        <p class="sub" style="margin-top:0.85rem"><strong>Same VPC (private IP)</strong> — {{ ctx.access.vpc.audience }}</p>
        <ul class="clean">
          <li>Ops private IP: <code>{{ ctx.access.vpc.ops_ip }}</code></li>
          <li><strong>Portal</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.vpc.portal }}">{{ ctx.access.vpc.portal }}</a></li>
          <li><strong>pgAdmin</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.vpc.pgadmin }}">{{ ctx.access.vpc.pgadmin }}</a></li>
          {% if ctx.monitoring.enabled %}
          <li><strong>Grafana</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.vpc.grafana }}">{{ ctx.access.vpc.grafana }}</a></li>
          <li><strong>Prometheus</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.vpc.prometheus }}">{{ ctx.access.vpc.prometheus }}</a></li>
          <li><strong>Alertmanager</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.vpc.alertmanager }}">{{ ctx.access.vpc.alertmanager }}</a></li>
          <li><strong>cAdvisor</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.access.vpc.cadvisor }}">{{ ctx.access.vpc.cadvisor }}</a></li>
          {% endif %}
        </ul>
      </div>
    </details>
    {% endif %}

    {% if ctx.caddy_vhosts.enabled %}
    <details class="panel">
      <summary><span class="summary-main"><h2 class="section-title">Lab domain (Caddy) — {{ ctx.caddy_vhosts.public_base }}</h2></span><span class="panel-chevron" aria-hidden="true">▸</span></summary>
      <div class="panel-body">
        {% if ctx.access.profile == 'private' %}
        <p class="sub">Mode <code>{{ ctx.caddy_vhosts.dns_mode }}</code> — hostnames resolve to the ops host on your private network (FreeIPA/AD DNS or static records). No public internet required.</p>
        {% else %}
        <p class="sub">Mode <code>{{ ctx.caddy_vhosts.dns_mode }}</code> — public-IP hostnames for Jenkins/internet; private-IP hostnames when registered for in-VPC use.</p>
        {% endif %}
        <ul class="clean">
          <li><strong>Portal</strong> — <a href="{{ ctx.caddy_vhosts.urls_public.portal.url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.portal.hostname }}</a></li>
          <li><strong>pgAdmin</strong> — <a href="{{ ctx.caddy_vhosts.urls_public.pgadmin.url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.pgadmin.hostname }}</a></li>
          <li><strong>CM (Caddy HTTP)</strong> — <a href="{{ ctx.caddy_vhosts.urls_public.cm.url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.cm.hostname }}</a></li>
          <li><strong>CM (HTTPS direct)</strong> — <a href="{{ ctx.cloudera_manager.ui_url_https }}" target="_blank" rel="noopener noreferrer">{{ ctx.cloudera_manager.host_fqdn }}:7183</a></li>
          {% if mon_on and ctx.caddy_vhosts.urls_public.grafana is defined %}
          <li><strong>Grafana</strong> — <a href="{{ grafana_tile_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.grafana.hostname }}</a></li>
          <li><strong>Prometheus</strong> — <a href="{{ prometheus_tile_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.prometheus.hostname }}</a></li>
          <li><strong>Alertmanager</strong> — <a href="{{ alertmanager_tile_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.alertmanager.hostname }}</a></li>
          <li><strong>cAdvisor</strong> — <a href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">{{ cadvisor_tile_url }}</a></li>
          {% elif mon_on %}
          <li><strong>Grafana</strong> — <a href="{{ grafana_tile_url }}" target="_blank" rel="noopener noreferrer">{{ grafana_tile_url }}</a></li>
          <li><strong>Prometheus</strong> — <a href="{{ prometheus_tile_url }}" target="_blank" rel="noopener noreferrer">{{ prometheus_tile_url }}</a></li>
          <li><strong>Alertmanager</strong> — <a href="{{ alertmanager_tile_url }}" target="_blank" rel="noopener noreferrer">{{ alertmanager_tile_url }}</a></li>
          <li><strong>cAdvisor</strong> — <a href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">{{ cadvisor_tile_url }}</a></li>
          {% endif %}
          {% if ctx.caddy_vhosts.urls_vpc.portal is defined and ctx.caddy_vhosts.urls_vpc.portal.url | default('') | length > 0 %}
          <li><strong>Portal (VPC slug)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.caddy_vhosts.urls_vpc.portal.url }}">{{ ctx.caddy_vhosts.urls_vpc.portal.hostname }}</a></li>
          {% endif %}
          {% if ctx.identity.ipa_caddy_modern_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_modern_label | default('FreeIPA (modern UI)') }}</strong> — <a href="{{ ctx.identity.ipa_caddy_modern_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.ipa.hostname }}/ipa/modern-ui/</a></li>
          {% endif %}
          {% if ctx.identity.ipa_caddy_legacy_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</strong> — <a href="{{ ctx.identity.ipa_caddy_legacy_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.ipa.hostname }}/ipa/ui</a></li>
          {% elif ctx.identity.ipa_caddy_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_label }}</strong> — <a href="{{ ctx.identity.ipa_caddy_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.caddy_vhosts.urls_public.ipa.hostname }}</a> (redirects to modern UI)</li>
          {% endif %}
        </ul>
      </div>
    </details>
    {% endif %}

    <details class="panel">
      <summary><span class="summary-main"><h2 class="section-title">Ops host &amp; platform details</h2></span><span class="panel-chevron" aria-hidden="true">▸</span></summary>
      <div class="panel-body">
        <p class="sub">Reverse proxy and containerized UIs on <code>{{ ctx.ops_host.fqdn }}</code> <span class="badge">{{ ctx.ops_host.inventory_group }}</span>. {{ ctx.ops_host.services }}</p>
        <ul class="clean">
          <li><strong>Deployment portal</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ portal_tile_url | default(ctx.portal.index_url) }}">{{ portal_tile_url | default(ctx.portal.index_url) }}</a></li>
          <li><strong>pgAdmin</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ pgadmin_tile_url }}">{{ pgadmin_tile_url }}</a> <span class="badge">CM DB on {{ ctx.postgresql.host_fqdn }}</span></li>
          {% if ctx.portal.pgadmin_caddy_url | default('') | length > 0 and ctx.portal.pgadmin_url_direct | default('') | length > 0 %}
          <li><strong>pgAdmin (direct port)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.portal.pgadmin_url_direct }}">{{ ctx.portal.pgadmin_url_direct }}</a></li>
          {% endif %}
          {% if _cm_caddy | length > 0 %}
          <li><strong>Cloudera Manager (Caddy HTTP)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ _cm_caddy }}">{{ _cm_caddy }}</a></li>
          {% endif %}
          <li><strong>Cloudera Manager (direct HTTP)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.cloudera_manager.ui_url_http }}">{{ ctx.cloudera_manager.ui_url_http }}</a> <span class="badge">VPC / admin</span></li>
          <li><strong>Cloudera Manager (direct HTTPS)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.cloudera_manager.ui_url_https }}">{{ ctx.cloudera_manager.ui_url_https }}</a> <span class="badge">:7183 on {{ ctx.cloudera_manager.host_fqdn }}</span></li>
          {% if ctx.identity.ipa_caddy_modern_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_modern_label | default('FreeIPA (modern UI)') }}</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.identity.ipa_caddy_modern_url }}">{{ ctx.identity.ipa_caddy_modern_url }}</a></li>
          {% endif %}
          {% if ctx.identity.ipa_caddy_legacy_url | default('') | length > 0 %}
          <li><strong>{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.identity.ipa_caddy_legacy_url }}">{{ ctx.identity.ipa_caddy_legacy_url }}</a></li>
          {% endif %}
          {% if ctx.identity.ipa_ui_url %}
          <li><strong>{{ ctx.identity.ipa_ui_label }} (HTTPS on ipaserver)</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.identity.ipa_ui_url }}">{{ ctx.identity.ipa_ui_url }}</a></li>
          {% endif %}
        </ul>
        <h2 class="section-title" style="margin-top:1rem">PostgreSQL</h2>
        <ul class="clean">
          <li>Host: <code>{{ ctx.postgresql.host_fqdn }}</code></li>
          <li>Port: <code>{{ ctx.postgresql.port }}</code></li>
          <li>{{ ctx.postgresql.database_host_note }}</li>
        </ul>
        <h2 class="section-title" style="margin-top:1rem">Clusters</h2>
        <ul class="clean">
          <li>CDP Runtime base cluster: <code>{{ ctx.cloudera_manager.cluster_name }}</code></li>
          {% if ctx.ecs.deployed %}
          <li>ECS cluster: <code>{{ ctx.ecs.cluster_name }}</code></li>
          <li>ECS app domain: <code>{{ ctx.ecs.app_domain }}</code></li>
          <li>ECS console — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.ecs.console_hint }}">{{ ctx.ecs.console_hint }}</a>{% if ctx.ecs.caddy_url | default('') | length > 0 %} <span class="badge">Caddy</span>{% endif %}</li>
          <li>ECS direct HTTPS — <a target="_blank" rel="noopener noreferrer" href="{{ ctx.ecs.console_url_direct | default('https://console.' ~ ctx.ecs.app_domain) }}">{{ ctx.ecs.console_url_direct | default('https://console.' ~ ctx.ecs.app_domain) }}</a></li>
          <li>Data Services hostnames: <code>{{ ctx.ecs.apps_wildcard }}</code></li>
          {% else %}
          <li>ECS: <span class="badge">not in inventory</span></li>
          {% endif %}
        </ul>
        <p class="sub">Versions — CM {{ ctx.versions.cm }} · CDP Runtime {{ ctx.versions.cdh }} · CDS {{ ctx.versions.ecs_cds }}</p>
        {% if ctx.data_services.links | length > 0 %}
        <h2 class="section-title" style="margin-top:1rem">Data services &amp; related URLs</h2>
        <ul class="clean">
          {% for link in ctx.data_services.links %}
          <li><strong>{{ link.name }}</strong>{% if link.description %} — {{ link.description }}{% endif %} — <a target="_blank" rel="noopener noreferrer" href="{{ link.url }}">{{ link.url }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if mon_on %}
        <h2 class="section-title" style="margin-top:1rem">Monitoring path fallbacks</h2>
        <ul class="clean">
          {% if ctx.monitoring.grafana_path_url | default('') | length > 0 %}
          <li>Grafana <a href="{{ ctx.monitoring.grafana_path_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.monitoring.grafana_path_url }}</a>;
            Prometheus <a href="{{ ctx.monitoring.prometheus_path_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.monitoring.prometheus_path_url }}</a>;
            Alertmanager <a href="{{ ctx.monitoring.alertmanager_path_url }}" target="_blank" rel="noopener noreferrer">{{ ctx.monitoring.alertmanager_path_url }}</a></li>
          {% endif %}
          <li>cAdvisor host port — <a href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">{{ cadvisor_tile_url }}</a></li>
        </ul>
        {% endif %}
        {% if ctx.extra_links | length > 0 %}
        <h2 class="section-title" style="margin-top:1rem">Additional links</h2>
        <ul class="clean">
          {% for link in ctx.extra_links %}
          <li><strong>{{ link.name }}</strong> — <a target="_blank" rel="noopener noreferrer" href="{{ link.url }}">{{ link.url }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </details>

    {% if ctx.inventory_hosts | default([]) | length > 0 %}
    <section class="flat">
      <h2>Host inventory</h2>
      <p class="sub">One row per host: Ansible groups, addresses, and inferred roles from inventory groups and enabled base-cluster services.</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Host</th>
              <th>FQDN</th>
              <th>Private IP</th>
              <th>Public IP</th>
              <th>Inventory groups</th>
              <th>Roles installed</th>
            </tr>
          </thead>
          <tbody>
            {% for h in ctx.inventory_hosts %}
            <tr>
              <td><code>{{ h.hostname }}</code> <span class="badge">{{ h.inventory_name }}</span></td>
              <td><code>{{ h.fqdn }}</code></td>
              <td><code>{{ h.private_ip }}</code></td>
              <td>{% if h.public_ip | default('') | length > 0 and ('{{' not in (h.public_ip | string)) %}<code>{{ h.public_ip }}</code>{% else %}<span class="badge">VPC only</span>{% endif %}</td>
              <td>
                {% for gl in h.group_labels | default(h.groups | default([])) %}
                <span class="group-tag">{{ gl }}</span>
                {% endfor %}
              </td>
              <td>
                {% for role in h.role_labels | default([]) %}
                <span class="role-badge">{{ role }}</span>
                {% endfor %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}
  </main>
</body>
</html>
