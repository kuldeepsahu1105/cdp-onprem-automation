{% set ctx = deployment_portal_context %}
{% set cm_tile_url = ctx.cloudera_manager.ui_url_https %}
{% set pgadmin_tile_url = ctx.portal.pgadmin_caddy_url | default('') if (ctx.portal.pgadmin_caddy_url | default('') | length > 0) else (ctx.portal.pgadmin_url_direct | default(ctx.portal.pgadmin_url | default(''))) %}
{% set ipa_modern_url = ctx.identity.ipa_caddy_modern_url | default('') if (ctx.identity.ipa_caddy_modern_url | default('') | length > 0) else (ctx.identity.ipa_caddy_url | default('')) %}
{% set ipa_legacy_caddy_url = ctx.identity.ipa_caddy_legacy_url | default('') %}
{% set ipa_tile_url = ipa_modern_url if (ipa_modern_url | length > 0) else (ctx.identity.ipa_ui_url | default('')) %}
{% set ecs_tile_url = ctx.ecs.console_hint | default('') if ctx.ecs.deployed else '' %}
{% set _portal_caddy_url = ctx.caddy_vhosts.urls_public.portal.url | default('') if (ctx.caddy_vhosts.enabled | default(false)) else '' %}
{% set portal_tile_url = _portal_caddy_url if (_portal_caddy_url | length > 0) else ctx.portal.index_url | default('') %}
{% set portal_tile_hint = ctx.caddy_vhosts.urls_public.portal.hostname if (_portal_caddy_url | length > 0) else 'Ops host Caddy index' %}
{% set mon_on = (
  (ctx.monitoring.enabled | default(false) | bool)
  or (ctx.monitoring.routes_enabled | default(false) | bool)
  or (deployment_portal_monitoring_routes_enabled | default(false) | bool)
  or (deployment_portal_monitoring_deployed | default(false) | bool)
  or (monitoring_stack_enabled | default(false) | bool)
) %}
{% set grafana_tile_url = ctx.monitoring.grafana_caddy_url | default('') if (ctx.monitoring.grafana_caddy_url | default('') | length > 0) else (ctx.monitoring.grafana_url | default(ctx.monitoring.grafana_path_url | default(''))) %}
{% set prometheus_tile_url = ctx.monitoring.prometheus_caddy_url | default('') if (ctx.monitoring.prometheus_caddy_url | default('') | length > 0) else (ctx.monitoring.prometheus_url | default(ctx.monitoring.prometheus_path_url | default(''))) %}
{% set alertmanager_tile_url = ctx.monitoring.alertmanager_caddy_url | default('') if (ctx.monitoring.alertmanager_caddy_url | default('') | length > 0) else (ctx.monitoring.alertmanager_url | default(ctx.monitoring.alertmanager_path_url | default(''))) %}
{% set cadvisor_tile_url = ctx.monitoring.cadvisor_url | default('') %}
{% if mon_on and (grafana_tile_url | length == 0) %}
{% set grafana_tile_url = ctx.monitoring.grafana_path_url | default(ctx.access.external.grafana | default(ctx.access.primary.grafana | default(''))) %}
{% endif %}
{% if mon_on and (prometheus_tile_url | length == 0) %}
{% set prometheus_tile_url = ctx.monitoring.prometheus_path_url | default(ctx.access.external.prometheus | default(ctx.access.primary.prometheus | default(''))) %}
{% endif %}
{% if mon_on and (alertmanager_tile_url | length == 0) %}
{% set alertmanager_tile_url = ctx.monitoring.alertmanager_path_url | default(ctx.access.external.alertmanager | default(ctx.access.primary.alertmanager | default(''))) %}
{% endif %}
{% if mon_on and (cadvisor_tile_url | length == 0) %}
{% set cadvisor_tile_url = ctx.access.external.cadvisor | default(ctx.access.primary.cadvisor | default('')) %}
{% endif %}
{% set panel_chevron %}<span class="panel-chevron" aria-hidden="true"><svg class="chevron-icon" viewBox="0 0 16 16" width="14" height="14" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endset %}
{% set ls = ctx.live_stats | default({}) %}
{% set ls_poll_prom = ls.poll.prometheus_query_path | default('') if ls.poll is defined else '' %}
{% set ns_ls = namespace(sgood=0, swarn=0, sbad=0) %}
{% for cl in ls.clusters | default([]) %}
{% set ns_ls.sgood = ns_ls.sgood + (cl.services_started_good | default(0) | int) %}
{% set ns_ls.swarn = ns_ls.swarn + (cl.services_concerning | default(0) | int) %}
{% set ns_ls.sbad = ns_ls.sbad + (cl.services_bad | default(0) | int) %}
{% endfor %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>CDP Deployment Portal — {{ ctx.cluster_domain }}</title>
  <style>
    :root {
      --bg: #0c1017;
      --bg-elevated: #121926;
      --card: #1a2332;
      --text: #e8edf4;
      --muted: #94a3b8;
      --accent: #f96702;
      --accent-soft: #5b9fd4;
      --border: #2d3a4d;
      --tile-hover: #243044;
      --max-w: 960px;
      --radius: 10px;
    }
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 0;
      line-height: 1.55;
    }
    a { color: #7ec8ff; text-decoration: none; }
    a:hover { text-decoration: underline; }
    code {
      background: #0b1018;
      padding: 0.12rem 0.4rem;
      border-radius: 4px;
      font-size: 0.85em;
      word-break: break-all;
    }
    .site-header {
      background: linear-gradient(135deg, #1a2332 0%, #0f1419 55%, #1a1208 100%);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem 1.25rem;
    }
    .site-header-inner {
      max-width: var(--max-w);
      margin: 0 auto;
    }
    .brand-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .brand-mark {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
    }
    .brand-mark svg { display: block; width: 100%; height: 100%; }
    h1 {
      font-size: 1.35rem;
      font-weight: 650;
      margin: 0;
      letter-spacing: -0.02em;
    }
    .brand-tag {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      font-weight: 600;
    }
    .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.85rem;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.2rem 0.65rem;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .chip strong { color: var(--text); font-weight: 600; margin-right: 0.25rem; }
    .wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1.25rem 1rem 2rem;
    }
    .sub {
      color: var(--muted);
      font-size: 0.88rem;
      margin: 0 0 0.75rem;
    }
    h2.section-title {
      font-size: 0.95rem;
      margin: 0;
      color: var(--accent-soft);
      font-weight: 600;
    }
    .quick-actions {
      margin-bottom: 1.25rem;
    }
    .quick-actions h2 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin: 0 0 0.65rem;
      font-weight: 600;
    }
    .tile-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
      grid-auto-rows: 1fr;
      gap: 0.65rem;
      align-items: stretch;
    }
    a.tile {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.2rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.9rem 0.95rem;
      color: var(--text);
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
      min-height: 6.5rem;
      min-width: 10.5rem;
      height: 100%;
    }
    a.tile:hover {
      background: var(--tile-hover);
      border-color: #3d4f66;
      text-decoration: none;
    }
    a.tile .tile-label {
      font-weight: 650;
      font-size: 0.95rem;
    }
    a.tile .tile-hint {
      font-size: 0.72rem;
      color: var(--muted);
      line-height: 1.35;
    }
    a.tile.tile-accent {
      border-color: rgba(249, 103, 2, 0.35);
    }
    details.panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 0.75rem;
      overflow: hidden;
    }
    details.panel > summary {
      cursor: pointer;
      padding: 0.85rem 1rem;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      user-select: none;
    }
    details.panel > summary::-webkit-details-marker { display: none; }
    details.panel > summary::marker { content: none; display: none; }
    details.panel > summary .summary-main {
      flex: 1;
      min-width: 0;
    }
    details.panel > summary .panel-chevron {
      flex-shrink: 0;
      color: var(--muted);
      line-height: 1;
      transition: transform 0.15s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    details.panel > summary .panel-chevron .chevron-icon { display: block; }
    details.panel[open] > summary .panel-chevron { transform: rotate(90deg); }
    details.panel > summary:hover { background: rgba(255, 255, 255, 0.03); }
    .panel-body {
      padding: 0 1rem 1rem;
      border-top: 1px solid var(--border);
    }
    section.flat {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.1rem;
      margin-bottom: 0.75rem;
    }
    section.flat h2 {
      font-size: 0.95rem;
      margin: 0 0 0.75rem;
      color: var(--accent-soft);
      font-weight: 600;
    }
    ul.clean {
      margin: 0;
      padding-left: 1.15rem;
    }
    ul.clean li { margin: 0.4rem 0; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    th, td {
      text-align: left;
      padding: 0.45rem 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    th { color: var(--muted); font-weight: 600; }
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .badge {
      display: inline-block;
      background: #243044;
      color: var(--muted);
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      font-size: 0.72rem;
      margin-left: 0.3rem;
      vertical-align: middle;
    }
    .role-badge {
      display: inline-block;
      background: rgba(91, 159, 212, 0.15);
      border: 1px solid rgba(91, 159, 212, 0.35);
      color: #b8d4f0;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      font-size: 0.7rem;
      margin: 0.12rem 0.2rem 0.12rem 0;
      white-space: nowrap;
    }
    .group-tag {
      display: inline-block;
      font-size: 0.72rem;
      color: var(--muted);
      margin-right: 0.35rem;
    }
    .live-stats { margin-bottom: 1.25rem; }
    .live-stats-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.65rem;
    }
    .live-stats-head h2 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin: 0;
      font-weight: 600;
    }
    .live-stats-updated {
      font-size: 0.72rem;
      color: var(--muted);
    }
    .kpi-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }
    .kpi {
      flex: 1 1 7.5rem;
      min-width: 7rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.65rem 0.75rem;
    }
    .kpi .kpi-label {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
    }
    .kpi .kpi-val {
      font-size: 1.45rem;
      font-weight: 700;
      margin-top: 0.1rem;
      line-height: 1.15;
    }
    .kpi .kpi-sub {
      font-size: 0.68rem;
      color: var(--muted);
      margin-top: 0.15rem;
    }
    .kpi.kpi-pass .kpi-val { color: #4ade80; }
    .kpi.kpi-warn .kpi-val { color: #fbbf24; }
    .kpi.kpi-fail .kpi-val { color: #f87171; }
    .kpi.kpi-accent .kpi-val { color: var(--accent); }
    .kpi.kpi-info .kpi-val { color: var(--accent-soft); }
    .live-note {
      font-size: 0.78rem;
      color: var(--muted);
      margin: 0.65rem 0 0;
      line-height: 1.45;
    }
    .health-pill {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 600;
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .health-pill.good { background: rgba(74, 222, 128, 0.15); color: #4ade80; }
    .health-pill.concerning { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }
    .health-pill.bad { background: rgba(248, 113, 113, 0.15); color: #f87171; }
    .health-pill.na { background: #243044; color: var(--muted); }
    @media (max-width: 480px) {
      .site-header { padding: 0.85rem 1rem; }
      h1 { font-size: 1.15rem; }
      .wrap { padding: 1rem 0.75rem 1.5rem; }
      .tile-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="site-header-inner">
      <div class="brand-row">
        <div class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" role="img">
            <rect width="40" height="40" rx="8" fill="#1a2332"/>
            <path d="M8 28 L20 10 L32 28 Z" fill="none" stroke="#f96702" stroke-width="2.2" stroke-linejoin="round"/>
            <circle cx="20" cy="22" r="3" fill="#5b9fd4"/>
          </svg>
        </div>
        <div>
          <div class="brand-tag">Cloudera Data Platform</div>
          <h1>Deployment portal</h1>
        </div>
      </div>
      <div class="meta-row">
        <span class="chip"><strong>Domain</strong> {{ ctx.cluster_domain }}</span>
        <span class="chip"><strong>Realm</strong> {{ ctx.cluster_realm }}</span>
        <span class="chip"><strong>Identity</strong> {{ ctx.identity_provider }}</span>
        <span class="chip"><strong>Access</strong> {{ ctx.access.profile }} ({{ ctx.access.environment }})</span>
        <span class="chip"><strong>Generated</strong> {{ ctx.generated_at }}</span>
      </div>
    </div>
  </header>

  <main class="wrap">
    <nav class="quick-actions" aria-label="Primary services">
      <h2>Quick open</h2>
      <div class="tile-grid">
        {% if cm_tile_url | length > 0 %}
        <a class="tile tile-accent" href="{{ cm_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Cloudera Manager</span>
          <span class="tile-hint">Cluster admin UI</span>
        </a>
        {% endif %}
        {% if ctx.portal.pgadmin_url | default(pgadmin_tile_url | default('')) | length > 0 %}
        <a class="tile" href="{{ ctx.portal.pgadmin_url | default(pgadmin_tile_url) }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">pgAdmin</span>
          <span class="tile-hint">CM PostgreSQL{% if ctx.portal.pgadmin_caddy_url | default('') | length > 0 %} (Caddy){% endif %}</span>
        </a>
        {% endif %}
        {% if mon_on %}
        <a class="tile" href="{{ grafana_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Grafana</span>
          <span class="tile-hint">{% if ctx.monitoring.grafana_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_grafana_host_port | default(3000) }}{% endif %}</span>
        </a>
        <a class="tile" href="{{ prometheus_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Prometheus</span>
          <span class="tile-hint">{% if ctx.monitoring.prometheus_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_prometheus_host_port | default(9090) }}{% endif %}</span>
        </a>
        <a class="tile" href="{{ alertmanager_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">Alertmanager</span>
          <span class="tile-hint">{% if ctx.monitoring.alertmanager_caddy_url | default('') | length > 0 %}Caddy vhost{% else %}Host :{{ monitoring_alertmanager_host_port | default(9093) }}{% endif %}</span>
        </a>
        <a class="tile" href="{{ cadvisor_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">cAdvisor</span>
          <span class="tile-hint">Container metrics (host :{{ monitoring_cadvisor_host_port | default(8089) }})</span>
        </a>
        {% endif %}
        {% if ipa_tile_url | length > 0 %}
        <a class="tile" href="{{ ipa_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_modern_label | default(ctx.identity.ipa_ui_label) }}</span>
          <span class="tile-hint">Identity management (default)</span>
        </a>
        {% endif %}
        {% if ipa_legacy_caddy_url | length > 0 %}
        <a class="tile" href="{{ ipa_legacy_caddy_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (legacy UI)') }}</span>
          <span class="tile-hint">Classic Web UI</span>
        </a>
        {% elif ctx.identity.ipa_ui_url | default('') | length > 0 and ipa_tile_url != ctx.identity.ipa_ui_url %}
        <a class="tile" href="{{ ctx.identity.ipa_ui_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">{{ ctx.identity.ipa_ui_legacy_label | default('FreeIPA (direct HTTPS)') }}</span>
          <span class="tile-hint">{{ ctx.identity.ipa_ui_url }}</span>
        </a>
        {% endif %}
        {% if ecs_tile_url | length > 0 %}
        <a class="tile" href="{{ ecs_tile_url }}" target="_blank" rel="noopener noreferrer">
          <span class="tile-label">ECS</span>
          <span class="tile-hint">{% if ctx.ecs.deployed %}{{ ctx.ecs.cluster_name }}{% else %}Console{% endif %}</span>
        </a>
        {% endif %}
        {% if portal_tile_url | length > 0 %}
        <a class="tile tile-accent" target="_blank" rel="noopener noreferrer" href="{{ portal_tile_url }}">
          <span class="tile-label">Deployment portal</span>
          <span class="tile-hint">{{ portal_tile_hint }}</span>
        </a>
        {% endif %}
      </div>
    </nav>

    <section class="live-stats" id="live-stats" aria-label="Cluster health snapshot">
      <div class="live-stats-head">
        <h2>Health snapshot</h2>
        <span class="live-stats-updated" id="live-stats-updated">
          {% if ls.collected_at | default('') | length > 0 %}CM snapshot {{ ls.collected_at }}{% else %}Awaiting data{% endif %}
        </span>
      </div>
      <div class="kpi-grid" id="live-stats-kpis">
        <div class="kpi kpi-info" data-kpi="hosts-total">
          <div class="kpi-label">CM hosts</div>
          <div class="kpi-val">{{ ls.hosts.total | default(ls.inventory_host_count | default('—')) }}</div>
          <div class="kpi-sub" data-kpi-sub="hosts-heartbeat">{% if ls.hosts.good is defined %}{{ ls.hosts.good }}/{{ ls.hosts.total }} GOOD{% else %}inventory {{ ls.inventory_host_count | default('—') }}{% endif %}</div>
        </div>
        <div class="kpi kpi-pass" data-kpi="services-good">
          <div class="kpi-label">Services GOOD</div>
          <div class="kpi-val" id="kpi-services-good">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.sgood }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">STARTED+GOOD across clusters</div>
        </div>
        <div class="kpi kpi-warn" data-kpi="services-warn">
          <div class="kpi-label">CONCERNING</div>
          <div class="kpi-val" id="kpi-services-warn">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.swarn }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">CM service health</div>
        </div>
        <div class="kpi kpi-fail" data-kpi="services-bad">
          <div class="kpi-label">BAD</div>
          <div class="kpi-val" id="kpi-services-bad">{% if ls.clusters | default([]) | length > 0 %}{{ ns_ls.sbad }}{% else %}—{% endif %}</div>
          <div class="kpi-sub">CM service health</div>
        </div>
        {% if mon_on %}
        <div class="kpi kpi-accent" data-kpi="prom-up">
          <div class="kpi-label">Prometheus UP</div>
          <div class="kpi-val" id="kpi-prom-up">—</div>
          <div class="kpi-sub" data-kpi-sub="prom-detail">{% if ls_poll_prom | length > 0 %}live poll{% else %}enable path routes{% endif %}</div>
        </div>
        {% endif %}
        <div class="kpi kpi-info" data-kpi="parcels">
          <div class="kpi-label">Parcels</div>
          <div class="kpi-val" id="kpi-parcels">{{ ls.parcels | default([]) | length }}</div>
          <div class="kpi-sub">ACTIVATED</div>
        </div>
      </div>
      <p class="live-note" id="live-stats-note">
        {% if ls.cm_api_available | default(false) %}
        Service health, host heartbeats, and parcels are captured from the Cloudera Manager API during <code>35_refresh_deployment_portal.yml</code> (not live in the browser).
        {% else %}
        Cloudera Manager API snapshot unavailable from Ansible — counts fall back to inventory. Re-run portal refresh after CM is up.
        {% endif %}
        {% if mon_on and ls_poll_prom | length > 0 %}
        Prometheus target count refreshes every 60s on the ops-host portal URL (same origin, path <code>/prometheus</code>).
        {% elif mon_on %}
        Open the portal via the ops host port (not the portal-only lab vhost) for in-browser Prometheus polls.
        {% endif %}
      </p>
      {% if ls.clusters | default([]) | length > 0 %}
      <details class="panel" style="margin-top:0.75rem">
        <summary><span class="summary-main"><h2 class="section-title">Service health (CM snapshot)</h2></span>{{ panel_chevron | safe }}</summary>
        <div class="panel-body">
          <div class="table-scroll">
            <table id="live-stats-services-table">
              <thead>
                <tr>
                  <th>Cluster</th>
                  <th>Service</th>
