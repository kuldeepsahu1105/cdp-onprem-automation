{# YAML list: one row per inventory host (union of deployment_portal_inventory_groups) #}
{% from 'deployment_portal_resolve_public_ip.inc.j2' import resolve_deployment_portal_public_ip %}
{% from 'deployment_portal_ssh_command.inc.j2' import portal_ssh_command %}
{% set _ssh_user = deployment_ssh_user | default(ansible_user | default('ec2-user')) %}
{% set _ssh_key = deployment_portal_ssh_download_basename | default('cluster-access.pem') %}
{% set _anchor_inv = groups[deployment_portal_host_group_effective][0] %}
{% set _postgres_inv = deployment_portal_postgres_inv | default('') %}
{% set _knox = base_cluster_install_services.knox | default(false) | bool %}
{% set _svc = base_cluster_install_services | default({}) %}
{% set _mon = (monitoring_stack_enabled | default(false) | bool) or (deployment_portal_monitoring_deployed | default(false) | bool) or (deployment_portal_monitoring_routes_enabled | default(false) | bool) %}
{% set _seen = namespace(hosts=[]) %}
{% for group_name in deployment_portal_inventory_groups %}
{% for inv_host in groups.get(group_name, []) %}
{% if inv_host not in _seen.hosts %}
{% set _ = _seen.hosts.append(inv_host) %}
{% set _hv = hostvars[inv_host] %}
{% set _priv = _hv.private_ip | default(_hv.ansible_host | default('')) %}
{% set _ah = _hv.ansible_host | default('') %}
{% set _public = resolve_deployment_portal_public_ip(_hv, _priv, _ah, inv_host, _anchor_inv) %}
{% set _groups = [] %}
{% for gn in deployment_portal_inventory_groups %}
{% if inv_host in groups.get(gn, []) %}
{% set _ = _groups.append(gn) %}
{% endif %}
{% endfor %}
{% set _roles = [] %}
{% if inv_host in groups.get('ipaserver', []) or inv_host in groups.get('ipa_server', []) %}
{% if 'FreeIPA server' not in _roles %}{% set _ = _roles.append('FreeIPA server') %}{% endif %}
{% endif %}
{% if inv_host == _anchor_inv %}
{% if 'Portal / Caddy (reverse proxy)' not in _roles %}{% set _ = _roles.append('Portal / Caddy (reverse proxy)') %}{% endif %}
{% if 'pgAdmin (container)' not in _roles %}{% set _ = _roles.append('pgAdmin (container)') %}{% endif %}
{% if _mon and 'Grafana (container)' not in _roles %}{% set _ = _roles.append('Grafana (container)') %}{% endif %}
{% if _mon and 'Prometheus (container)' not in _roles %}{% set _ = _roles.append('Prometheus (container)') %}{% endif %}
{% if _mon and 'Alertmanager (container)' not in _roles %}{% set _ = _roles.append('Alertmanager (container)') %}{% endif %}
{% if _mon and 'cAdvisor (container metrics)' not in _roles %}{% set _ = _roles.append('cAdvisor (container metrics)') %}{% endif %}
{% if 'Docker (portal stack)' not in _roles %}{% set _ = _roles.append('Docker (portal stack)') %}{% endif %}
{% endif %}
{% if inv_host == _postgres_inv and 'PostgreSQL (CM DB)' not in _roles %}
{% set _ = _roles.append('PostgreSQL (CM DB)') %}
{% endif %}
{% if inv_host in groups.get('cldr-mngr', []) %}
{% if 'Cloudera Manager server' not in _roles %}{% set _ = _roles.append('Cloudera Manager server') %}{% endif %}
{% endif %}
{% if inv_host in groups.get('base-masters', []) or inv_host in groups.get('base-workers', []) or inv_host in groups.get('ecs-masters', []) or inv_host in groups.get('ecs-workers', []) %}
{% if 'CM agent' not in _roles %}{% set _ = _roles.append('CM agent') %}{% endif %}
{% endif %}
{% if inv_host in groups.get('ecs-masters', []) %}
{% if 'ECS master' not in _roles %}{% set _ = _roles.append('ECS master') %}{% endif %}
{% if 'Docker (ECS)' not in _roles %}{% set _ = _roles.append('Docker (ECS)') %}{% endif %}
{% endif %}
{% if inv_host in groups.get('ecs-workers', []) %}
{% if 'ECS worker' not in _roles %}{% set _ = _roles.append('ECS worker') %}{% endif %}
{% if 'Docker (ECS agent)' not in _roles %}{% set _ = _roles.append('Docker (ECS agent)') %}{% endif %}
{% endif %}
{% set _ht = (_hv.host_template | default(_hv.cldr_host_template | default('')) | string) | trim | lower %}
{% if _ht == 'master' and 'CDP Runtime master (host template)' not in _roles %}
{% set _ = _roles.append('CDP Runtime master (host template)') %}
{% elif _ht == 'worker' and 'CDP Runtime worker (host template)' not in _roles %}
{% set _ = _roles.append('CDP Runtime worker (host template)') %}
{% elif _ht in ['ecs_master', 'ecs-master'] and 'ECS master (host template)' not in _roles %}
{% set _ = _roles.append('ECS master (host template)') %}
{% elif _ht in ['ecs_workers', 'ecs_workers', 'ecs-worker'] and 'ECS worker (host template)' not in _roles %}
{% set _ = _roles.append('ECS worker (host template)') %}
{% endif %}
{% if inv_host in groups.get('base-masters', []) %}
{% if _svc.hdfs | default(true) | bool and 'HDFS NameNode' not in _roles %}{% set _ = _roles.append('HDFS NameNode') %}{% endif %}
{% if _svc.yarn | default(true) | bool and 'YARN ResourceManager' not in _roles %}{% set _ = _roles.append('YARN ResourceManager') %}{% endif %}
{% if _svc.hbase | default(true) | bool and 'HBase Master' not in _roles %}{% set _ = _roles.append('HBase Master') %}{% endif %}
{% if _svc.ozone | default(true) | bool and 'Ozone' not in _roles %}{% set _ = _roles.append('Ozone') %}{% endif %}
{% if (_svc.hive | default(true) | bool or _svc.hive_on_tez | default(true) | bool) and 'Hive' not in _roles %}{% set _ = _roles.append('Hive') %}{% endif %}
{% if _svc.impala | default(true) | bool and 'Impala' not in _roles %}{% set _ = _roles.append('Impala') %}{% endif %}
{% if _svc.kafka | default(true) | bool and 'Kafka' not in _roles %}{% set _ = _roles.append('Kafka') %}{% endif %}
{% if _svc.ranger | default(true) | bool and 'Ranger' not in _roles %}{% set _ = _roles.append('Ranger') %}{% endif %}
{% if _svc.hue | default(false) | bool and 'Hue' not in _roles %}{% set _ = _roles.append('Hue') %}{% endif %}
{% if _svc.zookeeper | default(true) | bool and 'ZooKeeper' not in _roles %}{% set _ = _roles.append('ZooKeeper') %}{% endif %}
{% endif %}
{% if inv_host in groups.get('base-workers', []) %}
{% if _svc.hdfs | default(true) | bool and 'HDFS DataNode' not in _roles %}{% set _ = _roles.append('HDFS DataNode') %}{% endif %}
{% if _svc.yarn | default(true) | bool and 'YARN NodeManager' not in _roles %}{% set _ = _roles.append('YARN NodeManager') %}{% endif %}
{% if _svc.hbase | default(true) | bool and 'HBase RegionServer' not in _roles %}{% set _ = _roles.append('HBase RegionServer') %}{% endif %}
{% if _svc.ozone | default(true) | bool and 'Ozone' not in _roles %}{% set _ = _roles.append('Ozone') %}{% endif %}
{% if _svc.zookeeper | default(true) | bool and 'ZooKeeper' not in _roles %}{% set _ = _roles.append('ZooKeeper') %}{% endif %}
{% endif %}
{% set _knox_host = _hv.knox_gateway | default(_hv.knox | default(false)) | bool %}
{% if (_knox or _knox_host) and inv_host in groups.get('base-masters', []) %}
{% if 'Knox gateway' not in _roles %}{% set _ = _roles.append('Knox gateway') %}{% endif %}
{% endif %}
{% set _group_labels = [] %}
{% for gn in _groups %}
{% set _gl = deployment_portal_inventory_group_labels.get(gn, gn) %}
{% if _gl not in _group_labels %}
{% set _ = _group_labels.append(_gl) %}
{% endif %}
{% endfor %}
- inventory_name: "{{ inv_host }}"
  hostname: "{{ _hv.cldr_hostname | default(inv_host) }}"
  fqdn: "{{ _hv.cldr_hostname | default(inv_host) }}.{{ cluster_domain }}"
  ansible_host: "{{ _ah }}"
  private_ip: "{{ _priv }}"
  public_ip: "{{ _public }}"
  groups: {{ _groups | to_json }}
  group_labels: {{ _group_labels | to_json }}
  role_labels: {{ _roles | to_json }}
  ssh_user: "{{ _ssh_user }}"
  ssh_command: "{{ portal_ssh_command(_ssh_user, _ssh_key, _hv, inv_host, cluster_domain) }}"
{% endif %}
{% endfor %}
{% endfor %}
