{# YAML list: one row per inventory host (union of deployment_portal_inventory_groups) #}
{% from 'deployment_portal_resolve_public_ip.inc.j2' import resolve_deployment_portal_public_ip %}
{% set _anchor_inv = groups[deployment_portal_host_group_effective][0] %}
{% set _postgres_inv = deployment_portal_postgres_inv | default('') %}
{% set _knox = base_cluster_install_services.knox | default(false) | bool %}
{% set _svc = base_cluster_install_services | default({}) %}
{% set _mon = (monitoring_stack_enabled | default(false) | bool) or (deployment_portal_monitoring_deployed | default(false) | bool) %}
{% set _seen = namespace(hosts=[]) %}
{% for group_name in deployment_portal_inventory_groups %}
{% for inv_host in groups.get(group_name, []) %}
{% if inv_host not in _seen.hosts %}
{% set _ = _seen.hosts.append(inv_host) %}
{% set _hv = hostvars[inv_host] %}
{% set _priv = _hv.private_ip | default(_hv.ansible_host | default('')) %}
{% set _ah = _hv.ansible_host | default('') %}
{% set _public = resolve_deployment_portal_public_ip(_hv, _priv, _ah, inv_host, _anchor_inv) %}
{% set _groups = [] %}
{% for gn in deployment_portal_inventory_groups %}
{% if inv_host in groups.get(gn, []) %}
{% set _ = _groups.append(gn) %}
{% endif %}
{% endfor %}
{% set _roles = [] %}
{% for gn in _groups %}
{% set _label = deployment_portal_inventory_group_labels.get(gn, gn) %}
{% if _label not in _roles %}
{% set _ = _roles.append(_label) %}
{% endif %}
{% endfor %}
{% if inv_host == _anchor_inv %}
{% if 'Portal / Caddy (reverse proxy)' not in _roles %}
{% set _ = _roles.append('Portal / Caddy (reverse proxy)') %}
{% endif %}
{% if 'pgAdmin (container)' not in _roles %}
{% set _ = _roles.append('pgAdmin (container)') %}
{% endif %}
{% if _mon and 'cAdvisor (container metrics)' not in _roles %}
{% set _ = _roles.append('cAdvisor (container metrics)') %}
{% endif %}
{% if 'Docker (portal stack)' not in _roles %}
{% set _ = _roles.append('Docker (portal stack)') %}
{% endif %}
{% endif %}
{% if inv_host == _postgres_inv and 'PostgreSQL (CM DB)' not in _roles %}
{% set _ = _roles.append('PostgreSQL (CM DB)') %}
{% endif %}
{% if inv_host in groups.get('cldr-mngr', []) %}
{% if 'Cloudera Manager server' not in _roles %}
{% set _ = _roles.append('Cloudera Manager server') %}
{% endif %}
{% endif %}
{% if inv_host in groups.get('base-masters', []) or inv_host in groups.get('base-workers', []) %}
{% if 'CM agent' not in _roles %}
{% set _ = _roles.append('CM agent') %}
{% endif %}
{% endif %}
{% if inv_host in groups.get('ecs-masters', []) or inv_host in groups.get('ecs-workers', []) %}
{% if 'CM agent' not in _roles %}
{% set _ = _roles.append('CM agent') %}
{% endif %}
{% endif %}
{% if inv_host in groups.get('base-masters', []) %}
{% if _svc.hdfs | default(true) | bool and 'HDFS NameNode' not in _roles %}
{% set _ = _roles.append('HDFS NameNode') %}
{% endif %}
{% if _svc.yarn | default(true) | bool and 'YARN ResourceManager' not in _roles %}
{% set _ = _roles.append('YARN ResourceManager') %}
{% endif %}
{% if _svc.hbase | default(true) | bool and 'HBase Master' not in _roles %}
{% set _ = _roles.append('HBase Master') %}
{% endif %}
{% if _svc.hue | default(false) | bool and 'Hue' not in _roles %}
{% set _ = _roles.append('Hue') %}
{% endif %}
{% endif %}
{% if inv_host in groups.get('base-workers', []) %}
{% if _svc.hdfs | default(true) | bool and 'HDFS DataNode' not in _roles %}
{% set _ = _roles.append('HDFS DataNode') %}
{% endif %}
{% if _svc.yarn | default(true) | bool and 'YARN NodeManager' not in _roles %}
{% set _ = _roles.append('YARN NodeManager') %}
{% endif %}
{% endif %}
{% if _knox and inv_host in groups.get('base-masters', []) %}
{% if 'Knox gateway' not in _roles %}
{% set _ = _roles.append('Knox gateway') %}
{% endif %}
{% endif %}
{% set _group_labels = [] %}
{% for gn in _groups %}
{% set _gl = deployment_portal_inventory_group_labels.get(gn, gn) %}
{% if _gl not in _group_labels %}
{% set _ = _group_labels.append(_gl) %}
{% endif %}
{% endfor %}
- inventory_name: "{{ inv_host }}"
  hostname: "{{ _hv.cldr_hostname | default(inv_host) }}"
  fqdn: "{{ _hv.cldr_hostname | default(inv_host) }}.{{ cluster_domain }}"
  ansible_host: "{{ _ah }}"
  private_ip: "{{ _priv }}"
  public_ip: "{{ _public }}"
  groups: {{ _groups | to_json }}
  group_labels: {{ _group_labels | to_json }}
  role_labels: {{ _roles | to_json }}
{% endif %}
{% endfor %}
{% endfor %}
