{# Portal endpoint display: primary URL followed by distinct public/private alternatives. #}
{# Imported macros do not inherit caller template context — pass cluster_domain / caddy base explicitly. #}
{% macro portal_url_host_from_url(url) -%}
{%- set _u = url | default('') | trim -%}
{{- _u | regex_replace('^https?://', '') | regex_replace('/.*', '') | regex_replace(':.*', '') | lower -}}
{%- endmacro %}

{% macro portal_url_is_caddy_lab(url, caddy_public_base='') -%}
{%- set _host = portal_url_host_from_url(url) -%}
{%- set _base = (caddy_public_base | default('pvc.cloudera-labs.com') | string) | trim | lower -%}
{%- if _host | length == 0 -%}
false
{%- elif _base | length > 0 and (_host == _base or _host.endswith('.' ~ _base)) -%}
true
{%- elif _host.endswith('.nip.io') -%}
true
{%- else -%}
false
{%- endif -%}
{%- endmacro %}

{% macro portal_url_is_cluster_fqdn(url, cluster_domain) -%}
{%- set _host = portal_url_host_from_url(url) -%}
{%- set _dom = (cluster_domain | default('') | string) | trim | lower -%}
{%- if _host | length == 0 or _dom | length == 0 -%}
false
{%- elif _host == _dom or _host.endswith('.' ~ _dom) -%}
true
{%- else -%}
false
{%- endif -%}
{%- endmacro %}

{% macro portal_url_resolve_port(url, explicit_port, scheme) -%}
{%- set _port = explicit_port | default('') | string | trim -%}
{%- if _port | length > 0 -%}
{{- _port -}}
{%- else -%}
{%- set _u = url | default('') | trim -%}
{%- if '://' not in _u -%}
{%- elif (':' in (_u.split('://', 1)[1].split('/')[0])) -%}
{{- _u.split('://', 1)[1].split('/')[0].split(':', 1)[1] -}}
{%- elif (scheme | default('https') | trim | lower) == 'https' -%}
443
{%- elif (scheme | default('https') | trim | lower) == 'http' -%}
80
{%- endif -%}
{%- endif -%}
{%- endmacro %}

{% macro portal_url_fqdn_pubip(url, public_ip, port, scheme='https', private_ip='', cluster_domain='', caddy_public_base='') -%}
{%- set _url = url | default('') | trim -%}
{%- set _scheme = scheme | default('https') | trim -%}
{%- set _port %}{{ portal_url_resolve_port(_url, port, _scheme) }}{% endset -%}
{%- set _port = _port | trim -%}
{%- set _dom = cluster_domain | default('') | string | trim -%}
{%- if _url | length == 0 -%}
{%- else -%}
{%- set _is_caddy %}{{ portal_url_is_caddy_lab(_url, caddy_public_base) }}{% endset -%}
{%- set _is_caddy = _is_caddy | trim -%}
{%- set _is_cluster %}{{ portal_url_is_cluster_fqdn(_url, _dom) }}{% endset -%}
{%- set _is_cluster = _is_cluster | trim -%}
{%- if _is_caddy == 'true' -%}
<a href="{{ _url }}" target="_blank" rel="noopener noreferrer">{{ _url }}</a>
{%- elif _is_cluster == 'true' -%}
{%- set _authority_and_path = _url.split('://', 1)[1] if '://' in _url else '' -%}
{%- set _path = '/' ~ _authority_and_path.split('/', 1)[1] if '/' in _authority_and_path else '' -%}
<a href="{{ _url }}" target="_blank" rel="noopener noreferrer">{{ _url }}</a>
{%- set _pub = public_ip | default('') | trim -%}
{%- set _priv = private_ip | default('') | trim -%}
{%- if _pub | length > 0 and ('{{' not in _pub) and _port | length > 0 -%}
{%- set _public_url = _scheme ~ '://' ~ _pub ~ ':' ~ _port ~ _path -%}
 <span class="url-alternative">(public: <a href="{{ _public_url }}" target="_blank" rel="noopener noreferrer">{{ _public_url }}</a>)</span>
{%- endif -%}
{%- if _priv | length > 0 and ('{{' not in _priv) and _priv != _pub and _port | length > 0 -%}
{%- set _private_url = _scheme ~ '://' ~ _priv ~ ':' ~ _port ~ _path -%}
 <span class="url-alternative">(private: <a href="{{ _private_url }}" target="_blank" rel="noopener noreferrer">{{ _private_url }}</a>)</span>
{%- endif -%}
{%- else -%}
<a href="{{ _url }}" target="_blank" rel="noopener noreferrer">{{ _url }}</a>
{%- endif -%}
{%- endif -%}
{%- endmacro %}

{% macro portal_url_bundle(primary_url, public_url='', private_url='') -%}
{%- set _primary = primary_url | default('') | trim -%}
{%- set _public = public_url | default('') | trim -%}
{%- set _private = private_url | default('') | trim -%}
{%- if _primary | length > 0 -%}
<a href="{{ _primary }}" target="_blank" rel="noopener noreferrer">{{ _primary }}</a>
{%- endif -%}
{%- if _public | length > 0 and _public != _primary -%}
 <span class="url-alternative">(public: <a href="{{ _public }}" target="_blank" rel="noopener noreferrer">{{ _public }}</a>)</span>
{%- endif -%}
{%- if _private | length > 0 and _private != _primary and _private != _public -%}
 <span class="url-alternative">(private: <a href="{{ _private }}" target="_blank" rel="noopener noreferrer">{{ _private }}</a>)</span>
{%- endif -%}
{%- if _primary | length == 0 and _public | length == 0 and _private | length == 0 -%}
<span class="badge">—</span>
{%- endif -%}
{%- endmacro %}

{% macro inventory_public_ip_for_fqdn(ctx, fqdn) -%}
{%- set _fqdn = fqdn | default('') | trim | lower -%}
{%- set _out = namespace(ip='') -%}
{%- for h in ctx.inventory_hosts | default([]) -%}
{%- if _out.ip | length == 0 and (_fqdn | length > 0) and (h.fqdn | default('') | trim | lower == _fqdn) -%}
{%- set _out.ip = h.public_ip | default('') | trim -%}
{%- endif -%}
{%- endfor -%}
{{- _out.ip -}}
{%- endmacro %}

{% macro inventory_private_ip_for_fqdn(ctx, fqdn) -%}
{%- set _fqdn = fqdn | default('') | trim | lower -%}
{%- set _out = namespace(ip='') -%}
{%- for h in ctx.inventory_hosts | default([]) -%}
{%- if _out.ip | length == 0 and (_fqdn | length > 0) and (h.fqdn | default('') | trim | lower == _fqdn) -%}
{%- set _out.ip = h.private_ip | default('') | trim -%}
{%- endif -%}
{%- endfor -%}
{{- _out.ip -}}
{%- endmacro %}

{% macro portal_url_for_context(url, ctx) -%}
{%- set _url = url | default('') | trim -%}
{%- set _host = portal_url_host_from_url(_url) | trim -%}
{%- set _pub = inventory_public_ip_for_fqdn(ctx, _host) | trim -%}
{%- set _priv = inventory_private_ip_for_fqdn(ctx, _host) | trim -%}
{%- set _scheme = _url.split('://', 1)[0] if '://' in _url else 'https' -%}
{{ portal_url_fqdn_pubip(
  _url,
  _pub,
  '',
  _scheme,
  _priv,
  ctx.cluster_domain | default(''),
  ctx.caddy_vhosts.public_base | default('pvc.cloudera-labs.com')
) }}
{%- endmacro %}

{% macro portal_jdbc_for_context(url, ctx) -%}
{%- set _url = url | default('') | trim -%}
{%- set _without_scheme = _url | regex_replace('^jdbc:[^:]+://', '') -%}
{%- set _host = _without_scheme.split('/', 1)[0].split(':', 1)[0] | lower -%}
{%- set _pub = inventory_public_ip_for_fqdn(ctx, _host) | trim -%}
{%- set _priv = inventory_private_ip_for_fqdn(ctx, _host) | trim -%}
{%- if _url | length > 0 -%}
<code>{{ _url }}</code>
{%- if _pub | length > 0 and ('{{' not in _pub) -%}
 <span class="url-alternative">(public: <code>{{ _url | replace(_host, _pub, 1) }}</code>)</span>
{%- endif -%}
{%- if _priv | length > 0 and ('{{' not in _priv) and _priv != _pub -%}
 <span class="url-alternative">(private: <code>{{ _url | replace(_host, _priv, 1) }}</code>)</span>
{%- endif -%}
{%- endif -%}
{%- endmacro %}

{% macro portal_url_fqdn_pubip_cm(ctx, url, port, scheme) -%}
{%- set _cluster_dom = ctx.cluster_domain | default('') | string | trim -%}
{%- set _caddy_base = ctx.caddy_vhosts.public_base | default('pvc.cloudera-labs.com') | string | trim -%}
{{ portal_url_fqdn_pubip(
  url,
  ctx.cloudera_manager.public_ip | default(''),
  port,
  scheme,
  ctx.cloudera_manager.private_ip | default(''),
  _cluster_dom,
  _caddy_base
) }}
{%- endmacro %}
