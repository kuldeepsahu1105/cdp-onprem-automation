# Ansible-managed Docker Compose environment for the deployment portal stack.
# Edit group_vars / vault and re-run Jenkins PORTAL (plays 10/35); do not hand-edit on the ops host.
DEPLOYMENT_PORTAL_CONFIG_DIR={{ deployment_portal_config_dir }}
DEPLOYMENT_PORTAL_WWW_DIR={{ deployment_portal_www_dir }}
DEPLOYMENT_PORTAL_HTTP_PORT={{ deployment_portal_http_port }}
DEPLOYMENT_PORTAL_PGADMIN_HOST_PORT={{ deployment_portal_pgadmin_host_port }}
DEPLOYMENT_PORTAL_CADDY_IMAGE={{ deployment_portal_caddy_image }}
DEPLOYMENT_PORTAL_CADDY_CONTAINER={{ deployment_portal_caddy_container }}
DEPLOYMENT_PORTAL_PGADMIN_IMAGE={{ deployment_portal_pgadmin_image }}
DEPLOYMENT_PORTAL_PGADMIN_CONTAINER={{ deployment_portal_pgadmin_container }}
PGADMIN_DEFAULT_EMAIL={{ pgadmin_default_email | trim | quote }}
PGADMIN_DEFAULT_PASSWORD={{ pgadmin_default_password | trim | quote }}
