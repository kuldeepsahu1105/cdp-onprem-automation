# Managed by Ansible — suppress mod_auth_gssapi SPNEGO on protected IPA API routes.
# ANSIBLE_IPA_DISABLE_BROWSER_KRB — use forms/password login via Caddy portal or direct ipaserver URL.
# Survives ipactl restart (conf.d drop-in; not regenerated by ipa-server-install).
# ipa CLI / ipa-client-install use Kerberos directly (KRB5CCNAME FILE in Ansible), not browser Negotiate.
#
# Do not reopen <Location /ipa> here. This drop-in loads after FreeIPA's ipa.conf;
# a late broad location overrides the public Directory exceptions for /ipa/ui and
# /ipa/modern-ui, causing their static login applications to return HTTP 401.

<LocationMatch "^/ipa/(json|xml)(/|$)">
  SetEnv gssapi-no-negotiate
</LocationMatch>

<LocationMatch "^/ipa/session/(cookie|json|login_kerberos)(/|$)">
  SetEnv gssapi-no-negotiate
</LocationMatch>
