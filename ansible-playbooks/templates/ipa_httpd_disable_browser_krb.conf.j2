# Managed by Ansible — suppress mod_auth_gssapi SPNEGO (WWW-Authenticate: Negotiate) for IPA Web UI.
# ANSIBLE_IPA_DISABLE_BROWSER_KRB — use forms/password login via Caddy portal or direct ipaserver URL.
# Survives ipactl restart (conf.d drop-in; not regenerated by ipa-server-install).
# ipa CLI / ipa-client-install use Kerberos directly (KRB5CCNAME FILE in Ansible), not browser Negotiate.

<Location /ipa>
  SetEnv gssapi-no-negotiate
</Location>
