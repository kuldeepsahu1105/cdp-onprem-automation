# Managed by Ansible — suppress mod_auth_gssapi SPNEGO for browser-facing IPA routes.
# ANSIBLE_IPA_DISABLE_BROWSER_KRB — use forms/password login via Caddy portal or direct ipaserver URL.
# Survives ipactl restart (conf.d drop-in; not regenerated by ipa-server-install).
# IPA CLI and ipa-client-install send Kerberos credentials proactively and remain unaffected.

# Do not reopen <Location /ipa>: a late broad Location overrides FreeIPA's public
# /ipa/ui and /ipa/modern-ui locations and turns the login application into a 401.
SetEnvIf Request_URI "^/ipa(/|$)" gssapi-no-negotiate=1
