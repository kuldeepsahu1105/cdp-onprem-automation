# Ansible-managed Docker Compose environment for Grafana / Prometheus / Alertmanager / cAdvisor.
# Edit group_vars / vault and re-run Jenkins MONITORING (play 32) or PORTAL when monitoring sync runs.
MONITORING_CONFIG_DIR={{ monitoring_config_dir }}
MONITORING_PROMETHEUS_IMAGE={{ monitoring_prometheus_image }}
MONITORING_PROMETHEUS_CONTAINER={{ monitoring_prometheus_container }}
MONITORING_ALERTMANAGER_IMAGE={{ monitoring_alertmanager_image }}
MONITORING_ALERTMANAGER_CONTAINER={{ monitoring_alertmanager_container }}
MONITORING_GRAFANA_IMAGE={{ monitoring_grafana_image }}
MONITORING_GRAFANA_CONTAINER={{ monitoring_grafana_container }}
MONITORING_CADVISOR_IMAGE={{ monitoring_cadvisor_image }}
MONITORING_CADVISOR_CONTAINER={{ monitoring_cadvisor_container }}
MONITORING_PROMETHEUS_HOST_PORT={{ monitoring_prometheus_host_port }}
MONITORING_ALERTMANAGER_HOST_PORT={{ monitoring_alertmanager_host_port }}
MONITORING_GRAFANA_HOST_PORT={{ monitoring_grafana_host_port }}
MONITORING_CADVISOR_HOST_PORT={{ monitoring_cadvisor_host_port }}
PROMETHEUS_WEB_EXTERNAL_URL={{ (
  caddy_vhost_urls_external.prometheus.url
  if (caddy_vhost_enabled | default(false) | bool)
  else ('http://' + deployment_portal_anchor_fqdn + ':' + (deployment_portal_http_port | string) + '/prometheus/')
) | quote }}
PROMETHEUS_WEB_ROUTE_PREFIX={{ ('/' if (caddy_vhost_enabled | default(false) | bool) else '/prometheus') | quote }}
ALERTMANAGER_WEB_EXTERNAL_URL={{ (
  caddy_vhost_urls_external.alertmanager.url
  if (caddy_vhost_enabled | default(false) | bool)
  else ('http://' + deployment_portal_anchor_fqdn + ':' + (deployment_portal_http_port | string) + '/alertmanager/')
) | quote }}
ALERTMANAGER_WEB_ROUTE_PREFIX={{ ('/' if (caddy_vhost_enabled | default(false) | bool) else '/alertmanager') | quote }}
GF_SECURITY_ADMIN_USER={{ monitoring_grafana_admin_user | quote }}
GF_SECURITY_ADMIN_PASSWORD={{ monitoring_grafana_admin_password | quote }}
GF_SERVER_ROOT_URL={{ (
  caddy_vhost_urls_external.grafana.url
  if (caddy_vhost_enabled | default(false) | bool)
  else ('http://' + deployment_portal_anchor_fqdn + ':' + (deployment_portal_http_port | string) + '/grafana/')
) | quote }}
GF_SERVER_SERVE_FROM_SUB_PATH={{ ('false' if (caddy_vhost_enabled | default(false) | bool) else 'true') | quote }}
