#!/usr/bin/env bash
# {{ ec2_startstop_script_basename }} — Start, stop, or describe EC2 instances for this deployment.
#
# Usage:
#   {{ ec2_startstop_script_path }} <start|stop|describe> <prefix> <hostgroup1> [hostgroup2 ...]
#
#   prefix     — EC2 tag:environment (Jenkins ENVIRONMENT / deployment_name_prefix, e.g. ptgtyv1)
#   hostgroups — EC2 tag:Group values (Terraform instance_groups keys, e.g. cldr_mngr, pvcbase_worker)
#
# Default prefix when omitted: {{ ec2_startstop_default_environment | default('') }}
#
# stop: prompts for "yes" unless EC2_STARTSTOP_NON_INTERACTIVE=1 or JENKINS_URL is set.
# describe: table of instance id, state, Name, Group, private/public IP.

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
DEFAULT_PREFIX="{{ ec2_startstop_default_environment | default('', true) | trim }}"
AWS_REGION_FALLBACK="{{ aws_region | default('us-east-1') }}"

{% raw %}
usage() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
  echo ""
  echo "Examples:"
  echo "  $SCRIPT_NAME describe ptgtyv1 cldr_mngr pvcbase_worker"
  echo "  $SCRIPT_NAME start ptgtyv1 pvcecs_worker"
  echo "  $SCRIPT_NAME stop ptgtyv1 pvcbase_master pvcbase_worker"
  exit "${1:-0}"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage 0
fi

resolve_aws_region() {
  local imds_region=""
  if imds_region="$(curl -sf -m 2 http://169.254.169.254/latest/meta-data/placement/region 2>/dev/null)"; then
    if [[ -n "$imds_region" ]]; then
      printf '%s' "$imds_region"
      return 0
    fi
  fi
  if [[ -n "${AWS_REGION:-}" ]]; then
    printf '%s' "$AWS_REGION"
    return 0
  fi
  if [[ -n "${AWS_DEFAULT_REGION:-}" ]]; then
    printf '%s' "$AWS_DEFAULT_REGION"
    return 0
  fi
  printf '%s' "$AWS_REGION_FALLBACK"
}

AWS_REGION="$(resolve_aws_region)"
export AWS_DEFAULT_REGION="$AWS_REGION"

OPERATION="${1:-}"
PREFIX="${2:-}"
shift 2 2>/dev/null || true
# Do not use bash readonly array name GROUPS (shows as 0 for root).
HOST_GROUPS=("$@")

if [[ -z "$OPERATION" ]]; then
  echo "ERROR: missing operation (start|stop|describe)" >&2
  usage 1
fi

case "$OPERATION" in
  start|stop|describe) ;;
  *)
    echo "ERROR: invalid operation '$OPERATION' (use start, stop, or describe)" >&2
    usage 1
    ;;
esac

if [[ -z "$PREFIX" && -n "$DEFAULT_PREFIX" ]]; then
  PREFIX="$DEFAULT_PREFIX"
fi

if [[ -z "$PREFIX" ]]; then
  echo "ERROR: missing prefix (tag:environment)" >&2
  usage 1
fi

if [[ "$OPERATION" != "describe" && ${#HOST_GROUPS[@]} -eq 0 ]]; then
  echo "ERROR: at least one hostgroup required for start/stop" >&2
  usage 1
fi

build_filters() {
  local -a filters=(
    "Name=tag:environment,Values=${PREFIX}"
  )
  if ((${#HOST_GROUPS[@]} > 0)); then
    local group_csv
    group_csv=$(IFS=,; echo "${HOST_GROUPS[*]}")
    filters+=("Name=tag:Group,Values=${group_csv}")
  fi
  printf '%s\n' "${filters[@]}"
}

mapfile -t FILTERS < <(build_filters)

describe_instances() {
  aws ec2 describe-instances \
    --region "$AWS_REGION" \
    --filters "${FILTERS[@]}" \
    --query 'Reservations[].Instances[].{Id:InstanceId,State:State.Name,Name:Tags[?Key==`Name`].Value|[0],Group:Tags[?Key==`Group`].Value|[0],PrivateIp:PrivateIpAddress,PublicIp:PublicIpAddress}' \
    --output table
}

collect_instance_ids() {
  aws ec2 describe-instances \
    --region "$AWS_REGION" \
    --filters "${FILTERS[@]}" \
    --query 'Reservations[].Instances[].InstanceId' \
    --output text
}

confirm_stop() {
  if [[ "${EC2_STARTSTOP_NON_INTERACTIVE:-}" == "1" || -n "${JENKINS_URL:-}" ]]; then
    return 0
  fi
  echo "About to STOP instances matching:"
  echo "  tag:environment = ${PREFIX}"
  if ((${#HOST_GROUPS[@]} > 0)); then
    echo "  tag:Group       = ${HOST_GROUPS[*]}"
  fi
  describe_instances || true
  echo ""
  read -r -p 'Type yes to confirm stop: ' answer
  if [[ "$answer" != "yes" ]]; then
    echo "Aborted."
    exit 1
  fi
}

INSTANCE_IDS="$(collect_instance_ids | xargs echo || true)"
if [[ -z "${INSTANCE_IDS// }" ]]; then
  echo "No instances found for prefix='${PREFIX}' hostgroups='${HOST_GROUPS[*]:-all}'."
  exit 0
fi

case "$OPERATION" in
  describe)
    describe_instances
    ;;
  start)
    echo "Starting: $INSTANCE_IDS"
    aws ec2 start-instances --region "$AWS_REGION" --instance-ids $INSTANCE_IDS
    aws ec2 wait instance-running --region "$AWS_REGION" --instance-ids $INSTANCE_IDS || true
    describe_instances
    ;;
  stop)
    confirm_stop
    echo "Stopping: $INSTANCE_IDS"
    aws ec2 stop-instances --region "$AWS_REGION" --instance-ids $INSTANCE_IDS
    aws ec2 wait instance-stopped --region "$AWS_REGION" --instance-ids $INSTANCE_IDS || true
    describe_instances
    ;;
esac

exit 0
{% endraw %}
