# Managed by ansible-playbooks — AES Kerberos enctypes (Cloudera Manager / Java 17+).
# Do not enable RC4 here unless krb5_allow_weak_rc4 is explicitly true in group_vars.
#
# Credential cache (ccache): this snippet does NOT set default_ccache_name in krb5.conf.
# FreeIPA-managed /etc/krb5.conf on ipaserver and enrolled clients keeps the normal system default.
# Ansible identity playbooks (11–19) use a dedicated FILE cache for ipa/kinit/klist in automation only:
#   KRB5CCNAME=FILE:{{ ipa_kerberos_ccache_path }}
# (override via group_vars ipa_kerberos_ccache_path; see common_tasks/run_ipa_cli.yml.)
[libdefaults]
permitted_enctypes = {{ krb5_ipa_permitted_enctypes }}
default_tkt_enctypes = {{ krb5_ipa_default_enctypes }}
default_tgs_enctypes = {{ krb5_ipa_default_enctypes }}
