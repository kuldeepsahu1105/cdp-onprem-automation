{# YAML list of blackbox probe targets (module, target, labels) for Prometheus. #}
{% if monitoring_blackbox_exporter_enabled | default(true) | bool %}
{% set _ops_priv = deployment_portal_ops_private_ip | default('') | trim %}
{% set _http_port = deployment_portal_http_port | default(81) %}
{% if _ops_priv | length > 0 %}
- module: http_2xx
  target: "http://{{ _ops_priv }}:{{ _http_port }}/"
  labels:
    probe: portal_caddy
    service: deployment_portal
{% if monitoring_blackbox_probe_caddy_paths_enabled | default(true) | bool %}
- module: http_2xx
  target: "http://{{ _ops_priv }}:{{ _http_port }}/grafana/login"
  labels:
    probe: grafana_caddy_path
    service: grafana
- module: http_2xx
  target: "http://{{ _ops_priv }}:{{ _http_port }}/prometheus/-/healthy"
  labels:
    probe: prometheus_caddy_path
    service: prometheus
- module: http_2xx
  target: "http://{{ _ops_priv }}:{{ _http_port }}/alertmanager/-/healthy"
  labels:
    probe: alertmanager_caddy_path
    service: alertmanager
- module: http_2xx
  target: "http://{{ _ops_priv }}:{{ _http_port }}/cadvisor/"
  labels:
    probe: cadvisor_caddy_path
    service: cadvisor
{% endif %}
- module: http_2xx
  target: "http://{{ _ops_priv }}:{{ monitoring_cadvisor_host_port | default(8089) }}/"
  labels:
    probe: cadvisor_host_port
    service: cadvisor
{% endif %}
{% if deployment_portal_cm_private_ip | default('') | length > 0 %}
{% set _cm_priv = deployment_portal_cm_private_ip | trim %}
- module: http_2xx_ssl
  target: "https://{{ _cm_priv }}:{{ cm_https_port | default(7183) }}/api/version"
  labels:
    probe: cm_api_https
    service: cloudera_manager
- module: http_2xx_ssl
  target: "https://{{ _cm_priv }}:{{ cm_http_port | default(7180) }}/"
  labels:
    probe: cm_ui_https
    service: cloudera_manager
- module: tcp_connect
  target: "{{ _cm_priv }}:{{ postgres_port | default(5432) }}"
  labels:
    probe: cm_postgres_tcp
    service: postgresql
{% endif %}
{% if deployment_portal_has_ipa | default(false) | bool and (deployment_portal_ipa_upstream_host | default('') | length > 0) %}
- module: http_2xx
  target: "http://{{ deployment_portal_ipa_upstream_host | trim }}:80/ipa/json"
  labels:
    probe: ipa_json
    service: freeipa
{% endif %}
- module: http_2xx
  target: "http://{{ deployment_portal_pgadmin_container | default('cldr-portal-pgadmin') }}:80/"
  labels:
    probe: pgadmin_container
    service: pgadmin
- module: http_2xx
  target: "http://{{ monitoring_grafana_container | default('cldr-mon-grafana') }}:3000/login"
  labels:
    probe: grafana_ui
    service: grafana
- module: http_2xx
  target: "http://{{ monitoring_prometheus_container | default('cldr-mon-prometheus') }}:9090/-/healthy"
  labels:
    probe: prometheus_health
    service: prometheus
- module: http_2xx
  target: "http://{{ monitoring_alertmanager_container | default('cldr-mon-alertmanager') }}:9093/-/healthy"
  labels:
    probe: alertmanager_health
    service: alertmanager
- module: http_2xx
  target: "http://{{ monitoring_cadvisor_container | default('cldr-mon-cadvisor') }}:8080/metrics"
  labels:
    probe: cadvisor_ops_container
    service: cadvisor
{% if caddy_vhost_enabled | default(false) | bool and monitoring_blackbox_probe_caddy_vhosts_enabled | default(true) | bool %}
{% for _vhost_key, _vhost in (caddy_vhost_urls_external | default({})).items() %}
{% if _vhost.url | default('') | length > 0 %}
{% set _vurl = _vhost.url | trim %}
{% set _vmod = 'http_2xx_ssl' if _vurl.startswith('https://') else 'http_2xx' %}
- module: {{ _vmod }}
  target: "{{ _vurl }}"
  labels:
    probe: caddy_vhost_{{ _vhost_key }}
    service: caddy_vhost
{% endif %}
{% endfor %}
{% endif %}
{% if monitoring_blackbox_probe_base_cluster_enabled | default(true) | bool %}
{% for ep in (deployment_portal_base_cluster_portal_urls | default({})).endpoints | default([]) %}
{% if ep.url | default('') | length > 0 %}
{% set _ep_url = ep.url | trim %}
{% set _ep_mod = 'http_2xx_ssl' if (ep.scheme | default('http')) == 'https' else 'http_2xx' %}
- module: {{ _ep_mod }}
  target: "{{ _ep_url }}"
  labels:
    probe: base_{{ ep.name | default('endpoint') | regex_replace('[^a-zA-Z0-9]+', '_') | lower }}
    service: base_cluster
{% endif %}
{% endfor %}
{% endif %}
{% if base_cluster_install_services.knox | default(false) | bool and base_cluster_master_group in groups and groups[base_cluster_master_group] | length > 0 %}
{% set _knox_host = hostvars[groups[base_cluster_master_group][0]].private_ip | default(hostvars[groups[base_cluster_master_group][0]].ansible_host | default('')) %}
{% if _knox_host | length > 0 %}
- module: tcp_connect
  target: "{{ _knox_host }}:{{ base_cluster_knox_gateway_https_port | default(8443) }}"
  labels:
    probe: knox_gateway_tcp
    service: knox
{% endif %}
{% endif %}
{% if deployment_portal_ecs_present | default(false) | bool and (ecs_app_domain | default('') | length > 0) %}
{% set _ecs_url = ecs_control_plane_url | default('') | trim %}
{% if _ecs_url | length == 0 %}
{% set _ecs_url = 'https://' ~ ecs_console_host_prefix ~ '.' ~ ecs_app_domain %}
{% endif %}
- module: http_2xx_ssl
  target: "{{ _ecs_url }}"
  labels:
    probe: ecs_console_https
    service: ecs
{% set _ecs_cdp_api = ecs_cdp_console_api_url | default('') | trim %}
{% if _ecs_cdp_api | length == 0 %}
{% set _ecs_cdp_api = 'https://' ~ ecs_console_host_prefix ~ '.' ~ ecs_app_domain %}
{% endif %}
- module: http_2xx_ssl
  target: "{{ _ecs_cdp_api }}"
  labels:
    probe: ecs_cdp_console_api
    service: ecs
{% if monitoring_blackbox_probe_ecs_data_services_enabled | default(true) | bool %}
{% for _ds_key in ['cdw', 'cde', 'cai'] %}
{% set _ds = ecs_data_services_catalog[_ds_key] | default({}) %}
{% if _ds.url | default('') | length > 0 %}
- module: http_2xx_ssl
  target: "{{ _ds.url | trim }}"
  labels:
    probe: ecs_ds_{{ _ds_key }}
    service: ecs_data_service
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% for extra in monitoring_blackbox_extra_probes | default([]) %}
{% if extra.module | default('') | length > 0 and extra.target | default('') | length > 0 %}
- module: {{ extra.module }}
  target: "{{ extra.target }}"
  labels:
{% for label_key, label_val in (extra.labels | default({})).items() %}
    {{ label_key }}: {{ label_val }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
