global:
  scrape_interval: 30s
  evaluation_interval: 30s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - {{ monitoring_alertmanager_container }}:9093

{% if monitoring_alert_rules_enabled | default(true) | bool %}
rule_files:
  - /etc/prometheus/rules/*.yml
{% endif %}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: cadvisor
    static_configs:
      - targets:
          - {{ monitoring_cadvisor_container }}:8080
        labels:
          cadvisor_scope: ops

{% if monitoring_cadvisor_host_enabled | default(true) | bool and (deployment_portal_cadvisor_host_targets | default([]) | length > 0) %}
  - job_name: cadvisor_host
    static_configs:
{% for cadv_target in deployment_portal_cadvisor_host_targets %}
      - targets:
          - {{ cadv_target.target }}
        labels:
          instance: {{ cadv_target.instance }}
{% for label_key, label_val in (cadv_target.labels | default({})).items() %}
          {{ label_key }}: {{ label_val }}
{% endfor %}
{% endfor %}
{% endif %}

{% if monitoring_node_exporter_enabled | default(true) | bool and (deployment_portal_node_exporter_targets | default([]) | length > 0) %}
  - job_name: node_exporter
    static_configs:
{% for node_target in deployment_portal_node_exporter_targets %}
      - targets:
          - {{ node_target.target }}
        labels:
          instance: {{ node_target.instance }}
{% for label_key, label_val in (node_target.labels | default({})).items() %}
          {{ label_key }}: {{ label_val }}
{% endfor %}
{% endfor %}
{% endif %}

{% if monitoring_process_exporter_enabled | default(true) | bool and (deployment_portal_process_exporter_targets | default([]) | length > 0) %}
  - job_name: process_exporter
    static_configs:
{% for proc_target in deployment_portal_process_exporter_targets %}
      - targets:
          - {{ proc_target.target }}
        labels:
          instance: {{ proc_target.instance }}
{% for label_key, label_val in (proc_target.labels | default({})).items() %}
          {{ label_key }}: {{ label_val }}
{% endfor %}
{% endfor %}
{% endif %}

{% if monitoring_blackbox_exporter_enabled | default(true) | bool and (deployment_portal_blackbox_probe_targets | default([]) | length > 0) %}
{% for module_name in deployment_portal_blackbox_probe_targets | map(attribute='module') | unique | list %}
  - job_name: blackbox_{{ module_name }}
    metrics_path: /probe
    params:
      module:
        - {{ module_name }}
    static_configs:
{% for probe in deployment_portal_blackbox_probe_targets | selectattr('module', 'equalto', module_name) | list %}
      - targets:
          - {{ probe.target }}
        labels:
{% for label_key, label_val in (probe.labels | default({})).items() %}
          {{ label_key }}: {{ label_val }}
{% endfor %}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ monitoring_blackbox_exporter_container }}:9115
{% endfor %}
{% endif %}

{% for target in monitoring_prometheus_extra_targets | default([]) %}
  - job_name: {{ target.job_name }}
    static_configs:
      - targets:
{% for host in target.targets %}
          - {{ host }}
{% endfor %}
{% endfor %}
