# Host publishes: Caddy edge HOST:CONTAINER (deployment_portal_caddy_host_port:deployment_portal_http_port, default 80:80)
# and pgAdmin (deployment_portal_pgadmin_host_port:80, default 5050:80).
# Grafana/Prometheus/Alertmanager are not published here — they join network deployment_portal via monitoring_docker-compose.yml.j2
# and are reached at http://<ops>:<deployment_portal_http_port>/grafana|prometheus|alertmanager/ through Caddy.
# After changing port vars (legacy labs used 8088:8088 or 81:81), re-run PORTAL or on the ops host:
#   docker compose -f {{ deployment_portal_config_dir }}/docker-compose.yml up -d --force-recreate caddy
services:
  caddy:
    image: {{ deployment_portal_caddy_image }}
    container_name: {{ deployment_portal_caddy_container }}
    restart: unless-stopped
    depends_on:
      pgadmin:
        condition: service_healthy
    ports:
      - "0.0.0.0:{{ deployment_portal_caddy_host_port | default(deployment_portal_http_port) }}:{{ deployment_portal_http_port }}/tcp"
    volumes:
      - {{ deployment_portal_config_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro,z
      - {{ deployment_portal_www_dir }}:/srv:ro,z
    networks:
      - deployment_portal

  pgadmin:
    image: {{ deployment_portal_pgadmin_image }}
    container_name: {{ deployment_portal_pgadmin_container }}
    restart: unless-stopped
    ports:
      - "0.0.0.0:{{ deployment_portal_pgadmin_host_port }}:80/tcp"
    environment:
      PGADMIN_DEFAULT_EMAIL: "{{ pgadmin_default_email | trim }}"
      PGADMIN_DEFAULT_PASSWORD: "{{ pgadmin_default_password | trim }}"
      PGADMIN_CONFIG_SERVER_MODE: "False"
      PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED: "False"
    volumes:
      - {{ deployment_portal_config_dir }}/pgadmin-servers.json:/pgadmin4/servers.json:ro,z
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/misc/ping || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 90s
    networks:
      - deployment_portal

networks:
  deployment_portal:
    name: deployment_portal
