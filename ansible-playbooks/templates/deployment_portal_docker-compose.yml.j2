# Host publishes: Caddy edge (DEPLOYMENT_PORTAL_HTTP_PORT, default 81) and pgAdmin (DEPLOYMENT_PORTAL_PGADMIN_HOST_PORT, default 5050).
# Values live in {{ deployment_portal_config_dir }}/.env (Ansible template deployment_portal_docker-compose.env.j2).
# Grafana/Prometheus/Alertmanager join network deployment_portal via monitoring compose under {{ monitoring_config_dir | default('/opt/cldr-monitoring') }}.
# After changing ports, re-run PORTAL or: cd {{ deployment_portal_config_dir }} && docker compose up -d --force-recreate caddy
services:
  caddy:
    image: ${DEPLOYMENT_PORTAL_CADDY_IMAGE}
    container_name: ${DEPLOYMENT_PORTAL_CADDY_CONTAINER}
    restart: unless-stopped
    depends_on:
      pgadmin:
        condition: service_healthy
    ports:
      - "0.0.0.0:${DEPLOYMENT_PORTAL_HTTP_PORT}:${DEPLOYMENT_PORTAL_HTTP_PORT}/tcp"
    volumes:
      - ${DEPLOYMENT_PORTAL_CONFIG_DIR}/Caddyfile:/etc/caddy/Caddyfile:ro,z
      - ${DEPLOYMENT_PORTAL_WWW_DIR}:/srv:ro,z
    networks:
      - deployment_portal

  pgadmin:
    image: ${DEPLOYMENT_PORTAL_PGADMIN_IMAGE}
    container_name: ${DEPLOYMENT_PORTAL_PGADMIN_CONTAINER}
    restart: unless-stopped
    ports:
      - "0.0.0.0:${DEPLOYMENT_PORTAL_PGADMIN_HOST_PORT}:80/tcp"
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_DEFAULT_EMAIL}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_DEFAULT_PASSWORD}
      PGADMIN_CONFIG_SERVER_MODE: "False"
      PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED: "False"
    volumes:
      - ${DEPLOYMENT_PORTAL_CONFIG_DIR}/pgadmin-servers.json:/pgadmin4/servers.json:ro,z
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/misc/ping || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 90s
    networks:
      - deployment_portal

networks:
  deployment_portal:
    name: deployment_portal
