{
    "customCA": false,
    "configureAllServices": true,
    "sshPort": 22,
    {% if cm_autotls_trust_freeipa_ca_effective | default(use_freeipa_for_crt_mgmt) | bool %}"trustedCaCerts": "{{ cm_autotls_freeipa_ca_cert_path | default('/etc/ipa/ca.crt') }}",{% endif %}
    "userName": "{{ cm_srvr_sudo_user | default('root') }}",
    "privateKey": "{{ node_key_one_line }}",
    "passphrase": "{{ cm_priv_key_passphrase | default('') }}"
}
