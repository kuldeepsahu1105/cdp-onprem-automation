# Rendered by 31_setup_base_cluster.yml — CDP base cluster services and host templates.
# Toggle services via base_cluster_install_services in group_vars/all.yml (ANSIBLE_GROUP_VARS_YAML).
# Service-level config keys: docs/CDP_BASE_CLUSTER_SERVICE_DEPS.md (CM 7.13.2 dependency matrix).
{% set svc = base_cluster_install_services %}
services:
{% if svc.core_settings | default(true) %}
  - name: core-settings
    type: CORE_SETTINGS
    display_name: Core Settings
{% endif %}
{% if svc.zookeeper | default(true) %}
  - name: zookeeper
    type: ZOOKEEPER
    display_name: ZooKeeper
    config:
      zookeeper_datadir_autocreate: true
{% endif %}
{% if svc.hdfs | default(true) %}
  - name: hdfs
    type: HDFS
    display_name: HDFS
    config:
      zookeeper_service: "{{ 'zookeeper' if svc.zookeeper | default(true) else '' }}"
      core_connector: "{{ 'core-settings' if svc.core_settings | default(true) else '' }}"
    role_groups:
      - type: DATANODE
        config:
          dfs_data_dir_list: /dfs/dn
      - type: NAMENODE
        config:
          dfs_name_dir_list: /dfs/nn
      - type: SECONDARYNAMENODE
        config:
          fs_checkpoint_dir_list: /dfs/snn
{% endif %}
{% if svc.ozone | default(true) %}
  - name: ozone
    type: OZONE
    display_name: Ozone
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
{% endif %}
{% if svc.yarn | default(true) %}
  - name: yarn
    type: YARN
    display_name: YARN
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      zookeeper_service: "{{ 'zookeeper' if svc.zookeeper | default(true) else '' }}"
{% if svc.ranger | default(true) %}
      ranger_service: ranger
{% endif %}
    role_groups:
      - type: RESOURCEMANAGER
        config:
          yarn_scheduler_maximum_allocation_mb: {{ base_cluster_yarn_rm_max_mb | default(4096) }}
          yarn_scheduler_maximum_allocation_vcores: {{ base_cluster_yarn_rm_max_vcores | default(4) }}
      - type: NODEMANAGER
        config:
          yarn_nodemanager_resource_memory_mb: {{ base_cluster_yarn_nm_memory_mb | default(4096) }}
          yarn_nodemanager_resource_cpu_vcores: {{ base_cluster_yarn_nm_vcores | default(4) }}
          yarn_nodemanager_local_dirs: /tmp/nm
          yarn_nodemanager_log_dirs: /var/log/nm
{% endif %}
{% if svc.tez | default(true) %}
  - name: tez
    type: TEZ
    display_name: Tez
    config:
      # Tez depends on YARN only (not hdfs_service) — see CDP service dependency matrix.
      yarn_service: "{{ 'yarn' if svc.yarn | default(true) else '' }}"
{% endif %}
{% if svc.hive | default(true) %}
  - name: hive
    type: HIVE
    display_name: Hive
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      zookeeper_service: "{{ 'zookeeper' if svc.zookeeper | default(true) else '' }}"
      mapreduce_yarn_service: "{{ 'yarn' if svc.yarn | default(true) else '' }}"
{% if svc.ranger | default(true) %}
      ranger_service: ranger
{% endif %}
{% if svc.hbase | default(true) %}
      hbase_service: hbase
{% endif %}
{% if svc.atlas | default(true) %}
      atlas_service: atlas
{% endif %}
{% endif %}
{% if svc.hive_on_tez | default(true) %}
  - name: hive_on_tez
    type: HIVE_ON_TEZ
    display_name: Hive on Tez
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      hms_connector: "{{ 'hive' if svc.hive | default(true) else '' }}"
      tez_service: "{{ 'tez' if svc.tez | default(true) else '' }}"
      mapreduce_yarn_service: "{{ 'yarn' if svc.yarn | default(true) else '' }}"
      zookeeper_service: "{{ 'zookeeper' if svc.zookeeper | default(true) else '' }}"
{% if svc.ranger | default(true) %}
      ranger_service: ranger
{% endif %}
{% if svc.hbase | default(true) %}
      hbase_service: hbase
{% endif %}
{% if svc.atlas | default(true) %}
      atlas_service: atlas
{% endif %}
{% endif %}
{% if svc.hbase | default(true) %}
  - name: hbase
    type: HBASE
    display_name: HBase
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      zookeeper_service: "{{ 'zookeeper' if svc.zookeeper | default(true) else '' }}"
{% endif %}
{% if svc.hue | default(true) %}
  - name: hue
    type: HUE
    display_name: Hue
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
{% if svc.hive | default(true) and svc.hive_on_tez | default(true) %}
      hms_service: hive
      hive_service: hive_on_tez
{% elif svc.hive | default(true) %}
      hive_service: hive
{% elif svc.hive_on_tez | default(true) %}
      hive_service: hive_on_tez
{% endif %}
{% if svc.hbase | default(true) %}
      hbase_service: hbase
{% endif %}
{% if svc.impala | default(true) %}
      impala_service: impala
{% endif %}
{% if svc.solr | default(false) %}
      solr_service: solr
{% endif %}
{% if svc.atlas | default(true) %}
      atlas_service: atlas
{% endif %}
{% if svc.zookeeper | default(true) %}
      zookeeper_service: zookeeper
{% endif %}
{% endif %}
{% if svc.iceberg | default(false) %}
  - name: iceberg
    type: ICEBERG
    display_name: Iceberg
    config:
      hive_service: "{{ 'hive' if svc.hive | default(true) else '' }}"
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
{% endif %}
{% if svc.replication | default(false) %}
  - name: replication
    type: REPLICATION_MANAGER
    display_name: Replication Manager
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
{% endif %}
{% if svc.impala | default(true) %}
  - name: impala
    type: IMPALA
    display_name: Impala
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      hive_service: "{{ 'hive' if svc.hive | default(true) else '' }}"
{% if svc.hbase | default(true) %}
      hbase_service: hbase
{% endif %}
{% if svc.ranger | default(true) %}
      ranger_service: ranger
{% endif %}
{% if svc.atlas | default(true) %}
      atlas_service: atlas
{% endif %}
{% endif %}
{% if svc.kafka | default(true) %}
  - name: kafka
    type: KAFKA
    display_name: Kafka
    config:
      zookeeper_service: "{{ 'zookeeper' if svc.zookeeper | default(true) else '' }}"
{% if svc.hdfs | default(true) %}
      hdfs_service: hdfs
{% endif %}
{% if svc.ranger | default(true) %}
      ranger_service: ranger
{% endif %}
{% endif %}
{% if svc.atlas | default(true) %}
  - name: atlas
    type: ATLAS
    display_name: Atlas
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      kafka_service: "{{ 'kafka' if svc.kafka | default(true) else '' }}"
{% if svc.hbase | default(true) %}
      hbase_service: hbase
{% endif %}
{% if svc.solr | default(false) %}
      solr_service: solr
{% endif %}
{% if svc.ranger | default(true) %}
      ranger_service: ranger
{% endif %}
{% endif %}
{% if svc.ranger | default(true) %}
  - name: ranger
    type: RANGER
    display_name: Ranger
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
{% if svc.solr | default(false) %}
      solr_service: solr
{% endif %}
{% endif %}
{% if svc.nifi | default(false) %}
  - name: nifi
    type: NIFI
    display_name: NiFi
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      zookeeper_service: "{{ 'zookeeper' if svc.zookeeper | default(true) else '' }}"
{% if svc.kafka | default(true) %}
      kafka_service: kafka
{% endif %}
{% endif %}
{% if svc.nifi_registry | default(false) %}
  - name: nifi_registry
    type: NIFI_REGISTRY
    display_name: NiFi Registry
    config:
      nifi_service: "{{ 'nifi' if svc.nifi | default(false) else '' }}"
{% endif %}
{% if svc.dataviz | default(false) %}
  - name: dataviz
    type: DATAVIZ
    display_name: Data Visualization
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      hive_service: "{{ 'hive_on_tez' if svc.hive_on_tez | default(true) else ('hive' if svc.hive | default(true) else '') }}"
{% endif %}
{% if svc.phoenix | default(false) %}
  - name: phoenix
    type: PHOENIX
    display_name: Phoenix
    config:
      hbase_service: "{{ 'hbase' if svc.hbase | default(true) else '' }}"
{% endif %}
{% if svc.knox | default(true) %}
  - name: knox
    type: KNOX
    display_name: Knox
{% endif %}
{% if svc.solr | default(false) %}
  - name: solr
    type: SOLR
    display_name: Solr
    config:
      hdfs_service: "{{ 'hdfs' if svc.hdfs | default(true) else '' }}"
      zookeeper_service: "{{ 'zookeeper' if svc.zookeeper | default(true) else '' }}"
{% endif %}
# host_templates.role_groups[].service must be the CM service TYPE (e.g. HDFS), not the service name (hdfs).
# cloudera.cluster.cluster find_base_role_group_name matches ApiService.type, not name.
host_templates:
  - name: Master
    role_groups:
{% if svc.hdfs | default(true) %}
      - service: HDFS
        type: NAMENODE
      - service: HDFS
        type: SECONDARYNAMENODE
{% endif %}
{% if svc.ozone | default(true) %}
      - service: OZONE
        type: OZONE_MANAGER
      - service: OZONE
        type: STORAGE_CONTAINER_MANAGER
{% endif %}
{% if svc.yarn | default(true) %}
      - service: YARN
        type: RESOURCEMANAGER
      - service: YARN
        type: JOBHISTORY
{% endif %}
{% if svc.hive | default(true) %}
      - service: HIVE
        type: HIVEMETASTORE
{% endif %}
{% if svc.hive_on_tez | default(true) %}
      - service: HIVE_ON_TEZ
        type: HIVESERVER2
{% endif %}
{% if svc.hbase | default(true) %}
      - service: HBASE
        type: MASTER
{% endif %}
{% if svc.hue | default(true) %}
      - service: HUE
        type: HUE_SERVER
      - service: HUE
        type: HUE_LOAD_BALANCER
{% endif %}
{% if svc.impala | default(true) %}
      - service: IMPALA
        type: STATESTORE
      - service: IMPALA
        type: CATALOGSERVER
{% endif %}
{% if svc.atlas | default(true) %}
      - service: ATLAS
        type: ATLAS_SERVER
{% endif %}
{% if svc.ranger | default(true) %}
      - service: RANGER
        type: RANGER_ADMIN
      - service: RANGER
        type: RANGER_TAGSYNC
      - service: RANGER
        type: RANGER_USERSYNC
{% endif %}
{% if svc.replication | default(false) %}
      - service: REPLICATION_MANAGER
        type: REPLICATION_MANAGER
{% endif %}
{% if svc.iceberg | default(false) %}
      - service: ICEBERG
        type: ICEBERG_CATALOG
{% endif %}
{% if svc.nifi | default(false) %}
      - service: NIFI
        type: NIFI_SERVER
{% endif %}
{% if svc.nifi_registry | default(false) %}
      - service: NIFI_REGISTRY
        type: NIFI_REGISTRY_SERVER
{% endif %}
{% if svc.dataviz | default(false) %}
      - service: DATAVIZ
        type: DATAVIZ_SERVER
{% endif %}
{% if svc.knox | default(true) %}
      - service: KNOX
        type: KNOX_GATEWAY
{% endif %}
{% if svc.phoenix | default(false) %}
      - service: PHOENIX
        type: PHOENIX_QUERY_SERVER
{% endif %}
{% if svc.solr | default(false) %}
      - service: SOLR
        type: SOLR_SERVER
{% endif %}
  - name: Worker
    role_groups:
{% if svc.hdfs | default(true) %}
      - service: HDFS
        type: DATANODE
{% endif %}
{% if svc.ozone | default(true) %}
      - service: OZONE
        type: OZONE_DATANODE
{% endif %}
{% if svc.yarn | default(true) %}
      - service: YARN
        type: NODEMANAGER
{% endif %}
{% if svc.zookeeper | default(true) %}
      - service: ZOOKEEPER
        type: SERVER
{% endif %}
{% if svc.hbase | default(true) %}
      - service: HBASE
        type: REGIONSERVER
{% endif %}
{% if svc.hive | default(true) %}
      - service: HIVE
        type: GATEWAY
{% endif %}
{% if svc.hive_on_tez | default(true) %}
      - service: HIVE_ON_TEZ
        type: GATEWAY
{% endif %}
{% if svc.tez | default(true) %}
      - service: TEZ
        type: GATEWAY
{% endif %}
{% if svc.impala | default(true) %}
      - service: IMPALA
        type: IMPALAD
{% endif %}
{% if svc.kafka | default(true) %}
      - service: KAFKA
        type: BROKER
{% endif %}
{% if svc.solr | default(false) %}
      - service: SOLR
        type: SOLR_SERVER
{% endif %}
