<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Deployment portal login</title>
  <style>
    :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      background: radial-gradient(circle at top, #183653, #07111d 62%);
      color: #e8f0f7;
    }
    main {
      width: min(24rem, calc(100% - 2rem));
      box-sizing: border-box;
      padding: 1.5rem;
      border: 1px solid rgba(116, 177, 230, 0.28);
      border-radius: 12px;
      background: rgba(10, 26, 42, 0.94);
      box-shadow: 0 20px 55px rgba(0, 0, 0, 0.38);
    }
    h1 { margin: 0 0 0.4rem; font-size: 1.35rem; }
    p { color: #9eb2c4; font-size: 0.9rem; line-height: 1.45; }
    label { display: block; margin-top: 0.9rem; font-size: 0.82rem; font-weight: 700; }
    input {
      width: 100%;
      box-sizing: border-box;
      margin-top: 0.35rem;
      padding: 0.72rem;
      border: 1px solid #35526b;
      border-radius: 7px;
      background: #071522;
      color: #fff;
      font: inherit;
    }
    button {
      width: 100%;
      margin-top: 1.1rem;
      padding: 0.72rem;
      border: 0;
      border-radius: 7px;
      background: #4f9dd9;
      color: #07111d;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }
    button:disabled { cursor: wait; opacity: 0.65; }
    #login-message { min-height: 1.3rem; margin-bottom: 0; color: #fca5a5; }
    .home-link { display: inline-block; margin-top: 1rem; color: #8ec8f2; font-size: 0.85rem; }
  </style>
</head>
<body>
  <main>
    <h1>Operator access</h1>
    <p>Sign in to view credentials and download private keys. This creates a revocable portal session and does not use the browser Basic Auth dialog.</p>
    <form id="login-form">
      <label for="login-user">Username</label>
      <input id="login-user" name="username" value="{{ deployment_portal_basic_auth_user | default('portal') }}" autocomplete="username" required/>
      <label for="login-password">Password</label>
      <input id="login-password" name="password" type="password" autocomplete="current-password" autofocus required/>
      <button id="login-submit" type="submit">Login</button>
      <p id="login-message" role="alert" aria-live="polite"></p>
    </form>
    <a class="home-link" href="/">Return to portal</a>
  </main>
  <script>
    (function () {
      var form = document.getElementById('login-form');
      var submit = document.getElementById('login-submit');
      var message = document.getElementById('login-message');
      var requestedNext = new URLSearchParams(window.location.search).get('next') || '/';
      var next = requestedNext.startsWith('/downloads/') ? requestedNext : '/';

      function basicToken(username, password) {
        var bytes = new TextEncoder().encode(username + ':' + password);
        var binary = '';
        bytes.forEach(function (byte) { binary += String.fromCharCode(byte); });
        return btoa(binary);
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        submit.disabled = true;
        message.textContent = '';
        fetch('/api/login', {
          method: 'POST',
          credentials: 'same-origin',
          cache: 'no-store',
          headers: {
            Authorization: 'Basic ' + basicToken(
              document.getElementById('login-user').value,
              document.getElementById('login-password').value
            )
          }
        }).then(function (response) {
          if (!response.ok) throw new Error('invalid');
          location.replace(next);
        }).catch(function () {
          message.textContent = 'Invalid username or password.';
          submit.disabled = false;
          document.getElementById('login-password').select();
        });
      });
    }());
  </script>
</body>
</html>
