# Grafana, Prometheus, Alertmanager, cAdvisor, and blackbox_exporter host ports are set via {{ monitoring_config_dir }}/.env
# (Ansible template monitoring_docker-compose.env.j2). Caddy on the portal stack still serves path/vhost routes.
services:
  prometheus:
    image: ${MONITORING_PROMETHEUS_IMAGE}
    container_name: ${MONITORING_PROMETHEUS_CONTAINER}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --web.external-url=${PROMETHEUS_WEB_EXTERNAL_URL}
      - --web.route-prefix=${PROMETHEUS_WEB_ROUTE_PREFIX}
    volumes:
      - ${MONITORING_CONFIG_DIR}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ${MONITORING_CONFIG_DIR}/rules:/etc/prometheus/rules:ro
    ports:
      - "0.0.0.0:${MONITORING_PROMETHEUS_HOST_PORT}:9090/tcp"
    networks:
      - deployment_portal
      - monitoring_internal

  alertmanager:
    image: ${MONITORING_ALERTMANAGER_IMAGE}
    container_name: ${MONITORING_ALERTMANAGER_CONTAINER}
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --web.external-url=${ALERTMANAGER_WEB_EXTERNAL_URL}
      - --web.route-prefix=${ALERTMANAGER_WEB_ROUTE_PREFIX}
    volumes:
      - ${MONITORING_CONFIG_DIR}/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    ports:
      - "0.0.0.0:${MONITORING_ALERTMANAGER_HOST_PORT}:9093/tcp"
    networks:
      - deployment_portal
      - monitoring_internal

  grafana:
    image: ${MONITORING_GRAFANA_IMAGE}
    container_name: ${MONITORING_GRAFANA_CONTAINER}
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: ${GF_SECURITY_ADMIN_USER}
      GF_SECURITY_ADMIN_PASSWORD: ${GF_SECURITY_ADMIN_PASSWORD}
      GF_SERVER_ROOT_URL: ${GF_SERVER_ROOT_URL}
      GF_SERVER_SERVE_FROM_SUB_PATH: ${GF_SERVER_SERVE_FROM_SUB_PATH}
    volumes:
      - ${MONITORING_CONFIG_DIR}/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - ${MONITORING_CONFIG_DIR}/grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ${MONITORING_CONFIG_DIR}/grafana/dashboards:/var/lib/grafana/dashboards:ro
    ports:
      - "0.0.0.0:${MONITORING_GRAFANA_HOST_PORT}:3000/tcp"
    networks:
      - deployment_portal
      - monitoring_internal

  cadvisor:
    image: ${MONITORING_CADVISOR_IMAGE}
    container_name: ${MONITORING_CADVISOR_CONTAINER}
    restart: unless-stopped
    privileged: true
    devices:
      - /dev/kmsg:/dev/kmsg
    ports:
      - "0.0.0.0:${MONITORING_CADVISOR_HOST_PORT}:8080/tcp"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /var/lib/containerd:/var/lib/containerd:ro
      - /dev/disk:/dev/disk:ro
    networks:
      - deployment_portal
      - monitoring_internal

{% if monitoring_blackbox_exporter_enabled | default(true) | bool %}
  blackbox:
    image: ${MONITORING_BLACKBOX_IMAGE}
    container_name: ${MONITORING_BLACKBOX_CONTAINER}
    restart: unless-stopped
    command:
      - --config.file=/etc/blackbox_exporter/config.yml
    volumes:
      - ${MONITORING_CONFIG_DIR}/blackbox.yml:/etc/blackbox_exporter/config.yml:ro
    ports:
      - "0.0.0.0:${MONITORING_BLACKBOX_HOST_PORT}:9115/tcp"
    networks:
      - deployment_portal
      - monitoring_internal
{% endif %}

networks:
  deployment_portal:
    external: true
    name: deployment_portal
  monitoring_internal:
    name: monitoring_internal
