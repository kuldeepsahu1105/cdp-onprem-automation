{
  "id": null,
  "uid": "cldr-cadvisor-ops",
  "title": "cAdvisor — Ops Host Containers",
  "description": "Portal and monitoring stack containers on the ops host (cAdvisor). Provisioned by Ansible playbook 32.",
  "tags": ["cloudera", "cadvisor", "docker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Running containers",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(count by (name) (container_last_seen{job=\"cadvisor\",name!=\"\"}))", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "cAdvisor scrape up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "max(up{job=\"cadvisor\"})", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "CPU usage — ops stack containers",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name=~\"cldr-mon-.*|cldr-portal-.*\"}[5m]))",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "title": "Memory usage — ops stack containers",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{
        "expr": "container_memory_usage_bytes{job=\"cadvisor\",name=~\"cldr-mon-.*|cldr-portal-.*\"}",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Container last seen age (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{
        "expr": "time() - container_last_seen{job=\"cadvisor\",name=~\"cldr-mon-.*|cldr-portal-.*\"}",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    }
  ]
}
